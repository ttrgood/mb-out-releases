{
  "mbout_plugin": 1,
  "id": "mbout.pinyin-retype",
  "name": "拼音重输",
  "version": "1.0",
  "author": "MB out",
  "description": "选中打错的拼音或汉字，一键删掉并切到中文输入法重新输入（汉字自动转拼音，判断多音字）。适配手心、微软拼音、搜狗、QQ、百度、讯飞、微信输入法等",
  "items": [
    {
      "kind": "script",
      "name": "拼音重输",
      "mode": "none",
      "icon": "u:retype",
      "value": "# 拼音重输：选中打错的拼音或汉字（比如忘了切输入法打出来的 jiemianji），点这个模块——\n# 删掉选中的内容 → 把输入法切到中文模式 → 把拼音重新敲进去，候选框出来自己选字。\n# 汉字会先转成拼音（按词判断多音字）；手心、微软拼音、搜狗、QQ、百度、讯飞、微信输入法等中文输入法都能用。\n# 下面的 C# 第一次运行时编译一次，缓存到 MB out 数据目录的 plugin_cache 里；脚本最后那一大段是汉字→拼音字典（来自 pypinyin，MIT）。\nfunction Main {\n  $sel = $env:MB_SELECTION\n  if ([string]::IsNullOrWhiteSpace($sel)) { [Console]::Error.WriteLine('先选中要重输的拼音或汉字，再点「拼音重输」'); return }\n  if (-not ('SidebarPlan.RetypePlugin' -as [type])) {\n    $cache = Join-Path (Split-Path $PSScriptRoot) 'plugin_cache'\n    $dll = Join-Path $cache 'pinyin_retype_d6d80b2d12.dll'\n    $loaded = $false\n    if (Test-Path $dll) { try { Add-Type -Path $dll; $loaded = $true } catch { } }\n    if (-not $loaded) {\n      try {\n        New-Item -ItemType Directory -Force $cache | Out-Null\n        Add-Type -TypeDefinition $code -OutputAssembly $dll -OutputType Library\n        Add-Type -Path $dll\n      }\n      catch { if (-not ('SidebarPlan.RetypePlugin' -as [type])) { Add-Type -TypeDefinition $code } }\n    }\n  }\n  $msg = [SidebarPlan.RetypePlugin]::Run($sel, $dict)\n  if ($msg) { [Console]::Error.WriteLine($msg) }\n}\n\n$code = @'\nusing System;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.IO.Compression;\nusing System.Runtime.InteropServices;\nusing System.Text;\nusing System.Threading;\n\n// 拼音重输的核心：不依赖 MB out 的其它代码，只用 C# 5 语法。\n// 快捷面板插件「拼音重输」（tools\\plugins\\make_retype.ps1 生成）把这个文件原样放进 PowerShell 的 Add-Type 里编译，\n// 所以这里改了之后要重新生成插件。\nnamespace SidebarPlan\n{\n    /// <summary>\n    /// 汉字 → 无声调拼音（字典来自 pypinyin，MIT）。\n    /// 多音字：先按词组（只收了含多音字的词）做正向、逆向最大匹配，取切得少、单字少的那种；词组里没有的字用最常见读音。\n    /// </summary>\n    public static class Pinyin\n    {\n        /// <summary>字典（gzip 的 UTF-8 文本）从哪里读：默认是 exe 里的资源 pinyin.gz，插件里换成自带的</summary>\n        public static Func<Stream> OpenGz = () => typeof(Pinyin).Assembly.GetManifestResourceStream(\"pinyin.gz\");\n\n        static Dictionary<char, string> _chars;\n        static Dictionary<string, string[]> _phrases;\n        static int _maxLen;\n        static readonly object _lock = new object();\n\n        static void Load()\n        {\n            lock (_lock)\n            {\n                if (_chars != null) return;\n                var chars = new Dictionary<char, string>();\n                var phrases = new Dictionary<string, string[]>();\n                int max = 1;\n                using (var s = OpenGz())\n                {\n                    if (s != null)\n                        using (var r = new StreamReader(new GZipStream(s, CompressionMode.Decompress), Encoding.UTF8))\n                        {\n                            bool ph = false;\n                            string line;\n                            while ((line = r.ReadLine()) != null)\n                            {\n                                if (line.StartsWith(\"#\")) { if (line == \"#phrases\") ph = true; continue; }\n                                int t = line.IndexOf('\\t');\n                                if (t <= 0) continue;\n                                string k = line.Substring(0, t), v = line.Substring(t + 1);\n                                if (!ph) { if (k.Length == 1) chars[k[0]] = v.Split(',')[0]; continue; }\n                                var syl = v.Split(' ');\n                                if (syl.Length != k.Length) continue;\n                                phrases[k] = syl;\n                                if (k.Length > max) max = k.Length;\n                            }\n                        }\n                }\n                _phrases = phrases;\n                _maxLen = max;\n                _chars = chars;\n            }\n        }\n\n        public static bool Has(char c) { Load(); return _chars.ContainsKey(c); }\n\n        /// <summary>一段连续的汉字 → 每个字的拼音</summary>\n        public static List<string> OfRun(string run)\n        {\n            Load();\n            var fwd = Segment(run, true);\n            var bwd = Segment(run, false);\n            var best = Score(bwd) <= Score(fwd) ? bwd : fwd;\n            var res = new List<string>();\n            foreach (var seg in best) res.AddRange(seg);\n            return res;\n        }\n\n        // 切分结果：每段是这段字的拼音；正向 / 逆向最大匹配\n        static List<string[]> Segment(string run, bool forward)\n        {\n            var segs = new List<string[]>();\n            int n = run.Length;\n            if (forward)\n            {\n                for (int i = 0; i < n;)\n                {\n                    int len = Match(run, i, Math.Min(_maxLen, n - i), true);\n                    segs.Add(Read(run.Substring(i, len)));\n                    i += len;\n                }\n            }\n            else\n            {\n                for (int j = n; j > 0;)\n                {\n                    int len = Match(run, j, Math.Min(_maxLen, j), false);\n                    segs.Insert(0, Read(run.Substring(j - len, len)));\n                    j -= len;\n                }\n            }\n            return segs;\n        }\n\n        static int Match(string run, int at, int max, bool forward)\n        {\n            for (int len = max; len >= 2; len--)\n                if (_phrases.ContainsKey(forward ? run.Substring(at, len) : run.Substring(at - len, len))) return len;\n            return 1;\n        }\n\n        static string[] Read(string w)\n        {\n            string[] syl;\n            if (w.Length > 1 && _phrases.TryGetValue(w, out syl)) return syl;\n            return new[] { _chars[w[0]] };\n        }\n\n        // 越小越好：段数优先，其次单字段数\n        static int Score(List<string[]> segs)\n        {\n            int singles = 0;\n            foreach (var s in segs) if (s.Length == 1) singles++;\n            return segs.Count * 1000 + singles;\n        }\n\n        public const int MaxKeys = 60;\n\n        /// <summary>\n        /// 选中的文字 → 要重新敲的按键（小写字母和 '）：汉字转拼音，原本的拼音字母照抄，空白去掉。\n        /// 有数字、符号、生僻字等不能输入的内容时返回 false，err 是给用户看的原因。\n        /// </summary>\n        public static bool ToKeys(string text, out string keys, out string err)\n        {\n            keys = \"\"; err = null;\n            text = (text ?? \"\").Normalize(NormalizationForm.FormKC).Replace('ü', 'v').Replace('Ü', 'v');\n            var sb = new StringBuilder();\n            int i = 0;\n            while (i < text.Length)\n            {\n                char c = text[i];\n                if (char.IsWhiteSpace(c)) { i++; continue; }\n                if (c == '\\'') { if (sb.Length > 0 && sb[sb.Length - 1] != '\\'') sb.Append('\\''); i++; continue; }\n                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))\n                {\n                    int j = i;\n                    while (j < text.Length && ((text[j] >= 'a' && text[j] <= 'z') || (text[j] >= 'A' && text[j] <= 'Z'))) j++;\n                    Add(sb, text.Substring(i, j - i).ToLowerInvariant());\n                    i = j;\n                    continue;\n                }\n                if (Has(c))\n                {\n                    int j = i;\n                    while (j < text.Length && Has(text[j])) j++;\n                    foreach (var s in OfRun(text.Substring(i, j - i))) Add(sb, s);\n                    i = j;\n                    continue;\n                }\n                err = \"选中的内容里有「\" + c + \"」，只能是拼音和汉字\";\n                return false;\n            }\n            keys = sb.ToString().Trim('\\'');\n            if (keys.Length == 0) { err = \"选中的内容里没有拼音或汉字\"; return false; }\n            if (keys.Length > MaxKeys) { err = \"选中的太长了（转成拼音 \" + keys.Length + \" 个字母，最多 \" + MaxKeys + \" 个），分几段来\"; return false; }\n            return true;\n        }\n\n        // 接一个音节：以 a / o / e 开头时前面加隔音符号（xi'an、fang'an），免得输入法切错\n        static void Add(StringBuilder sb, string syl)\n        {\n            if (syl.Length == 0) return;\n            char f = syl[0];\n            if (sb.Length > 0 && sb[sb.Length - 1] != '\\'' && (f == 'a' || f == 'o' || f == 'e')) sb.Append('\\'');\n            sb.Append(syl);\n        }\n    }\n\n    /// <summary>\n    /// 把拼音敲进前台窗口：切到中文输入法的中文模式 → 关大写锁定 → Delete 删掉选中 → 一个个键敲进去，候选框留给用户选字。\n    /// 要在单独的线程上调用（会 Sleep；也不能是装了钩子的线程）。\n    /// 适配：手心、微软拼音、搜狗、QQ、百度、讯飞、微信输入法等挂在「中文(简体)」下的输入法。\n    /// </summary>\n    public static class RetypeCore\n    {\n        /// <summary>成功返回 null；没法输入时返回给用户看的原因</summary>\n        public static string TypeInto(IntPtr fg, string keys)\n        {\n            uint pid;\n            uint tid = GetWindowThreadProcessId(fg, out pid);\n            var gti = new GUITHREADINFO();\n            gti.cbSize = Marshal.SizeOf(typeof(GUITHREADINFO));\n            IntPtr focus = GetGUIThreadInfo(tid, ref gti) && gti.hwndFocus != IntPtr.Zero ? gti.hwndFocus : fg;\n\n            string err = EnsureChinese(fg, focus, tid);\n            if (err != null) return err;\n            // 大写锁定开着时输入法会直接放行字母（打出大写英文），先关掉\n            if ((GetKeyState(0x14) & 1) != 0) { Tap(0x14); Thread.Sleep(30); }\n\n            Tap(0x2E); // Delete 删掉选中\n            Thread.Sleep(10);\n            foreach (char c in keys)\n            {\n                Tap(c == '\\'' ? (ushort)0xDE : (ushort)char.ToUpperInvariant(c));\n                Thread.Sleep(6);\n            }\n            return null;\n        }\n\n        /// <summary>\n        /// 1. 当前不是中文键盘布局 → 请求切到 0804（会回到这个窗口上次用的中文输入法）；\n        /// 2. 输入法关着 → 打开；不在中文模式 → 用 IMM 消息设成中文（多数输入法认这个，TSF 输入法也会同步）；\n        /// 3. 设了读回来还是英文（输入法不认这个消息）→ 按一下左 Shift（各家输入法默认的中英切换键），再读一次。\n        /// </summary>\n        static string EnsureChinese(IntPtr fg, IntPtr focus, uint tid)\n        {\n            if (Lang(tid) != 0x0804)\n            {\n                PostMessage(fg, WM_INPUTLANGCHANGEREQUEST, IntPtr.Zero, LoadKeyboardLayout(\"00000804\", 0));\n                for (int i = 0; i < 40 && Lang(tid) != 0x0804; i++) Thread.Sleep(10);\n                if (Lang(tid) != 0x0804) return \"没能切到中文输入法：先在这个窗口里切到中文输入法再试\";\n                Thread.Sleep(60);\n            }\n            IntPtr ime = ImmGetDefaultIMEWnd(focus);\n            if (ime == IntPtr.Zero) ime = ImmGetDefaultIMEWnd(fg);\n            if (ime == IntPtr.Zero) return null; // 管不了模式，直接敲\n            if (ImeSend(ime, IMC_GETOPENSTATUS, 0) == 0)\n            {\n                ImeSend(ime, IMC_SETOPENSTATUS, 1);\n                Thread.Sleep(30);\n                if (ImeSend(ime, IMC_GETOPENSTATUS, 0) == 0) return \"当前是英文键盘，不是中文输入法：先切到中文输入法再试\";\n            }\n            if (Native(ime) == 0)\n            {\n                long conv = ImeSend(ime, IMC_GETCONVERSIONMODE, 0);\n                ImeSend(ime, IMC_SETCONVERSIONMODE, (int)(conv | IME_CMODE_NATIVE));\n                Thread.Sleep(50);\n                if (Native(ime) == 0)\n                {\n                    Tap(0xA0); // 左 Shift\n                    Thread.Sleep(80);\n                    if (Native(ime) == 0) { Tap(0xA0); return \"输入法没有切到中文模式：先手动切到中文再试\"; }\n                }\n            }\n            Thread.Sleep(30);\n            return null;\n        }\n\n        static int Lang(uint tid) { return (int)(GetKeyboardLayout(tid).ToInt64() & 0xFFFF); }\n\n        // 1 = 中文模式，0 = 英文模式，-1 = 问不到\n        static int Native(IntPtr ime)\n        {\n            long conv = ImeSend(ime, IMC_GETCONVERSIONMODE, 0);\n            return conv < 0 ? -1 : (int)(conv & IME_CMODE_NATIVE);\n        }\n\n        // ---- Win32 ----\n        const int WM_IME_CONTROL = 0x0283, WM_INPUTLANGCHANGEREQUEST = 0x0050;\n        const int IMC_GETCONVERSIONMODE = 1, IMC_SETCONVERSIONMODE = 2, IMC_GETOPENSTATUS = 5, IMC_SETOPENSTATUS = 6, IME_CMODE_NATIVE = 1;\n        static readonly IntPtr Tag = (IntPtr)0x50595254;\n\n        [DllImport(\"user32.dll\")] static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint pid);\n        [DllImport(\"user32.dll\")] static extern bool GetGUIThreadInfo(uint tid, ref GUITHREADINFO info);\n        [DllImport(\"user32.dll\")] static extern IntPtr GetKeyboardLayout(uint tid);\n        [DllImport(\"user32.dll\", CharSet = CharSet.Unicode)] static extern IntPtr LoadKeyboardLayout(string klid, uint flags);\n        [DllImport(\"user32.dll\")] static extern bool PostMessage(IntPtr hWnd, int msg, IntPtr wp, IntPtr lp);\n        [DllImport(\"user32.dll\")] static extern IntPtr SendMessageTimeout(IntPtr hWnd, int msg, IntPtr wp, IntPtr lp, uint flags, uint timeout, out IntPtr result);\n        [DllImport(\"user32.dll\")] static extern short GetKeyState(int vk);\n        [DllImport(\"user32.dll\")] static extern uint SendInput(uint n, INPUT[] inputs, int size);\n        [DllImport(\"user32.dll\")] static extern uint MapVirtualKey(uint code, uint type);\n        [DllImport(\"imm32.dll\")] static extern IntPtr ImmGetDefaultIMEWnd(IntPtr hWnd);\n\n        [StructLayout(LayoutKind.Sequential)] struct RECT { public int Left, Top, Right, Bottom; }\n        [StructLayout(LayoutKind.Sequential)]\n        struct GUITHREADINFO\n        {\n            public int cbSize, flags;\n            public IntPtr hwndActive, hwndFocus, hwndCapture, hwndMenuOwner, hwndMoveSize, hwndCaret;\n            public RECT rcCaret;\n        }\n        [StructLayout(LayoutKind.Sequential)] struct INPUT { public uint type; public InputUnion u; }\n        [StructLayout(LayoutKind.Explicit)] struct InputUnion { [FieldOffset(0)] public MOUSEINPUT mi; [FieldOffset(0)] public KEYBDINPUT ki; }\n        [StructLayout(LayoutKind.Sequential)] struct MOUSEINPUT { public int dx, dy; public uint mouseData, dwFlags, time; public IntPtr dwExtraInfo; }\n        [StructLayout(LayoutKind.Sequential)] struct KEYBDINPUT { public ushort wVk, wScan; public uint dwFlags, time; public IntPtr dwExtraInfo; }\n\n        static long ImeSend(IntPtr ime, int cmd, int value)\n        {\n            IntPtr r;\n            if (SendMessageTimeout(ime, WM_IME_CONTROL, (IntPtr)cmd, (IntPtr)value, 2 /* SMTO_ABORTIFHUNG */, 300, out r) == IntPtr.Zero) return -1;\n            return r.ToInt64();\n        }\n\n        static void Tap(ushort vk)\n        {\n            var list = new[] { Key(vk, false), Key(vk, true) };\n            SendInput(2, list, Marshal.SizeOf(typeof(INPUT)));\n        }\n\n        static INPUT Key(ushort vk, bool up)\n        {\n            uint flags = up ? 2u : 0u;\n            if (vk == 0x2E) flags |= 1; // Delete 是扩展键\n            var k = new KEYBDINPUT();\n            k.wVk = vk; k.wScan = (ushort)MapVirtualKey(vk, 0); k.dwFlags = flags; k.dwExtraInfo = Tag;\n            var i = new INPUT();\n            i.type = 1;\n            i.u.ki = k;\n            return i;\n        }\n    }\n}\n\nnamespace SidebarPlan\n{\n    /// <summary>插件入口：选中的文字 + 字典（base64 的 gzip）→ 敲进前台窗口；成功返回 null，否则返回原因</summary>\n    public static class RetypePlugin\n    {\n        [DllImport(\"user32.dll\")] static extern IntPtr GetForegroundWindow();\n\n        public static string Run(string sel, string dictB64)\n        {\n            Pinyin.OpenGz = () => new MemoryStream(Convert.FromBase64String(dictB64));\n            string keys, err;\n            if (!Pinyin.ToKeys(sel, out keys, out err)) return err;\n            IntPtr fg = GetForegroundWindow();\n            if (fg == IntPtr.Zero) return \"找不到当前窗口\";\n            return RetypeCore.TypeInto(fg, keys);\n        }\n    }\n}\n'@\n\n$dict = @'\nH4sIAAAAAAAAClS9yXIj19ImuI7zFNestrDq2tSurc26d73oXe3LqEzeFKUUM6UUr6RcEQBBECDmeZ5ncAI4ASRIvkuH31v/v7qv\r\n0PZ97pFSL8gIRJw4ceIMftw/n/7L3/61Svzzsvr/nhb+db77z+7tv3dn/6r2/jm8+Y+b6L93iX/vGv9qj/8jvvjb5z8+Hxz+cXD4\r\nt//2X//7f/+v/+1v/6tx8je98j/fH7z79W//298+f//L3pf9L/z5793Z//N//49/71I/ffp68PHj3tcP/94l/OPIP2Nn/0yX/3lZ\r\n9Y9T/7ys/u//4//8v/6P/7h+/s/ubUgP/nH637vUf7G6/ibb83/mMv+qXf8zt/znqPGf3dt/Xlb/V+PkP67T/nHqP67TrOE/u7d/\r\n02edfxz3Ph4cfgj9cbR3GPr94PCD83PH3s8HR87Phb1fD/YOnZ878X482nN+Lub9huun3h8HuJzy/jhwfq7i/X6w7/xcy3v3/Sfc\r\n73uHR5+cnxt57/cOQ1rXzPsdh7ln71h6vx984tmF95ElLtEQ5+euvN8P9njn2vtDi9zgKefnVt7X7/dxsvbe7+HVt9qgO+8z23nv\r\n/YKfj95PaO3G+/lg7zD0DgW32tQntDz09Xut9tk73MfVnffu+31eefH+zpN82Pv6Pb4hH/H+zsbko94efp/wjfmY95W3495XfnP+\r\nzHvPSvMJ7wt