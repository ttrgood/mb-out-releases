{
  "mbout_plugin": 1,
  "id": "mbout.calc",
  "name": "计算器",
  "version": "1.6",
  "author": "MB out",
  "description": "像写算稿一样算：一行一笔，右边马上出结果，下面自动合计，不用按等号。中文输入法打出来的 × ÷ 、 。 【】 全角数字都认，x 当乘号；支持 3.5万、1,280、15%、1000+9%、2²、√9、括号不配对自动补；带单位也行（3000mm×2.8m、12m²）。冒号前写备注（外墙：3.6×2.8），开头是运算符的行接着上一行的结果算，空一行另起一段；「2号楼」这种单独一行当小标题。Excel 复制的一列直接粘贴就合计。「合并成一行」只在需要的地方加括号，「统一符号」可换成直观的 × ÷ 或能直接贴进 Excel 的 * /；「复制 Excel 公式」把一段合成带 = 的公式（开逐笔舍入时每笔套 ROUND）。点结果复制，「复制算稿」带算式贴进计算书；小数位可选，可逐笔舍入；窗口右下角可拉大。先选中算式或一列数字再点，会自动填进去。第一次点要几秒（编译一次），以后很快；关掉只是藏起来，再点马上出来。",
  "cover": "v:calculator-variant|#38bdf8",
  "items": [
    {
      "kind": "script",
      "name": "计算器",
      "mode": "none",
      "icon": "v:calculator-variant",
      "icon_color": "#38bdf8",
      "value": "# 计算器：开一个小窗口，像写算稿一样一行一笔，右边马上出结果，下面是合计。点之前选中了算式或一列数字，会自动填进窗口。\n# 窗口是一个小程序：第一次点时用 Windows 自带的 C# 编译器把下面的源码编成 exe（几秒，只编一次），以后直接启动。\n# 关掉窗口只是藏起来，再点就马上出来；藏着时不退出（只占很少内存），插件更新后旧版本自己退出。算稿存在 calc_text.txt，下次打开还在。\n# 文件放在 MB out 的数据目录\\插件数据\\计算器（MB out 在「数据目录\\tmp」里运行插件脚本）；找不到就放 %LOCALAPPDATA%\\MBout-plugins\\calc。\n# 不联网，不改别的程序里的文字，只往剪贴板里放你点「复制」的内容。\n$dd = Split-Path -Parent (Get-Location).Path\n$dir = if (Test-Path (Join-Path $dd 'plan_data.json')) { Join-Path $dd '插件数据\\计算器' } else { Join-Path $env:LOCALAPPDATA 'MBout-plugins\\calc' }\n[void](New-Item -ItemType Directory -Force $dir)\n$utf8 = New-Object Text.UTF8Encoding $false\n$sel = \"$env:MB_SELECTION\".Trim()\nif ($sel.Length -gt 50000 -or $sel -notmatch '[0-9０-９]') { $sel = '' }\n[IO.File]::WriteAllText((Join-Path $dir 'calc_init.txt'), $sel, $utf8)\nif (Test-Path (Join-Path $dd 'plan_data.json')) { [IO.File]::WriteAllText((Join-Path $dir 'calc_datadir.txt'), $dd, $utf8) }\n\n# 窗口已经开着（或藏着）：按一下门铃就行\n$bell = 'Local\\mbout_calc_6ad2efdd17'\n$ev = $null\nif ([Threading.EventWaitHandle]::TryOpenExisting($bell, [ref]$ev)) { [void]$ev.Set(); return }\n\n# ---------------- 小程序源码（C#）----------------\nfunction Get-CalcSource {\n@'\n// 计算器：MB out 插件「计算器」的小窗口。像写算稿一样一行一笔，右边马上出结果，下面是合计。\n// 输入很宽松：中文输入法打出来的 × ÷ 、 。 【】 （） 全角数字都认；x 当乘号；3.5万；1,280；15%；2²；√9；\n// 冒号前面是备注（外墙：3.6×2.8），# 后面是注释，= 后面的不管；Excel 复制来的一列直接合计，一行里用 Tab 隔开的数相加。\n// 开头是运算符的行接着上一行的结果算（每行看作首尾有一对看不见的括号）；空一行另起一段，合计只算光标所在的这一段。\n// 单位：3000mm×2.8m 换成米算，12m² / 12m^2 照数算；开头的 = 去掉（Excel 公式贴进来也能算）。\n// 插件第一次运行时用 Windows 自带的 C# 编译器（.NET Framework 4）编成 exe，以后直接启动。只能用 C# 5 的写法。\n// 关掉窗口只是藏起来，再点插件马上出来；藏着时不退出（内存还给系统），插件更新后旧版本自己退出。算稿会存下来，下次打开还在。\nusing System;\nusing System.Collections.Generic;\nusing System.Globalization;\nusing System.IO;\nusing System.Linq;\nusing System.Text;\nusing System.Text.RegularExpressions;\nusing System.Threading;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Documents;\nusing System.Windows.Input;\nusing System.Windows.Media;\nusing System.Windows.Media.Animation;\nusing System.Windows.Media.Effects;\nusing System.Windows.Media.Imaging;\nusing System.Windows.Threading;\n\nnamespace MbCalc\n{\n    // ================================================================ 算一行\n    public class LineRes\n    {\n        public bool Empty = true;     // 空行（或只有备注）\n        public bool Ok;\n        public decimal Value;\n        public string Err = \"\";\n        public bool Absorbed;         // 被下一行接着算了：不单独算进合计\n        public bool Cont;             // 这一行接着上一行算\n        public string Label = \"\";\n        public int Start, End;        // 在整段文字里的位置（End 不含换行）\n        public int Section;           // 第几段（空行分段）\n    }\n\n    public class Sheet\n    {\n        public List<LineRes> Lines = new List<LineRes>();\n        public int Sections;\n        public decimal Total(int sec) { bool o; return Sum(sec, -1, false, out o); }\n        /// <summary>合计；perLine = 每笔先按 dec 位四舍五入再相加（和结算表逐项取整的口径一致）。加爆了 overflow = true</summary>\n        public decimal Sum(int sec, int dec, bool perLine, out bool overflow)\n        {\n            overflow = false;\n            decimal s = 0;\n            try\n            {\n                foreach (var l in Lines)\n                    if (l.Section == sec && l.Ok && !l.Absorbed)\n                        s += perLine && dec >= 0 ? Math.Round(l.Value, dec, MidpointRounding.AwayFromZero) : l.Value;\n            }\n            catch (OverflowException) { overflow = true; return 0; }\n            return s;\n        }\n        public int Count(int sec) { return Lines.Count(l => l.Section == sec && l.Ok && !l.Absorbed); }\n        public int Errors(int sec) { return Lines.Count(l => l.Section == sec && !l.Empty && !l.Ok); }\n    }\n\n    public static class Engine\n    {\n        class Tok { public char K; public decimal V; public bool Sp; public bool Tab; public bool Glued; }\n        class CalcErr : Exception { public CalcErr(string m) : base(m) { } }\n\n        public const decimal Pi = 3.1415926535897932384626433833m;\n\n        // 全角 → 半角（数字、字母、括号、冒号、等号、井号……）\n        public static string ToHalf(string t)\n        {\n            var sb = new StringBuilder(t.Length);\n            foreach (char c in t)\n            {\n                if (c >= 0xFF01 && c <= 0xFF5E) sb.Append((char)(c - 0xFEE0));\n                else if (c == 0x3000) sb.Append(' ');\n                else sb.Append(c);\n            }\n            return sb.ToString();\n        }\n\n        /// <summary>把一行整理成只剩算式的样子；label 是冒号前的备注</summary>\n        public static string Normalize(string raw, out string label)\n        {\n            string half = ToHalf(raw ?? \"\");\n            int st, en, lab;\n            Locate(half, out st, out en, out lab);\n            label = lab > 0 ? half.Substring(0, lab).Trim() : \"\";\n            string t = half.Substring(st, en - st);\n            var sb = new StringBuilder(t.Length);\n            foreach (char ch in t)\n            {\n                switch (ch)\n                {\n                    case '×': case '·': case '∙': case '⋅': case '✕': case '✖': sb.Append('*'); break;\n                    case '÷': case '、': case '∕': sb.Append('/'); break;      // 中文输入法里斜杠键打出来是「、」\n                    case '。': sb.Append('.'); break;                          // 中文输入法里句点键打出来是「。」\n                    case '…': sb.Append('^'); break;                           // 中文输入法里 Shift+6 是「……」\n                    case '−': case '–': case '—': case '－': sb.Append('-'); break;\n                    case '【': case '〔': case '[': case '{': sb.Append('('); break;\n                    case '】': case '〕': case ']': case '}': sb.Append(')'); break;\n                    case '¥': case '￥': case '$': case '\\r': break;\n                    default: sb.Append(ch); break;\n                }\n            }\n            t = sb.ToString().Replace(\"**\", \"^\");\n            t = Regex.Replace(t, @\"\\^+\", \"^\");\n            // x / X 只在两个数之间当乘号（3x4、(1+2)X3），别的地方的 x 是备注里的字母\n            t = Regex.Replace(t, @\"(?<=[0-9\\.\\)%²³]\\s*)[xX](?=\\s*[0-9\\.\\(√π])\", \"*\");\n            // 千分位逗号：1,280 / 12,345,678.9\n            t = Regex.Replace(t, @\"(?<=[0-9]),(?=[0-9]{3}(?![0-9]))\", \"\");\n            return t;\n        }\n\n        /// <summary>\n        /// 在（已转半角的）一行里找算式的位置 [st, en)：# 后面是注释；冒号前是备注（lab = 冒号位置，没有为 0）；\n        /// 算式开头的 = 去掉（从 Excel 复制来的「=3.6*2.8」）；算式里的 = 后面不管（「3.6*2.8=10.08」）\n        /// </summary>\n        public static void Locate(string half, out int st, out int en, out int lab)\n        {\n            en = half.Length; st = 0; lab = 0;\n            int h = CommentAt(half); if (h >= 0) en = h;\n            int c = half.IndexOf(':'); if (c >= en) c = -1;\n            int e = half.IndexOf('='); if (e >= en) e = -1;\n            // 冒号在第一个 = 前面才是备注（「3*4=12：备注」里冒号在结果后面，不算）；=3*2 这种开头的 = 不挡冒号\n            bool leadEq = e >= 0 && half.Substring(0, e).Trim().Length == 0;\n            if (c >= 0 && (e < 0 || c < e || leadEq)) { st = c + 1; lab = c; }\n            int k = st;\n            while (k < en && (half[k] == ' ' || half[k] == '\\t')) k++;\n            while (k < en && half[k] == '=') { k++; st = k; }\n            int e2 = half.IndexOf('=', st); if (e2 >= 0 && e2 < en) en = e2;\n            if (st > en) st = en;\n        }\n\n        /// <summary>注释的 #：在行首或前面是空白才算（「2#楼」「3#」里的 # 是楼号、编号，不是注释）</summary>\n        public static int CommentAt(string half)\n        {\n            for (int i = 0; i < half.Length; i++)\n                if (half[i] == '#' && (i == 0 || half[i - 1] == ' ' || half[i - 1] == '\\t')) return i;\n            return -1;\n        }\n\n        static bool IsHan(char c) { return c >= 0x3400 && c <= 0x9FFF || c >= 0xF900 && c <= 0xFAFF; }\n        static bool ValEnd(char k) { return k == 'n' || k == ')' || k == '%' || k == '²' || k == '³' || k == 'π' || k == 'A'; }\n        static bool ValStart(char k) { return k == 'n' || k == '(' || k == '√' || k == 'π' || k == 'A'; }\n\n        // 单位：长度一律换成米（3000mm×2.8m = 8.4），面积 / 体积换成平方米 / 立方米\n        static readonly string[][] Units =\n        {\n            new[] { \"平方毫米\", \"0.000001\" }, new[] { \"平方厘米\", \"0.0001\" }, new[] { \"平方米\", \"1\" }, new[] { \"立方毫米\", \"0.000000001\" }, new[] { \"立方厘米\", \"0.000001\" }, new[] { \"立方米\", \"1\" },\n            new[] { \"mm^2\", \"0.000001\" }, new[] { \"mm^3\", \"0.000000001\" }, new[] { \"cm^2\", \"0.0001\" }, new[] { \"cm^3\", \"0.000001\" }, new[] { \"m^2\", \"1\" }, new[] { \"m^3\", \"1\" },\n            new[] { \"mm²\", \"0.000001\" }, new[] { \"mm2\", \"0.000001\" }, new[] { \"mm³\", \"0.000000001\" }, new[] { \"mm3\", \"0.000000001\" },\n            new[] { \"cm²\", \"0.0001\" }, new[] { \"cm2\", \"0.0001\" }, new[] { \"cm³\", \"0.000001\" }, new[] { \"cm3\", \"0.000001\" },\n            new[] { \"m²\", \"1\" }, new[] { \"m2\", \"1\" }, new[] { \"m³\", \"1\" }, new[] { \"m3\", \"1\" }, new[] { \"㎡\", \"1\" }, new[] { \"㎥\", \"1\" }, new[] { \"平米\", \"1\" },\n            new[] { \"毫米\", \"0.001\" }, new[] { \"厘米\", \"0.01\" }, new[] { \"分米\", \"0.1\" }, new[] { \"公里\", \"1000\" }, new[] { \"方\", \"1\" },\n            new[] { \"mm\", \"0.001\" }, new[] { \"cm\", \"0.01\" }, new[] { \"dm\", \"0.1\" }, new[] { \"km\", \"1000\" }, new[] { \"m\", \"1\" }, new[] { \"米\", \"1\" },\n        };\n        static int Unit(string t, int i, out decimal f)\n        {\n            f = 1;\n            foreach (var u in Units)\n            {\n                string n = u[0];\n                if (i + n.Length > t.Length || string.Compare(t, i, n, 0, n.Length, StringComparison.OrdinalIgnoreCase) != 0) continue;\n                int j = i + n.Length;\n                // 字母单位后面不能紧跟字母或数字（mmabc、m25 不算单位）；汉字单位后面不能紧跟汉字（「方案」「米长」不算）\n                if (n[n.Length - 1] < 128 && j < t.Length && (char.IsLetterOrDigit(t[j]) && t[j] < 128)) continue;\n                if (n[n.Length - 1] >= 128 && n[n.Length - 1] != '²' && n[n.Length - 1] != '³' && j < t.Length && IsHan(t[j])) continue;\n                f = decimal.Parse(u[1], CultureInfo.InvariantCulture);\n                return n.Length;\n            }\n            return 0;\n        }\n\n        static List<Tok> Lex(string t) { bool plain; return Lex(t, out plain); }\n\n        /// <summary>plain = 这一行只有算式（没有夹文字备注、Tab、ans），合并时可以照原样搬过去</summary>\n        static List<Tok> Lex(string t, out bool plain)\n        {\n            var list = new List<Tok>();\n            bool sp = false, tab = false;\n            plain = true;\n            int i = 0;\n            while (i < t.Length)\n            {\n                char c = t[i];\n                if (c == ' ' || c == ' ') { sp = true; i++; continue; }\n                if (c == '\\t') { sp = true; tab = true; plain = false; i++; continue; }\n                Tok k = null;\n                if (char.IsDigit(c) && c < 128 || c == '.')\n                {\n                    int s = i;\n                    while (i < t.Length && t[i] >= '0' && t[i] <= '9') i++;\n                    if (i < t.Length && t[i] == '.') { i++; while (i < t.Length && t[i] >= '0' && t[i] <= '9') i++; }\n                    string num = t.Substring(s, i - s);\n                    if (num == \".\") throw new CalcErr(\"小数点前后没有数\");\n                    if (i < t.Length && t[i] == '.') throw new CalcErr(\"一个数里有两个小数点\");\n                    decimal v; bool hadUnit = false;\n                    try { v = decimal.Parse(num.EndsWith(\".\") ? num + \"0\" : (num.StartsWith(\".\") ? \"0\" + num : num), CultureInfo.InvariantCulture); }\n                    catch (OverflowException) { throw new CalcErr(\"数太大了\"); }\n                    try\n                    {\n                        while (i < t.Length)\n                        {\n                            char u = t[i];\n                            if (u == '百') v *= 100m; else if (u == '千') v *= 1000m; else if (u == '万' || u == 'w' || u == 'W') v *= 10000m; else if (u == '亿') v *= 100000000m; else break;\n                            i++;\n                        }\n                        // 数后面的单位：长度换算成米，面积 / 体积单位照数算（12m² 就是 12，不会当成 12 的平方）\n                        decimal f; int ul = Unit(t, i, out f);\n                        if (ul > 0) { v *= f; i += ul; hadUnit = true; }\n                        else\n                        {\n                            // 中间隔了空格的单位（3000 mm×2.8 m、12 m^2）：单位后面是运算符或行尾才算\n                            int j = i; while (j < t.Length && t[j] == ' ') j++;\n                            if (j > i && (ul = Unit(t, j, out f)) > 0)\n                            {\n                                int q = j + ul; while (q < t.Length && t[q] == ' ') q++;\n                                if (q >= t.Length || \"+-*/^)%\".IndexOf(t[q]) >= 0) { v *= f; i = q; hadUnit = true; }\n                            }\n                        }\n                    }\n                    catch (OverflowException) { throw new CalcErr(\"数太大了\"); }\n                    k = new Tok { K = 'n', V = v };\n                    // 数紧跟着汉字或 #（2号楼、3层、2#楼）：记下来，整行只有它时当小标题（带了单位的是量，不算标题：5m厚）\n                    if (!hadUnit && i < t.Length && (IsHan(t[i]) || t[i] == '#')) k.Glued = true;\n                }\n                else if (\"+-*/^()%²³√π\".IndexOf(c) >= 0) { k = new Tok { K = c }; i++; }\n                else if (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z')\n                {\n                    int s = i;\n                    while (i < t.Length && (t[i] >= 'a' && t[i] <= 'z' || t[i] >= 'A' && t[i] <= 'Z')) i++;\n                    string w = t.Substring(s, i - s).ToLowerInvariant();\n                    if (w == \"sqrt\") k = new Tok { K = '√' };\n                    else if (w == \"pi\") { k = new Tok { K = 'π' }; if (i + 1 < t.Length && t[i] == '(' && t[i + 1] == ')') i += 2; }   // Excel 的 PI()\n                    else if (w == \"ans\") { k = new Tok { K = 'A' }; plain = false; }\n                    else\n                    {\n                        // 字母后面紧跟括号：是函数（ABS、ROUND…），不认识就明说，不能跳过它只算括号里的\n                        if (i < t.Length && t[i] == '(') throw new CalcErr(\"不认识「\" + t.Substring(s, i - s) + \"」这个函数（只认 SQRT 和 PI）\");\n                        // 备注里的字母；后面跟的 ² ³ 也算备注（「3 m²」不能把 3 平方）\n                        while (i < t.Length && (t[i] == '²' || t[i] == '³')) i++;\n                        sp = true; plain = false; continue;\n                    }\n                }\n                else if (c == ',') throw new CalcErr(\"逗号看不懂（千分位要三位一个逗号）\");\n                else if (IsHan(c) || char.IsLetter(c) || c == '#' || c == '\"' || c == '\\'' || c == '“' || c == '”' || c == '‘' || c == '’' || c == '《' || c == '》' || c == '_')\n                { sp = true; plain = false; i++; continue; }      // 汉字等备注：当成空格\n                else throw new CalcErr(\"看不懂「\" + c + \"」\");\n\n                if (list.Count > 0)\n                {\n                    var p = list[list.Count - 1];\n                    if (ValEnd(p.K) && ValStart(k.K))\n                    {\n                        if (tab) list.Add(new Tok { K = '+' });                          // Excel 一行里 Tab 隔开的数：相加\n                        else if (!sp && (k.K != 'n' || p.K == ')' || p.K == 'π' || p.K == 'A')) list.Add(new Tok { K = '*' });   // 2(3+4)、(1+2)(3+4)、2π\n                        else throw new CalcErr(\"两个数中间缺运算符（备注请写在冒号前面，如「外墙：3.6×2.8」）\");\n                    }\n                }\n                k.Sp = sp; k.Tab = tab;\n                list.Add(k);\n                sp = false; tab = false;\n            }\n            return list;\n        }\n\n        class Parser\n        {\n            readonly List<Tok> _t; int _p; readonly decimal? _ans;\n            public bool UsedAns;\n            public Parser(List<Tok> t, decimal? ans)\n            {\n                _t = t; _ans = ans;\n                // 防止特别深的括号 / 一长串正负号把程序递归爆掉\n                if (t.Count > 4000) throw new CalcErr(\"这一行太长了\");\n                int d = 0, md = 0, run = 0, mrun = 0;\n                foreach (var k in t)\n                {\n                    if (k.K == '(') { d++; md = Math.Max(md, d); } else if (k.K == ')') d--;\n                    if (k.K == '-' || k.K == '+' || k.K == '√') { run++; mrun = Math.Max(mrun, run); } else run = 0;\n                }\n                if (md > 100 || mrun > 100) throw new CalcErr(\"括号或正负号套得太多了\");\n            }\n            char Peek() { return _p < _t.Count ? _t[_p].K : '\\0'; }\n\n            public decimal All()\n            {\n                decimal v = Expr();\n                if (_p < _t.Count) throw new CalcErr(Peek() == ')' ? \"右括号多了\" : \"这里看不懂\");\n                return v;\n            }\n            decimal Expr()\n            {\n                bool pct;\n                decimal v = Term(out pct);\n                while (Peek() == '+' || Peek() == '-')\n                {\n                    char op = _t[_p++].K;\n                    decimal r = Term(out pct);\n                    if (pct) r = v * r;                 // 1000+9% = 1090（和手机计算器一样）\n                    v = op == '+' ? v + r : v - r;\n                }\n                return v;\n            }\n            decimal Term(out bool pct)\n            {\n                decimal v = Unary(out pct);\n                while (Peek() == '*' || Peek() == '/')\n                {\n                    char op = _t[_p++].K;\n                    bool dummy;\n                    decimal r = Unary(out dummy);\n                    if (op == '*') v *= r;\n                    else { if (r == 0) throw new CalcErr(\"不能除以 0\"); v /= r; }\n                    pct = false;\n                }\n                return v;\n            }\n            decimal Unary(out bool pct)\n            {\n                if (Peek() == '-') { _p++; return -Unary(out pct); }\n                if (Peek() == '+') { _p++; return Unary(out pct); }\n                return Power(out pct);\n            }\n            decimal Power(out bool pct)\n            {\n                decimal b = Postfix(out pct);\n                if (Peek() == '^')\n                {\n                    _p++;\n                    bool dummy;\n                    decimal e = Unary(out dummy);\n                    b = Pow(b, e); pct = false;\n                }\n                return b;\n            }\n            decimal Postfix(out bool pct)\n            {\n                decimal v = Atom(); pct = false;\n                while (true)\n                {\n                    char c = Peek();\n                    if (c == '%') { v /= 100m; pct = true; }\n                    else if (c == '²') { v *= v; pct = false; }\n                    else if (c == '³') { v = v * v * v; pct = false; }\n                    else break;\n                    _p++;\n                }\n                return v;\n            }\n            decimal Atom()\n            {\n                char c = Peek();\n                if (c == 'n') return _t[_p++].V;\n                if (c == '(')\n                {\n                    _p++;\n                    if (Peek() == ')') throw new CalcErr(\"括号里是空的\");\n                    decimal v = Expr();\n                    if (Peek() == ')') _p++;\n                    else if (_p < _t.Count) throw new CalcErr(\"括号没配对\");\n                    // 行尾没写的右括号自动补上\n                    return v;\n                }\n                if (c == '√')\n                {\n                    _p++;\n                    bool dummy;\n                    decimal x = Postfix(out dummy);\n                    if (x < 0) throw new CalcErr(\"负数不能开方\");\n                    return Sqrt(x);\n                }\n                if (c == 'π') { _p++; return Pi; }\n                if (c == 'A')\n                {\n                    _p++;\n                    if (!_ans.HasValue) throw new CalcErr(\"前面没有结果可以接着算\");\n                    UsedAns = true;\n                    return _ans.Value;\n                }\n                if (c == '\\0') throw new CalcErr(\"后面少个数\");\n                if (c == ')') throw new CalcErr(\"右括号多了\");\n                throw new CalcErr(\"「\" + c + \"」前面少个数\");\n            }\n        }\n\n        static decimal Pow(decimal b, decimal e)\n        {\n            if (e == decimal.Truncate(e) && Math.Abs(e) <= 200)\n            {\n                int n = (int)Math.Abs(e);\n                decimal r = 1;\n                for (int i = 0; i < n; i++) r *= b;\n                if (e < 0) { if (r == 0) throw new CalcErr(\"不能除以 0\"); r = 1 / r; }\n                return r;\n            }\n            double d = Math.Pow((double)b, (double)e);\n            if (double.IsNaN(d)) throw new CalcErr(\"负数不能开这种方\");\n            if (double.IsInfinity(d) || Math.Abs(d) > 7.9e28) throw new CalcErr(\"数太大了\");\n            return (decimal)d;\n        }\n\n        static decimal Sqrt(decimal x)\n        {\n            if (x == 0) return 0;\n            decimal y = (decimal)Math.Sqrt((double)x);\n            for (int i = 0; i < 3 && y > 0; i++) y = (y + x / y) / 2;\n            return y;\n        }\n\n        /// <summary>算整张算稿</summary>\n        public static Sheet Run(string text)\n        {\n            var sh = new Sheet();\n            text = text ?? \"\";\n            int pos = 0, sec = 0;\n            bool lastBlank = true;\n            int prevIdx = -1;\n            while (true)\n            {\n                int nl = text.IndexOf('\\n', pos);\n                int end = nl < 0 ? text.Length : nl;\n                int e2 = end; if (e2 > pos && text[e2 - 1] == '\\r') e2--;\n                string raw = text.Substring(pos, e2 - pos);\n                var r = new LineRes { Start = pos, End = e2 };\n                string label;\n                List<Tok> toks = null;\n                try\n                {\n                    string t = Normalize(raw, out label);\n                    r.Label = label;\n                    toks = Lex(t);\n                }\n                catch (CalcErr ex) { r.Empty = false; r.Err = ex.Message; }\n                // 整行只有一个连着汉字的数（2号楼、3层、2#楼）：是小标题，不算一笔\n                if (toks != null && toks.Count == 1 && toks[0].K == 'n' && toks[0].Glued) toks.Clear();\n                if (toks != null && toks.Count == 0)\n                {\n                    r.Empty = true;\n                    if (raw.Trim().Length == 0) { if (!lastBlank) { sec++; lastBlank = true; } prevIdx = -1; }\n                }\n                else\n                {\n                    lastBlank = false;\n                    r.Empty = false;\n                    if (toks != null)\n                    {\n                        // 开头是运算符：接着上一行的结果算（+ − 也一样；上面没有可接的行才当正负数）\n                        char f = toks[0].K;\n                        bool cont = f == '*' || f == '/' || f == '^' || f == '%' || f == '²' || f == '³' ||\n                                    ((f == '+' || f == '-') && prevIdx >= 0);\n                        decimal? ans = null;\n                        if (prevIdx >= 0 && sh.Lines[prevIdx].Ok) ans = sh.Lines[prevIdx].Value;\n                        try\n                        {\n                            if (cont)\n                            {\n                                if (!ans.HasValue) throw new CalcErr(\"这一行开头是运算符，要接着上一行的结果算，但上一行没有结果\");\n                                toks.Insert(0, new Tok { K = 'A' });\n                                r.Cont = true;\n                            }\n                            var p = new Parser(toks, ans);\n                            decimal v = p.All();\n                            if (p.UsedAns && prevIdx >= 0) sh.Lines[prevIdx].Absorbed = true;\n                            r.Ok = true; r.Value = v;\n                        }\n                        catch (CalcErr ex) { r.Err = ex.Message; }\n                        catch (OverflowException) { r.Err = \"数太大了\"; }\n                        catch (DivideByZeroException) { r.Err = \"不能除以 0\"; }\n                    }\n                    prevIdx = sh.Lines.Count;\n                }\n                r.Section = sec;\n                sh.Lines.Add(r);\n                if (nl < 0) break;\n                pos = nl + 1;\n            }\n            // 末尾的空行不另起一段\n            int maxSec = 0;\n            foreach (var l in sh.Lines) if (!l.Empty) maxSec = Math.Max(maxSec, l.Section);\n            foreach (var l in sh.Lines) if (l.Section > maxSec) l.Section = maxSec;\n            sh.Sections = maxSec + 1;\n            return sh;\n        }\n\n        // ================================================================ 合并成一行\n        // 每一行看作首尾各有一个看不见的括号：下一行开头的运算符作用在「上面算到这儿的整体」上。\n        // 合并时把这些看不见的括号写出来，但只写必要的：(9+6)*3+1 里 +1 前面就不用再包一层。\n\n        class Piece { public string Text; public List<Tok> T; }\n\n        /// <summary>原样的算式部分：去掉冒号前的备注、# 后的注释、= 后面的，符号照用户打的</summary>\n        static string Strip(string raw)\n        {\n            string t = raw ?? \"\";\n            int st, en, lab;\n            Locate(ToHalf(t), out st, out en, out lab);\n            return t.Substring(st, en - st).Replace(\"\\t\", \" \").Trim();\n        }\n\n        // 最外层最松的运算：0 = 开头是正负号，1 = 加减，2 = 乘除，3 = 乘方或开方，4 = 一个数 / 一对括号\n        static int Prec(List<Tok> t)\n        {\n            if (t.Count == 0) return 4;\n            if (t[0].K == '+' || t[0].K == '-') return 0;\n            int p = 4, d = 0;\n            for (int i = 0; i < t.Count; i++)\n            {\n                char k = t[i].K;\n                if (k == '(') { d++; continue; }\n                if (k == ')') { d--; continue; }\n                if (d != 0) continue;\n                if ((k == '+' || k == '-') && i > 0 && ValEnd(t[i - 1].K)) p = Math.Min(p, 1);\n                else if (k == '*' || k == '/') p = Math.Min(p, 2);\n                else if (k == '^') p = Math.Min(p, 3);\n            }\n            if (t[0].K == '√' && p == 4) p = 3;\n            return p;\n        }\n\n        // 第一项是百分数（9%、-5%）：放在 + − 后面意思会变（1000+9% = 1090），要包起来\n        static bool LeadsWithPct(List<Tok> t)\n        {\n            int d = 0;\n            for (int i = 0; i < t.Count; i++)\n            {\n                char k = t[i].K;\n                if (k == '(') d++; else if (k == ')') d--;\n                if (d != 0) continue;\n                if (k == '*' || k == '/' || k == '^') return false;\n                if ((k == '+' || k == '-') && i > 0 && ValEnd(t[i - 1].K)) return false;\n                if (k == '%') return true;\n            }\n            return false;\n        }\n\n        // 最外层有百分数项（不管第几项）：整体放到 + − 后面时，百分数会改成「按前面的数加几成」，要包起来\n        static bool HasTopPct(List<Tok> t)\n        {\n            int d = 0;\n            foreach (var k in t)\n            {\n                if (k.K == '(') d++; else if (k.K == ')') d--;\n                else if (d == 0 && k.K == '%') return true;\n            }\n            return false;\n        }\n\n        static Piece Wrap(Piece p)\n        {\n            var t = new List<Tok> { new Tok { K = '(' } }; t.AddRange(p.T); t.Add(new Tok { K = ')' });\n            return new Piece { Text = \"(\" + p.Text + \")\", T = t };\n        }\n\n        // 把上面的整体放到 t[i]（ans 的位置）要不要加括号：看左右两边的运算\n        static bool NeedWrap(Piece acc, List<Tok> t, int i, bool always)\n        {\n            int p = Prec(acc.T);\n            if (p == 4) return false;\n            if (always) return true;\n            char L = i > 0 ? t[i - 1].K : '\\0', R = i + 1 < t.Count ? t[i + 1].K : '\\0';\n            bool lBinary = i > 1 && ValEnd(t[i - 2].K);\n            int need = 0;\n            if (R == '*' || R == '/') need = Math.Max(need, 2);\n            else if (R == '^' || R == '%' || R == '²' || R == '³') need = 4;\n            if (L == '+' || L == '-')\n            {\n                if (!lBinary) need = Math.Max(need, 2);\n                else need = Math.Max(need, L == '+' ? 1 : 2);\n                if (p == 0 || HasTopPct(acc.T)) return true;\n            }\n            else if (L == '*') need = Math.Max(need, 2);\n            else if (L == '/') need = Math.Max(need, 3);\n            else if (L == '^' || L == '√') need = 4;\n            if (p == 0 && (R == '*' || R == '/' || R == '^' || R == '%' || R == '²' || R == '³')) return true;\n            return p < need;\n        }\n\n        static string NumText(decimal v) { return v.ToString(\"0.############################\", CultureInfo.InvariantCulture); }\n\n        // 一行有备注 / Tab / ans：按认出来的算式重新写一遍；ans 换成上面的整体\n        static Piece Rebuild(List<Tok> t, Piece acc, bool always, string mul, string div)\n        {\n            var sb = new StringBuilder(); var outT = new List<Tok>();\n            for (int i = 0; i < t.Count; i++)\n            {\n                var k = t[i];\n                if (k.K == 'A')\n                {\n                    var a = NeedWrap(acc, t, i, always) ? Wrap(acc) : acc;\n                    sb.Append(a.Text); outT.AddRange(a.T); continue;\n                }\n                if (k.K == 'n') sb.Append(NumText(k.V));\n                else if (k.K == '*') sb.Append(mul);\n                else if (k.K == '/') sb.Append(div);\n                else sb.Append(k.K);\n                outT.Add(k);\n            }\n            return new Piece { Text = sb.ToString(), T = outT };\n        }\n\n        /// <summary>把第 sec 段合成一个算式；算不出 / 合不上返回 null 和原因</summary>\n        public static string Merge(string text, int sec, out string err)\n        {\n            err = \"\";\n            var sh = Run(text);\n            var lines = sh.Lines.Where(l => l.Section == sec && !l.Empty).ToList();\n            if (lines.Count == 0) { err = \"这一段没有算式\"; return null; }\n            var bad = lines.FirstOrDefault(l => !l.Ok);\n            if (bad != null) { err = \"有一行算不出（\" + bad.Err + \"），先改好再合并\"; return null; }\n            // 乘除号跟着用户的习惯：多数打的是 × 就用 ×，否则用 *\n            string all = string.Join(\"\\n\", lines.Select(l => text.Substring(l.Start, l.End - l.Start)));\n            bool times = all.Count(c => c == '×' || c == '÷') >= all.Count(c => c == '*' || c == '/');\n            string mul = times ? \"×\" : \"*\", div = times ? \"÷\" : \"/\";\n            decimal want = sh.Total(sec);\n            for (int pass = 0; pass < 2; pass++)\n            {\n                string m = MergeOnce(text, lines, pass == 1, mul, div);\n                if (m == null) continue;\n                var chk = Run(m);\n                if (chk.Lines.Count == 1 && chk.Lines[0].Ok && chk.Lines[0].Value == want) return m;   // 必须完全相等\n            }\n            err = \"合并后结果对不上，没有合并（请把这一段发给作者看看）\";\n            return null;\n        }\n\n        static string MergeOnce(string text, List<LineRes> lines, bool always, string mul, string div)\n        {\n            Piece total = null, chain = null;\n            foreach (var l in lines)\n            {\n                string raw = text.Substring(l.Start, l.End - l.Start);\n                string label; bool plain;\n                List<Tok> t;\n                try { t = Lex(Normalize(raw, out label), out plain); } catch (CalcErr) { return null; }\n                // 行尾没写的右括号补上\n                int d = 0; foreach (var k in t) { if (k.K == '(') d++; else if (k.K == ')') d--; }\n                string close = d > 0 ? new string(')', d) : \"\";\n                for (int i = 0; i < d; i++) t.Add(new Tok { K = ')' });\n\n                Piece cur;\n                if (l.Cont)\n                {\n                    // 开头是运算符：上面的整体（看不见的括号）+ 这一行\n                    var full = new List<Tok> { new Tok { K = 'A' } }; full.AddRange(t);\n                    if (plain)\n                    {\n                        var a = NeedWrap(chain, full, 0, always) ? Wrap(chain) : chain;\n                        var ct = new List<Tok>(a.T); ct.AddRange(t);\n                        cur = new Piece { Text = a.Text + Strip(raw) + close, T = ct };\n                    }\n                    else cur = Rebuild(full, chain, always, mul, div);\n                    chain = cur;\n                    continue;\n                }\n                if (t.Any(k => k.K == 'A')) { chain = Rebuild(t, chain, always, mul, div); continue; }\n                cur = plain ? new Piece { Text = Strip(raw) + close, T = t } : Rebuild(t, null, always, mul, div);\n                total = Join(total, chain, always);\n                chain = cur;\n            }\n            total = Join(total, chain, always);\n            if (total == null) return null;\n            string s = total.Text;\n            if (s.StartsWith(\"+\")) s = s.Substring(1);\n            return s;\n        }\n\n        // 互不相干的几行合计：用 + 连起来\n        static Piece Join(Piece total, Piece p, bool always)\n        {\n            if (p == null) return total;\n            if (total == null) return p;\n            if (always && Prec(p.T) < 4 || HasTopPct(p.T)) p = Wrap(p);\n            var t = new List<Tok>(total.T);\n            char f = p.T.Count > 0 ? p.T[0].K : '\\0';\n            if (f == '+' || f == '-') { t.AddRange(p.T); return new Piece { Text = total.Text + p.Text, T = t }; }\n            t.Add(new Tok { K = '+' }); t.AddRange(p.T);\n            return new Piece { Text = total.Text + \"+\" + p.Text, T = t };\n        }\n\n        // ================================================================ 统一符号\n        // 直观：+ - × ÷（字符替换，备注照留）；Excel：+ - * /、SQRT()、PI()、万换成数，能直接贴进 Excel。\n        // 两边规则不同的地方 Excel 写法会补括号：1000+9% → (1000)*(1+9%)，-3² → -(3^2)，2^3^2 → 2^(3^2)。\n        // 换完逐行核对结果；哪一行结果变了就保持原样。\n\n        /// <summary>一行拆成：备注前缀 | 算式 | 注释或 = 后面</summary>\n        static void SplitLine(string raw, out string prefix, out string expr, out string suffix)\n        {\n            int st, end, lab;\n            Locate(ToHalf(raw), out st, out end, out lab);\n            prefix = raw.Substring(0, st); expr = raw.Substring(st, end - st); suffix = raw.Substring(end);\n        }\n\n        static string ToPlainSyms(string expr)\n        {\n            string t = ToHalf(expr);\n            t = Regex.Replace(t, @\"(?i)sqrt\", \"√\");\n            t = Regex.Replace(t, @\"(?i)pi\\(\\)\", \"π\");\n            var sb = new StringBuilder();\n            foreach (char ch in t)\n            {\n                switch (ch)\n                {\n                    case '*': case '·': case '∙': case '⋅': case '✕': case '✖': sb.Append('×'); break;\n                    case '/': case '、': case '∕': sb.Append('÷'); break;\n                    case '。': sb.Append('.'); break;\n                    case '…': sb.Append('^'); break;\n                    case '−': case '–': case '—': sb.Append('-'); break;\n                    case '【': case '〔': case '[': case '{': sb.Append('('); break;\n                    case '】': case '〕': case ']': case '}': sb.Append(')'); break;\n                    default: sb.Append(ch); break;\n                }\n            }\n            t = sb.ToString().Replace(\"××\", \"^\");\n            t = Regex.Replace(t, @\"\\^+\", \"^\");\n            t = Regex.Replace(t, @\"(?<=[0-9\\.\\)%²³]\\s*)[xX](?=\\s*[0-9\\.\\(√π])\", \"×\");\n            return t;\n        }\n\n        // Excel 写法：按认出来的算式重新写；pr 为 0 = 开头正负号，1 加减，2 乘除，3 乘方，4 一个数 / 一对括号\n        class XP\n        {\n            readonly List<Tok> _t; int _p;\n            public XP(List<Tok> t) { _t = t; }\n            char Peek() { return _p < _t.Count ? _t[_p].K : '\\0'; }\n            static bool IsGroup(string s)\n            {\n                if (!s.StartsWith(\"(\") || !s.EndsWith(\")\")) return false;\n                int d = 0;\n                for (int i = 0; i < s.Length; i++) { if (s[i] == '(') d++; else if (s[i] == ')') { d--; if (d == 0 && i < s.Length - 1) return false; } }\n                return true;\n            }\n            public string All() { int pr; string s = Expr(out pr); if (_p < _t.Count) throw new CalcErr(\"这里看不懂\"); return s; }\n            string Expr(out int pr)\n            {\n                bool pct; string s = Term(out pct, out pr);\n                while (Peek() == '+' || Peek() == '-')\n                {\n                    char op = _t[_p++].K;\n                    bool p2; int rp;\n                    string r = Term(out p2, out rp);\n                    if (p2) { s = (pr <= 1 ? \"(\" + s + \")\" : s) + \"*(1\" + op + (rp == 0 ? \"(\" + r + \")\" : r) + \")\"; pr = 2; }\n                    else if (r.StartsWith(\"-\")) { s = s + (op == '+' ? \"-\" : \"+\") + r.Substring(1); pr = 1; }   // a+-3 写成 a-3\n                    else { s = s + op + r; pr = 1; }\n                }\n                return s;\n            }\n            string Term(out bool pct, out int pr)\n            {\n                string s = Unary(out pct, out pr);\n                while (Peek() == '*' || Peek() == '/')\n                {\n                    char op = _t[_p++].K;\n                    bool d; int rp;\n                    string r = Unary(out d, out rp);\n                    s = s + op + r; pr = 2; pct = false;\n                }\n                return s;\n            }\n            string Unary(out bool pct, out int pr)\n            {\n                if (Peek() == '-')\n                {\n                    _p++;\n                    int ip; string inner = Unary(out pct, out ip);\n                    if (ip == 3 || ip == 0) inner = \"(\" + inner + \")\";      // Excel 里 -3^2 = 9，要写成 -(3^2)\n                    pr = 0; return \"-\" + inner;\n                }\n                if (Peek() == '+') { _p++; return Unary(out pct, out pr); }\n                return Power(out pct, out pr);\n            }\n            string Power(out bool pct, out int pr)\n            {\n                string b = Postfix(out pct, out pr);\n                if (Peek() == '^')\n                {\n                    _p++;\n                    bool d; int ep;\n                    string e = Unary(out d, out ep);\n                    if (ep == 3) e = \"(\" + e + \")\";                          // Excel 的乘方从左往右算\n                    if (pr == 3) b = \"(\" + b + \")\";\n                    pct = false; pr = 3;\n                    return b + \"^\" + e;\n                }\n                return b;\n            }\n            string Postfix(out bool pct, out int pr)\n            {\n                string s = Atom(out pr); pct = false;\n                while (true)\n                {\n                    char c = Peek();\n                    if (c == '%') { s += \"%\"; pct = true; }\n                    else if (c == '²' || c == '³') { if (pr == 3) s = \"(\" + s + \")\"; s += c == '²' ? \"^2\" : \"^3\"; pr = 3; pct = false; }\n                    else break;\n                    _p++;\n                }\n                return s;\n            }\n            string Atom(out int pr)\n            {\n                pr = 4;\n                char c = Peek();\n                if (c == 'n') return NumText(_t[_p++].V);\n                if (c == '(')\n                {\n                    _p++;\n                    int ip; string s = Expr(out ip);\n                    if (Peek() == ')') _p++;\n                    return \"(\" + s + \")\";\n                }\n                if (c == '√')\n                {\n                    _p++;\n                    bool d; int ip; string s = Postfix(out d, out ip);\n                    return IsGroup(s) ? \"SQRT\" + s : \"SQRT(\" + s + \")\";\n                }\n                if (c == 'π') { _p++; return \"PI()\"; }\n                if (c == 'A') { _p++; return \"@\"; }\n                throw new CalcErr(\"这里少个数\");\n            }\n        }\n\n        static string ToExcel(string expr, bool cont, bool hasLabel, out string notes)\n        {\n            notes = \"\";\n            string label;\n            string norm = Normalize(expr, out label);\n            var toks = Lex(norm);\n            if (toks.Count == 0) return expr;\n            if (!hasLabel)\n            {\n                var words = Regex.Matches(norm, @\"(?<![0-9\\.])[㐀-鿿A-Za-z][㐀-鿿A-Za-z0-9]*\").Cast<Match>().Select(m => m.Value)\n                    .Where(w => !Regex.IsMatch(w, \"^(?i)(sqrt|pi|ans)$\")).ToList();\n                notes = string.Join(\" \", words);\n            }\n            if (cont) toks.Insert(0, new Tok { K = 'A' });\n            int d = 0; foreach (var k in toks) { if (k.K == '(') d++; else if (k.K == ')') d--; }\n            for (int i = 0; i < d; i++) toks.Add(new Tok { K = ')' });\n            string s = new XP(toks).All();\n            if (cont) { if (!s.StartsWith(\"@\") || s.IndexOf('@', 1) >= 0) throw new CalcErr(\"接着算的行换不了\"); s = s.Substring(1); }\n            else if (s.Contains(\"@\")) s = s.Replace(\"@\", \"ans\");\n            return s;\n        }\n\n        /// <summary>统一整张算稿的符号；changed = 改了几行，kept = 换了会变结果、保持原样的行数</summary>\n        public static string Unify(string text, bool excel, out int changed, out int kept)\n        {\n            changed = 0; kept = 0;\n            text = text ?? \"\";\n            var before = Run(text);\n            var parts = new List<string>();\n            var seps = new List<string>();\n            int pos = 0;\n            while (true)\n            {\n                int nl = text.IndexOf('\\n', pos);\n                int end = nl < 0 ? text.Length : nl;\n                int e2 = end; if (e2 > pos && text[e2 - 1] == '\\r') e2--;\n                parts.Add(text.Substring(pos, e2 - pos));\n                seps.Add(nl < 0 ? \"\" : text.Substring(e2, nl + 1 - e2));\n                if (nl < 0) break;\n                pos = nl + 1;\n            }\n            var outp = new List<string>(parts);\n            for (int i = 0; i < parts.Count; i++)\n            {\n                var l = before.Lines[i];\n                if (l.Empty || !l.Ok) continue;\n                string pre, ex, suf;\n                SplitLine(parts[i], out pre, out ex, out suf);\n                string lead = ex.Substring(0, ex.Length - ex.TrimStart().Length), trail = ex.Substring(ex.TrimEnd().Length);\n                string body = ex.Trim();\n                string nb;\n                try\n                {\n                    if (excel)\n                    {\n                        string notes;\n                        nb = ToExcel(body, l.Cont, pre.Length > 0, out notes);\n                        if (notes.Length > 0) pre = notes + \"：\";\n                    }\n                    else nb = ToPlainSyms(body);\n                }\n                catch (CalcErr) { continue; }\n                outp[i] = pre + lead + nb + trail + suf;\n            }\n            // 逐行核对：结果变了的行还原\n            for (int round = 0; round < 3; round++)\n            {\n                var sb = new StringBuilder();\n                for (int i = 0; i < outp.Count; i++) sb.Append(outp[i]).Append(seps[i]);\n                var after = Run(sb.ToString());\n                bool bad = false;\n                for (int i = 0; i < outp.Count && i < after.Lines.Count; i++)\n                {\n                    if (outp[i] == parts[i]) continue;\n                    var a = before.Lines[i]; var b = after.Lines[i];\n                    if (!(b.Ok && b.Cont == a.Cont && Math.Round(a.Value - b.Value, 12) == 0)) { outp[i] = parts[i]; bad = true; kept++; }\n                }\n                if (!bad) break;\n            }\n            var res = new StringBuilder();\n            for (int i = 0; i < outp.Count; i++) { if (outp[i] != parts[i]) changed++; res.Append(outp[i]).Append(seps[i]); }\n            return res.ToString();\n        }\n\n        /// <summary>\n        /// 第 sec 段 → 一条带 = 的 Excel 公式：先合并成一行，再换成 Excel 写法，核对结果不变。\n        /// 开着逐笔舍入（perLine 且 dec ≥ 0）：每一笔（连同接着它算的行）套 ROUND(…, dec) 再相加，和窗口里的合计口径一致。\n        /// </summary>\n        public static string ExcelFormula(string text, int sec, int dec, bool perLine, out string err)\n        {\n            err = \"\";\n            var sh = Run(text);\n            var lines = sh.Lines.Where(l => l.Section == sec && !l.Empty).ToList();\n            if (lines.Count == 0) { err = \"这一段没有算式\"; return null; }\n            var bad = lines.FirstOrDefault(l => !l.Ok);\n            if (bad != null) { err = \"有一行算不出（\" + bad.Err + \"），先改好再复制\"; return null; }\n            string body;\n            try\n            {\n                if (!(perLine && dec >= 0))\n                {\n                    string m = Merge(text, sec, out err);\n                    if (m == null) return null;\n                    string notes;\n                    body = ToExcel(m, false, true, out notes);\n                    var chk = Run(body);\n                    if (chk.Lines.Count != 1 || !chk.Lines[0].Ok || chk.Lines[0].Value != sh.Total(sec)) { err = \"换成 Excel 公式后结果对不上，没有复制\"; return null; }\n                }\n                else\n                {\n                    // 一笔 = 一行，加上后面接着它算的行，到不再被接着算的那一行为止\n                    var parts = new List<string>();\n                    var chain = new List<LineRes>();\n                    foreach (var l in lines)\n                    {\n                        chain.Add(l);\n                        if (l.Absorbed) continue;\n                        string sub = string.Join(\"\\n\", chain.Select(c => text.Substring(c.Start, c.End - c.Start)));\n                        string m = Merge(sub, 0, out err);\n                        if (m == null) return null;\n                        string notes;\n                        string x = ToExcel(m, false, true, out notes);\n                        var chk = Run(x);\n                        if (chk.Lines.Count != 1 || !chk.Lines[0].Ok || chk.Lines[0].Value != l.Value) { err = \"换成 Excel 公式后结果对不上，没有复制\"; return null; }\n                        parts.Add(\"ROUND(\" + x + \",\" + dec.ToString(CultureInfo.InvariantCulture) + \")\");\n                        chain.Clear();\n                    }\n                    body = string.Join(\"+\", parts);\n                }\n            }\n            catch (CalcErr ex) { err = ex.Message; return null; }\n            if (body.Length + 1 > 8192) { err = \"公式有 \" + (body.Length + 1) + \" 个字，超过 Excel 一个格子的上限 8192 字，没有复制；可以空一行分成几段再复制\"; return null; }\n            return \"=\" + body;\n        }\n\n        /// <summary>显示用：dec = -1 自动（最多 10 位小数，去掉末尾的 0）</summary>\n        public static string Fmt(decimal v, int dec, bool group)\n        {\n            decimal r = Math.Round(v, dec < 0 ? 10 : dec, MidpointRounding.AwayFromZero);\n            if (r == 0) r = 0m;\n            string f = group ? \"#,##0\" : \"0\";\n            if (dec < 0) f += \".##########\";\n            else if (dec > 0) f += \".\" + new string('0', dec);\n            string s = r.ToString(f, CultureInfo.InvariantCulture);\n            if (s == \"-0\" || Regex.IsMatch(s, @\"^-0(\\.0+)?$\")) s = s.Substring(1);\n            return s;\n        }\n    }\n\n    // ================================================================ 配色：按 MB out 的算法（Palette.From）从底色 / 文字色 / 强调色推出来\n    class Pal\n    {\n        public Color Bg, Text, RowBg, AddBg, BtnBg, BtnHover, Line, Border, Muted, Accent, AccentText, DarkOnAccent, Danger;\n        public Color[] G;\n        public double Fs = 1;\n        public bool Light;\n        public string Sig = \"\";\n\n        public static Color C(string h)\n        {\n            if (h == null || !Regex.IsMatch(h, \"^#[0-9a-fA-F]{6}$\")) return Colors.Transparent;\n            return Color.FromRgb(Convert.ToByte(h.Substring(1, 2), 16), Convert.ToByte(h.Substring(3, 2), 16), Convert.ToByte(h.Substring(5, 2), 16));\n        }\n        static bool Ok(string h) { return h != null && Regex.IsMatch(h, \"^#[0-9a-fA-F]{6}$\"); }\n        public static Color Mix(Color a, Color b, double t)\n        {\n            return Color.FromRgb((byte)Math.Round(a.R + (b.R - a.R) * t), (byte)Math.Round(a.G + (b.G - a.G) * t), (byte)Math.Round(a.B + (b.B - a.B) * t));\n        }\n        public static Color WithA(Color c, byte a) { return Color.FromArgb(a, c.R, c.G, c.B); }\n        static double Cl(double v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }\n        public static Color Shift(Color c, double dh, double dl, double ds)\n        {\n            double r = c.R / 255.0, g = c.G / 255.0, b = c.B / 255.0;\n            double max = Math.Max(r, Math.Max(g, b)), min = Math.Min(r, Math.Min(g, b));\n            double l = (max + min) / 2, h = 0, s = 0;\n            if (max != min)\n            {\n                double d = max - min;\n                s = l > 0.5 ? d / (2 - max - min) : d / (max + min);\n                if (max == r) h = (g - b) / d + (g < b ? 6 : 0); else if (max == g) h = (b - r) / d + 2; else h = (r - g) / d + 4;\n                h *= 60;\n            }\n            h = (((h + dh) % 360) + 360) % 360; s = Cl(s + ds); l = Cl(l + dl);\n            double cc = (1 - Math.Abs(2 * l - 1)) * s, x = cc * (1 - Math.Abs(h / 60 % 2 - 1)), m = l - cc / 2;\n            double rr = 0, gg = 0, bb = 0;\n            if (h < 60) { rr = cc; gg = x; } else if (h < 120) { rr = x; gg = cc; } else if (h < 180) { gg = cc; bb = x; }\n            else if (h < 240) { gg = x; bb = cc; } else if (h < 300) { rr = x; bb = cc; } else { rr = cc; bb = x; }\n            return Color.FromRgb((byte)Math.Round((rr + m) * 255), (byte)Math.Round((gg + m) * 255), (byte)Math.Round((bb + m) * 255));\n        }\n\n        static readonly Dictionary<string, string[]> Accents = new Dictionary<string, string[]>\n        {\n            { \"amber\", new[] { \"#ffd66b\", \"#f6b04a\", \"#ee8a3a\" } }, { \"sunset\", new[] { \"#ffb36b\", \"#ff8b74\", \"#f2678f\" } },\n            { \"sakura\", new[] { \"#ffc0d4\", \"#f497c0\", \"#cf8ae6\" } }, { \"neon\", new[] { \"#f27bff\", \"#a97cff\", \"#6d8dff\" } },\n            { \"aurora\", new[] { \"#5ff0c6\", \"#44c6f2\", \"#6f8cff\" } }, { \"glacier\", new[] { \"#a3e9ff\", \"#84b9ff\", \"#a99cff\" } },\n            { \"mint\", new[] { \"#c6f27c\", \"#6ee7a8\", \"#38c9c1\" } },\n        };\n\n        public static Pal Load(string dataDir)\n        {\n            string cBg = \"#1b1c1f\", cText = \"#e8e9ec\", cDone = \"#f2c14e\", accent = \"solo\", img = null; double fs = 1;\n            try\n            {\n                var pf = dataDir == null ? null : System.IO.Path.Combine(dataDir, \"plan_data.json\");\n                if (pf != null && File.Exists(pf))\n                {\n                    var js = new System.Web.Script.Serialization.JavaScriptSerializer { MaxJsonLength = int.MaxValue };\n                    var o = js.DeserializeObject(File.ReadAllText(pf, Encoding.UTF8)) as Dictionary<string, object>;\n                    if (o != null)\n                    {\n                        object x;\n                        if (o.TryGetValue(\"c_bg\", out x) && Ok(x as string)) cBg = (string)x;\n                        if (o.TryGetValue(\"c_text\", out x) && Ok(x as string)) cText = (string)x;\n                        if (o.TryGetValue(\"c_done\", out x) && Ok(x as string)) cDone = (string)x;\n                        if (o.TryGetValue(\"accent\", out x) && x is string) accent = (string)x;\n                        if (o.TryGetValue(\"img_accent\", out x) && Ok(x as string)) img = (string)x;\n                        if (o.TryGetValue(\"font_scale\", out x) && x != null) fs = Convert.ToDouble(x, CultureInfo.InvariantCulture);\n                    }\n                }\n            }\n            catch { }\n            var p = new Pal();\n            p.Sig = cBg + cText + cDone + accent + img + fs.ToString(CultureInfo.InvariantCulture);\n            p.Fs = Math.Max(0.8, Math.Min(1.6, fs));\n            Color bg = C(cBg), tx = C(cText);\n            p.Bg = bg; p.Text = tx;\n            p.RowBg = Mix(bg, tx, 0.055); p.AddBg = Mix(bg, tx, 0.07); p.BtnBg = Mix(bg, tx, 0.08); p.BtnHover = Mix(bg, tx, 0.13);\n            p.Line = Mix(bg, tx, 0.14); p.Border = Mix(bg, tx, 0.22); p.Muted = Mix(bg, tx, 0.55);\n            bool light = (0.299 * bg.R + 0.587 * bg.G + 0.114 * bg.B) / 255.0 > 0.6;\n            p.Light = light;\n            Color solo = C(cDone);\n            if (accent == \"image\" && img != null) { solo = C(img); accent = \"solo\"; }\n            string[] cols;\n            if (Accents.TryGetValue(accent, out cols)) p.G = cols.Select(C).ToArray();\n            else p.G = new[] { Shift(solo, -10, 0.05, 0), solo, Shift(solo, 10, -0.06, 0) };\n            if (light) p.G = p.G.Select(c => Shift(c, 0, -0.13, 0.03)).ToArray();\n            p.Accent = p.G[p.G.Length / 2];\n            p.AccentText = light ? Mix(p.Accent, Colors.Black, 0.35) : Mix(p.Accent, Colors.White, 0.08);\n            p.DarkOnAccent = C(\"#1b1c1f\");\n            p.Danger = light ? C(\"#b0473c\") : C(\"#e07a6e\");\n            return p;\n        }\n\n        public LinearGradientBrush Grad()\n        {\n            var b = new LinearGradientBrush { StartPoint = new Point(0, 0.5), EndPoint = new Point(1, 0.5) };\n            for (int i = 0; i < G.Length; i++) b.GradientStops.Add(new GradientStop(G[i], G.Length == 1 ? 0 : (double)i / (G.Length - 1)));\n            b.Freeze();\n            return b;\n        }\n    }\n\n    // ================================================================ 程序入口：只开一个；再点插件就把窗口叫出来\n    public static class Program\n    {\n        [STAThread]\n        public static void Main(string[] args)\n        {\n            string evName = args.Length > 0 ? args[0] : \"Local\\\\mbout_calc_dev\";\n            bool created;\n            var ev = new EventWaitHandle(false, EventResetMode.AutoReset, evName, out created);\n            if (!created) { ev.Set(); return; }\n            string dir = args.Length > 1 ? args[1] : AppDomain.CurrentDomain.BaseDirectory;\n            var app = new Application { ShutdownMode = ShutdownMode.OnExplicitShutdown };\n            // 出错写进 calc_error.log（数据目录\\插件数据\\计算器），方便查\n            app.DispatcherUnhandledException += (s, e) =>\n            {\n                try { File.AppendAllText(System.IO.Path.Combine(dir, \"calc_error.log\"), DateTime.Now.ToString(\"yyyy-MM-dd HH:mm:ss\") + \"  \" + e.Exception + \"\\r\\n\\r\\n\", Encoding.UTF8); } catch { }\n            };\n            var w = new CalcWindow(dir);\n            var t = new Thread(() =>\n            {\n                while (true)\n                {\n                    ev.WaitOne();\n                    app.Dispatcher.BeginInvoke(new Action(w.ShowFront));\n                }\n            }) { IsBackground = true };\n            t.Start();\n            app.Startup += (s, e) => w.ShowFront();\n            app.Run();\n        }\n    }\n\n    // ================================================================ 窗口\n    partial class CalcWindow : Window\n    {\n        const double PadOut = 14;\n        readonly string _dir, _initFile, _cfgFile, _textFile;\n        Pal P;\n        readonly Grid _host = new Grid();\n        readonly ScaleTransform _sc = new ScaleTransform(0.97, 0.97);\n        Border _shell, _pin, _kbBtn, _keypadHost, _totalBox, _editBox;\n        TextBox _tb;\n        Canvas _res, _bar;\n        ScrollViewer _sv;\n        ColumnDefinition _resCol;\n        TextBlock _status, _totalTxt, _totalLabel, _totalSub, _copyTxt, _copyAllTxt, _placeholder;\n        SolidColorBrush _pinFg, _kbFg;\n        bool _pinned, _keypad = true, _hiding, _placed, _building;\n        int _dec = -1;\n        Sheet _sheet = new Sheet();\n        int _flashLine = -1;\n        string _totalStr = \"\";\n        readonly DispatcherTimer _flash = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(1100) };\n        readonly DispatcherTimer _lineFlash = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(900) };\n        readonly DispatcherTimer _idle = new DispatcherTimer { Interval = TimeSpan.FromMinutes(3) };\n        readonly DispatcherTimer _save = new DispatcherTimer { Interval = TimeSpan.FromSeconds(2) };\n        static ControlTemplate _tbTemplate, _tipTemplate;\n        string _savedText = \"\";\n\n        public CalcWindow(string dir)\n        {\n            _dir = dir;\n            _initFile = System.IO.Path.Combine(dir, \"calc_init.txt\");\n            _cfgFile = System.IO.Path.Combine(dir, \"calc.json\");\n            _textFile = System.IO.Path.Combine(dir, \"calc_text.txt\");\n            Title = \"计算器\";\n            WindowStyle = WindowStyle.None; AllowsTransparency = true; Background = Brushes.Transparent;\n            ResizeMode = ResizeMode.NoResize; SizeToContent = SizeToContent.WidthAndHeight; UseLayoutRounding = true; ShowInTaskbar = true;\n            FontFamily = new FontFamily(\"Microsoft YaHei UI\");\n            // 字：平滑排版 + ClearType（透明窗口默认只能灰度，小字发颗粒；外壳上开 ClearTypeHint 才能用 ClearType）\n            TextOptions.SetTextFormattingMode(this, TextFormattingMode.Ideal);\n            TextOptions.SetTextRenderingMode(this, TextRenderingMode.ClearType);\n            WindowStartupLocation = WindowStartupLocation.CenterScreen;\n            _host.RenderTransform = _sc; _host.RenderTransformOrigin = new Point(0.5, 0.3); _host.Opacity = 0;\n            Content = _host;\n            LoadCfg();\n            // 读算稿；主文件坏了 / 没了就用上次的备份 .bak\n            _savedText = ReadSaved(_textFile);\n            _flash.Tick += (s, e) =>\n            {\n                _flash.Stop();\n                if (_copyTxt != null) _copyTxt.Text = \"复制合计\";\n                if (_copyAllTxt != null) _copyAllTxt.Text = \"复制算稿\";\n                if (_copyFTxt != null) _copyFTxt.Text = \"复制 Excel 公式\";\n                Recalc();\n            };\n            _lineFlash.Tick += (s, e) => { _lineFlash.Stop(); _flashLine = -1; Recalc(); };\n            // 藏着时不退出（再点马上出来，不用重新冷启动），只把内存还给系统；插件更新后（目录里有了别的版本的 exe）旧的才退\n            _idle.Tick += (s, e) =>\n            {\n                if (IsVisible) { _idle.Stop(); return; }\n                if (NewerVersion()) { _idle.Stop(); SaveText(); Environment.Exit(0); }\n                TrimMemory();\n            };\n            _save.Tick += (s, e) => { _save.Stop(); SaveText(); };\n            PreviewKeyDown += OnKey;\n            Closing += (s, e) => { e.Cancel = true; CloseSymMenu(); HideSoft(); };\n            // 「统一符号」菜单：点窗口别处、切到别的程序、挪窗口都收起（点那个按钮本身由按钮自己开关）\n            PreviewMouseDown += (s, e) => { if (SymOpen && (_sym == null || !_sym.IsMouseOver)) CloseSymMenu(); };\n            Deactivated += (s, e) => CloseSymMenu();\n            LocationChanged += (s, e) => CloseSymMenu();\n        }\n\n        // ---------------------------------------------------------------- 打开 / 藏起\n        public void ShowFront()\n        {\n            string init = TakeInit();\n            var np = Pal.Load(ReadDataDir());\n            if (P == null || np.Sig != P.Sig) { P = np; Build(); }\n            _idle.Stop();\n            if (!IsVisible || _hiding)\n            {\n                _hiding = false;\n                if (!_placed) { Place(); _placed = true; }\n                Show();\n                _host.BeginAnimation(OpacityProperty, null); _host.Opacity = 0; _sc.ScaleX = _sc.ScaleY = 0.97;\n                Ease(_host, OpacityProperty, 1, 140, null);\n                Ease(_sc, ScaleTransform.ScaleXProperty, 1, 170, null);\n                Ease(_sc, ScaleTransform.ScaleYProperty, 1, 170, null);\n            }\n            if (WindowState == WindowState.Minimized) WindowState = WindowState.Normal;\n            Topmost = true; if (!_pinned) Topmost = false;\n            Activate();\n            FocusEditor();\n            if (init.Length > 0) AppendInit(init);\n            else _tb.CaretIndex = _tb.Text.Length;\n            Dispatcher.BeginInvoke(new Action(ScrollToCaret), DispatcherPriority.Loaded);\n        }\n\n        void HideSoft()\n        {\n            if (_hiding || !IsVisible) return;\n            _hiding = true;\n            SaveCfg(); SaveText();\n            Ease(_sc, ScaleTransform.ScaleXProperty, 0.98, 110, null);\n            Ease(_sc, ScaleTransform.ScaleYProperty, 0.98, 110, null);\n            Ease(_host, OpacityProperty, 0, 110, (s, e) => { if (_hiding) { Hide(); _idle.Start(); } });\n        }\n\n        void Place()\n        {\n            if (_cfgLeft.HasValue && _cfgTop.HasValue)\n            {\n                double l = _cfgLeft.Value, t = _cfgTop.Value;\n                if (l >= SystemParameters.VirtualScreenLeft - PadOut && l < SystemParameters.VirtualScreenLeft + SystemParameters.VirtualScreenWidth - 120 &&\n                    t >= SystemParameters.VirtualScreenTop - PadOut && t < SystemParameters.VirtualScreenTop + SystemParameters.VirtualScreenHeight - 160)\n                { WindowStartupLocation = WindowStartupLocation.Manual; Left = l; Top = t; }\n            }\n        }\n\n        string TakeInit()\n        {\n            try { if (File.Exists(_initFile)) { var t = File.ReadAllText(_initFile, Encoding.UTF8); File.Delete(_initFile); return t.Trim(); } } catch { }\n            return \"\";\n        }\n        string ReadDataDir()\n        {\n            try { var f = System.IO.Path.Combine(_dir, \"calc_datadir.txt\"); if (File.Exists(f)) return File.ReadAllText(f, Encoding.UTF8).Trim(); } catch { }\n            return null;\n        }\n\n        // 选中的文字：另起一段接在算稿后面（前面的不动，合计只算新的这段）\n        void AppendInit(string s)\n        {\n            s = s.Replace(\"\\r\\n\", \"\\n\").Replace('\\r', '\\n');\n            var lines = s.Split('\\n').Select(x => x.TrimEnd()).ToList();\n            // 像是从 Excel 复制来的一列数：中间的空格子不能把它拆成两段\n            if (LooksLikeColumn(lines)) lines = lines.Where(x => x.Trim().Length > 0).ToList();\n            while (lines.Count > 0 && lines[0].Trim().Length == 0) lines.RemoveAt(0);\n            while (lines.Count > 0 && lines[lines.Count - 1].Trim().Length == 0) lines.RemoveAt(lines.Count - 1);\n            if (lines.Count == 0) return;\n            if (lines.Count > 3000) lines = lines.Take(3000).ToList();\n            string add = string.Join(\"\\r\\n\", lines);\n            string cur = _tb.Text;\n            string trimmed = cur.TrimEnd('\\r', '\\n', ' ', '\\t');\n            int at = cur.Length;\n            if (trimmed.Length > 0)\n            {\n                // 算稿最后一行是空着的就直接写进去，否则空一行另起一段\n                _tb.Select(trimmed.Length, cur.Length - trimmed.Length);\n                _tb.SelectedText = \"\\r\\n\\r\\n\" + add;\n            }\n            else\n            {\n                _tb.Select(0, cur.Length);\n                _tb.SelectedText = add;\n            }\n            _tb.Select(_tb.Text.Length, 0);\n        }\n\n        // ---------------------------------------------------------------- 设置\n        double? _cfgLeft, _cfgTop;\n        void LoadCfg()\n        {\n            try\n            {\n                if (!File.Exists(_cfgFile)) return;\n                var o = new System.Web.Script.Serialization.JavaScriptSerializer().DeserializeObject(File.ReadAllText(_cfgFile, Encoding.UTF8)) as Dictionary<string, object>;\n                if (o == null) return;\n                object x;\n                if (o.TryGetValue(\"top\", out x) && x is bool) _pinned = (bool)x;\n                if (o.TryGetValue(\"keypad\", out x) && x is bool) _keypad = (bool)x;\n                if (o.TryGetValue(\"dec\", out x) && x != null) _dec = Math.Max(-1, Math.Min(6, Convert.ToInt32(x, CultureInfo.InvariantCulture)));\n                if (o.TryGetValue(\"left\", out x) && x != null) _cfgLeft = Convert.ToDouble(x, CultureInfo.InvariantCulture);\n                if (o.TryGetValue(\"topPos\", out x) && x != null) _cfgTop = Convert.ToDouble(x, CultureInfo.InvariantCulture);\n                if (o.TryGetValue(\"w\", out x) && x != null) _cw = Math.Max(MinW, Math.Min(MaxW, Convert.ToDouble(x, CultureInfo.InvariantCulture)));\n                if (o.TryGetValue(\"edh\", out x) && x != null) _eh = Math.Max(0, Math.Min(1400, Convert.ToDouble(x, CultureInfo.InvariantCulture)));\n                if (o.TryGetValue(\"perline\", out x) && x is bool) _perLine = (bool)x;\n            }\n            catch { }\n        }\n        void SaveCfg()\n        {\n            try\n            {\n                var ci = CultureInfo.InvariantCulture;\n                AtomicWrite(_cfgFile, \"{ \\\"top\\\": \" + (_pinned ? \"true\" : \"false\") + \", \\\"keypad\\\": \" + (_keypad ? \"true\" : \"false\") + \", \\\"dec\\\": \" + _dec.ToString(ci) +\n                    \", \\\"left\\\": \" + Left.ToString(\"0.##\", ci) + \", \\\"topPos\\\": \" + Top.ToString(\"0.##\", ci) + \", \\\"w\\\": \" + _cw.ToString(\"0.##\", ci) + \", \\\"edh\\\": \" + _eh.ToString(\"0.##\", ci) +\n                    \", \\\"perline\\\": \" + (_perLine ? \"true\" : \"false\") + \" }\", false);\n            }\n            catch { }\n        }\n        // 先写临时文件再替换，旧的留一份 .bak：写到一半断电也不会把算稿弄丢\n        static void AtomicWrite(string path, string text, bool backup)\n        {\n            string tmp = path + \".tmp\";\n            File.WriteAllText(tmp, text, new UTF8Encoding(false));\n            if (File.Exists(path))\n            {\n                if (backup) File.Replace(tmp, path, path + \".bak\", true);\n                else { File.Delete(path); File.Move(tmp, path); }\n            }\n            else File.Move(tmp, path);\n        }\n        void SaveText()\n        {\n            if (_tb == null) return;\n            try { if (_tb.Text != _savedText) { AtomicWrite(_textFile, _tb.Text, true); _savedText = _tb.Text; _saveFailed = false; } }\n            catch (Exception ex)\n            {\n                // 存不进去：内存里的算稿不动，明着告诉用户（下次改动还会再试）\n                if (!_saveFailed && _status != null) { _status.Text = \"算稿保存失败：\" + ex.Message + \"（内容还在窗口里，先别关电脑）\"; _status.Foreground = B(P.Danger); }\n                _saveFailed = true;\n            }\n        }\n        bool _saveFailed;\n\n        // 读存下来的文字：主文件读不了 / 没有就用 .bak\n        static string ReadSaved(string path)\n        {\n            try { if (File.Exists(path)) return File.ReadAllText(path, Encoding.UTF8); } catch { }\n            try { if (File.Exists(path + \".bak\")) return File.ReadAllText(path + \".bak\", Encoding.UTF8); } catch { }\n            return \"\";\n        }\n\n        // ---------------------------------------------------------------- 小工具\n        static SolidColorBrush B(Color c) { return new SolidColorBrush(c); }\n        static void EaseColor(SolidColorBrush b, Color to, double ms)\n        {\n            b.BeginAnimation(SolidColorBrush.ColorProperty, new ColorAnimation(to, TimeSpan.FromMilliseconds(ms)) { EasingFunction = new QuadraticEase { EasingMode = EasingMode.EaseOut } });\n        }\n        static void Ease(IAnimatable o, DependencyProperty dp, double to, double ms, EventHandler done)\n        {\n            var a = new DoubleAnimation(to, TimeSpan.FromMilliseconds(ms)) { EasingFunction = new CubicEase { EasingMode = EasingMode.EaseOut } };\n            if (done != null) a.Completed += done;\n            o.BeginAnimation(dp, a);\n        }\n        TextBlock Txt(string t, double size, Color c, bool bold)\n        {\n            return new TextBlock { Text = t, FontSize = size, Foreground = B(c), TextWrapping = TextWrapping.Wrap, FontWeight = bold ? FontWeights.SemiBold : FontWeights.Normal };\n        }\n        static System.Windows.Shapes.Path Glyph(string data, double size, Brush fill)\n        {\n            return new System.Windows.Shapes.Path { Data = Geometry.Parse(data), Fill = fill, Stretch = Stretch.Uniform, Width = size, Height = size, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center };\n        }\n        static void OnClick(UIElement e, Action act)\n        {\n            bool down = false;\n            e.MouseLeftButtonDown += (s, a) => { down = true; a.Handled = true; };\n            e.MouseLeave += (s, a) => down = false;\n            e.MouseLeftButtonUp += (s, a) => { if (down) { down = false; a.Handled = true; act(); } };\n        }\n\n        // 提示框：圆角深色卡片，跟主题一致（不用系统的灰框）\n        void Tip(FrameworkElement e, string text)\n        {\n            if (_tipTemplate == null)\n            {\n                var t = new ControlTemplate(typeof(ToolTip));\n                var b = new FrameworkElementFactory(typeof(Border));\n                b.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));\n                b.SetValue(Border.BorderBrushProperty, new TemplateBindingExtension(Control.BorderBrushProperty));\n                b.SetValue(Border.BorderThicknessProperty, new Thickness(1));\n                b.SetValue(Border.CornerRadiusProperty, new CornerRadius(8));\n                b.SetValue(Border.PaddingProperty, new Thickness(9, 5, 9, 6));\n                b.SetValue(FrameworkElement.MarginProperty, new Thickness(0, 4, 0, 0));\n                b.SetValue(RenderOptions.ClearTypeHintProperty, ClearTypeHint.Enabled);\n                var cp = new FrameworkElementFactory(typeof(ContentPresenter));\n                b.AppendChild(cp);\n                t.VisualTree = b;\n                t.Seal();\n                _tipTemplate = t;\n            }\n            var tip = new ToolTip\n            {\n                Template = _tipTemplate, Content = new TextBlock { Text = text, FontSize = 11 * P.Fs, Foreground = B(P.Text), MaxWidth = 260, TextWrapping = TextWrapping.Wrap },\n                Background = B(P.Light ? Pal.Mix(P.Bg, Colors.White, 0.6) : Pal.Mix(P.Bg, P.Text, 0.1)), BorderBrush = B(P.Border), HasDropShadow = false,\n                Placement = System.Windows.Controls.Primitives.PlacementMode.Custom,\n            };\n            TextOptions.SetTextFormattingMode(tip, TextFormattingMode.Ideal);\n            TextOptions.SetTextRenderingMode(tip, TextRenderingMode.ClearType);\n            // 出在下面；东西在窗口右半边就和它右边对齐（往左展开），不挡左边的内容、也不伸出窗口\n            tip.CustomPopupPlacementCallback = (popupSize, targetSize, offset) =>\n            {\n                double x = 0;\n                try\n                {\n                    // 看鼠标在窗口哪半边（合计框这种占满一行的也能分出来）\n                    if (Mouse.GetPosition(this).X > ActualWidth / 2) x = targetSize.Width - popupSize.Width;\n                }\n                catch { }\n                return new[] { new System.Windows.Controls.Primitives.CustomPopupPlacement(new Point(x, targetSize.Height), System.Windows.Controls.Primitives.PopupPrimaryAxis.Horizontal) };\n            };\n            TextOptions.SetTextFormattingMode(tip, TextFormattingMode.Display);\n            e.ToolTip = tip;\n            ToolTipService.SetInitialShowDelay(e, 600);\n        }\n\n        ControlTemplate TbTemplate()\n        {\n            if (_tbTemplate == null)\n            {\n                var t = new ControlTemplate(typeof(TextBox));\n                var b = new FrameworkElementFactory(typeof(Border), \"border\");\n                b.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));\n                b.SetValue(Border.BorderBrushProperty, new TemplateBindingExtension(Control.BorderBrushProperty));\n                b.SetValue(Border.BorderThicknessProperty, new TemplateBindingExtension(Control.BorderThicknessProperty));\n                b.SetValue(UIElement.SnapsToDevicePixelsProperty, true);\n                var sv = new FrameworkElementFactory(typeof(ScrollViewer), \"PART_ContentHost\");\n                sv.SetValue(UIElement.FocusableProperty, false);\n                sv.SetValue(ScrollViewer.HorizontalScrollBarVisibilityProperty, ScrollBarVisibility.Hidden);\n                sv.SetValue(ScrollViewer.VerticalScrollBarVisibilityProperty, ScrollBarVisibility.Hidden);\n                b.AppendChild(sv);\n                t.VisualTree = b;\n                t.Seal();\n                _tbTemplate = t;\n            }\n            return _tbTemplate;\n        }\n\n        Border Btn(string text, bool primary, out TextBlock label, Action act)\n        {\n            var t = Txt(text, 11 * P.Fs, primary ? P.DarkOnAccent : P.Text, false);\n            t.Margin = new Thickness(14, 5, 14, 6); t.HorizontalAlignment = HorizontalAlignment.Center; t.TextWrapping = TextWrapping.NoWrap;\n            label = t;\n            var b = new Border { CornerRadius = new CornerRadius(8), Cursor = Cursors.Hand, Margin = new Thickness(8, 0, 0, 0), VerticalAlignment = VerticalAlignment.Center };\n            if (primary)\n            {\n                b.Background = P.Grad();\n                var shine = new Border { CornerRadius = new CornerRadius(8), Background = Brushes.White, Opacity = 0 };\n                var g = new Grid(); g.Children.Add(shine); g.Children.Add(t); b.Child = g;\n                b.MouseEnter += (s, e) => Ease(shine, OpacityProperty, 0.08, 120, null);\n                b.MouseLeave += (s, e) => Ease(shine, OpacityProperty, 0, 260, null);\n            }\n            else\n            {\n                var bg = B(P.BtnBg); b.Background = bg; b.Child = t;\n                b.MouseEnter += (s, e) => EaseColor(bg, P.BtnHover, 70);\n                b.MouseLeave += (s, e) => EaseColor(bg, P.BtnBg, 260);\n            }\n            OnClick(b, act);\n            return b;\n        }\n\n        Border IconBtn(string data, string tip, Color fg, out SolidColorBrush fgBrush, Action act)\n        {\n            var bg = B(Pal.WithA(P.Text, 0));\n            fgBrush = B(fg);\n            double sz = Math.Round(26 * P.Fs);\n            var b = new Border { Width = sz, Height = sz, CornerRadius = new CornerRadius(7), Background = bg, Cursor = Cursors.Hand, Margin = new Thickness(2, 0, 0, 0) };\n            Tip(b, tip);\n            b.Child = Glyph(data, Math.Round(13 * P.Fs), fgBrush);\n            b.MouseEnter += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 22), 70);\n            b.MouseLeave += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 0), 260);\n            OnClick(b, act);\n            return b;\n        }\n\n        // 小数位：分段选择（自动 / 2 / 3 / 4）\n        FrameworkElement DecPicker()\n        {\n            var sp = new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };\n            var lab = Txt(\"小数\", 11 * P.Fs, P.Muted, false); lab.VerticalAlignment = VerticalAlignment.Center; lab.Margin = new Thickness(2, 0, 6, 0);\n            sp.Children.Add(lab);\n            var seg = new Border { Background = B(P.BtnBg), CornerRadius = new CornerRadius(8), Padding = new Thickness(2) };\n            var row = new StackPanel { Orientation = Orientation.Horizontal };\n            seg.Child = row;\n            int[] vals = { -1, 0, 2, 3, 4 };\n            string[] names = { \"自动\", \"0\", \"2\", \"3\", \"4\" };\n            var bgs = new List<SolidColorBrush>(); var fgs = new List<SolidColorBrush>();\n            for (int i = 0; i < vals.Length; i++)\n            {\n                int v = vals[i];\n                bool on = v == _dec;\n                var bg = B(on ? Pal.WithA(P.AccentText, 60) : Pal.WithA(P.Text, 0));\n                var fg = B(on ? P.Text : P.Muted);\n                bgs.Add(bg); fgs.Add(fg);\n                var t = new TextBlock { Text = names[i], FontSize = 11 * P.Fs, Foreground = fg, Margin = new Thickness(i == 0 ? 8 : 7, 2, i == 0 ? 8 : 7, 3), HorizontalAlignment = HorizontalAlignment.Center };\n                var cell = new Border { Background = bg, CornerRadius = new CornerRadius(6), Child = t, Cursor = Cursors.Hand, MinWidth = Math.Round(22 * P.Fs) };\n                Tip(cell, v < 0 ? \"自动：最多 10 位小数，去掉末尾的 0\" : (v == 0 ? \"四舍五入到整数\" : \"四舍五入保留 \" + v + \" 位小数（复制时也按这个）\"));\n                cell.MouseEnter += (s, e) => { if (_dec != v) EaseColor(bg, Pal.WithA(P.Text, 18), 70); };\n                cell.MouseLeave += (s, e) => { if (_dec != v) EaseColor(bg, Pal.WithA(P.Text, 0), 260); };\n                OnClick(cell, () =>\n                {\n                    _dec = v;\n                    for (int k = 0; k < vals.Length; k++)\n                    {\n                        EaseColor(bgs[k], vals[k] == v ? Pal.WithA(P.AccentText, 60) : Pal.WithA(P.Text, 0), 140);\n                        EaseColor(fgs[k], vals[k] == v ? P.Text : P.Muted, 140);\n                    }\n                    SaveCfg(); RefreshAll(); FocusEditor();\n                });\n                row.Children.Add(cell);\n            }\n            sp.Children.Add(seg);\n            return sp;\n        }\n\n        // ---------------------------------------------------------------- 图标\n        const string IcClose = \"M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z\";\n        const string IcPin = \"M16,9V4h1c0.55,0,1-0.45,1-1s-0.45-1-1-1H7C6.45,2,6,2.45,6,3s0.45,1,1,1h1v5c0,1.66-1.34,3-3,3v2h5.97v7l1,1l1-1v-7H19v-2C17.34,12,16,10.66,16,9z\";\n        const string IcCalc = \"M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M13 7.1L14.1 6L15.5 7.4L16.9 6L18 7.1L16.6 8.5L18 9.9L16.9 11L15.5 9.6L14.1 11L13 9.9L14.4 8.5L13 7.1M6.2 7.7H11.2V9.2H6.2V7.7M11.5 16H9.5V18H8V16H6V14.5H8V12.5H9.5V14.5H11.5V16M18 17.2H13V15.7H18V17.2M18 14.8H13V13.3H18V14.8Z\";\n        const string IcDialpad = \"M12,19A2,2 0 0,0 10,21A2,2 0 0,0 12,23A2,2 0 0,0 14,21A2,2 0 0,0 12,19M6,1A2,2 0 0,0 4,3A2,2 0 0,0 6,5A2,2 0 0,0 8,3A2,2 0 0,0 6,1M6,7A2,2 0 0,0 4,9A2,2 0 0,0 6,11A2,2 0 0,0 8,9A2,2 0 0,0 6,7M6,13A2,2 0 0,0 4,15A2,2 0 0,0 6,17A2,2 0 0,0 8,15A2,2 0 0,0 6,13M18,5A2,2 0 0,0 20,3A2,2 0 0,0 18,1A2,2 0 0,0 16,3A2,2 0 0,0 18,5M12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13M18,13A2,2 0 0,0 16,15A2,2 0 0,0 18,17A2,2 0 0,0 20,15A2,2 0 0,0 18,13M18,7A2,2 0 0,0 16,9A2,2 0 0,0 18,11A2,2 0 0,0 20,9A2,2 0 0,0 18,7M12,7A2,2 0 0,0 10,9A2,2 0 0,0 12,11A2,2 0 0,0 14,9A2,2 0 0,0 12,7M12,1A2,2 0 0,0 10,3A2,2 0 0,0 12,5A2,2 0 0,0 14,3A2,2 0 0,0 12,1Z\";\n        const string IcBroom = \"M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z\";\n        const string IcBack = \"M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59M22,3A2,2 0 0,1 24,5V19A2,2 0 0,1 22,21H7C6.31,21 5.77,20.64 5.41,20.11L0,12L5.41,3.88C5.77,3.35 6.31,3 7,3H22M22,5H7L2.28,12L7,19H22V5Z\";\n        const string IcReturn = \"M19,7V11H5.83L9.41,7.41L8,6L2,12L8,18L9.41,16.58L5.83,13H21V7H19Z\";\n\n        // ---------------------------------------------------------------- 界面\n        void Build()\n        {\n            _building = true;\n            string keep = _tb == null ? _savedText : _tb.Text;\n            double fs = P.Fs, small = 11 * fs;\n            _shell = new Border { Margin = new Thickness(PadOut), CornerRadius = new CornerRadius(14), Background = B(P.Bg), BorderBrush = B(P.Border), BorderThickness = new Thickness(1) };\n            RenderOptions.SetClearTypeHint(_shell, ClearTypeHint.Enabled);\n            // 阴影等窗口先画出来再补（第一次画阴影要 0.2 秒，别让它拖慢窗口出现）\n            _shell.SizeChanged += (s, e) => QueueShadow();\n            _shadowFor = Size.Empty;\n            _host.Children.Clear();\n            _host.Children.Add(_shell);\n            var sp = new StackPanel { Width = Math.Round(_cw * fs), Margin = new Thickness(16, 10, 16, 16) };\n            _sp = sp;\n            var sg = new Grid();\n            sg.Children.Add(sp);\n            sg.Children.Add(Grip());      // 右下角拖动：拉宽窗口、拉高算稿区\n            _shell.Child = sg;\n\n            // 标题栏\n            var head = new DockPanel { LastChildFill = true, Background = Brushes.Transparent };\n            SolidColorBrush tmp;\n            var close = IconBtn(IcClose, \"收起（Esc）\\n算稿会留着，下次打开还在\", P.Muted, out tmp, () => Close());\n            _pin = IconBtn(IcPin, _pinned ? \"取消置顶\" : \"置顶\", _pinned ? P.AccentText : P.Muted, out _pinFg, () =>\n            {\n                _pinned = !_pinned; Topmost = _pinned;\n                EaseColor(_pinFg, _pinned ? P.AccentText : P.Muted, 140);\n                Tip(_pin, _pinned ? \"取消置顶\" : \"置顶\");\n                SaveCfg();\n            });\n            var clear = IconBtn(IcBroom, \"清空算稿（Ctrl+L）\\n清错了按 Ctrl+Z 找回\", P.Muted, out tmp, ClearAll);\n            _kbBtn = IconBtn(IcDialpad, \"显示 / 隐藏按键\", _keypad ? P.AccentText : P.Muted, out _kbFg, () =>\n            {\n                _keypad = !_keypad;\n                EaseColor(_kbFg, _keypad ? P.AccentText : P.Muted, 140);\n                ShowKeypad(true);\n                SaveCfg(); _tb.Focus();\n            });\n            foreach (var b in new[] { close, _pin, clear, _kbBtn }) { DockPanel.SetDock(b, Dock.Right); head.Children.Add(b); }\n            var tsp = new StackPanel { Orientation = Orientation.Horizontal, VerticalAlignment = VerticalAlignment.Center };\n            var tIcon = Glyph(IcCalc, Math.Round(14 * fs), B(P.AccentText)); tIcon.Margin = new Thickness(0, 0, 7, 0);\n            var title = Txt(\"计算器\", 12 * fs, P.Text, true); title.VerticalAlignment = VerticalAlignment.Center;\n            tsp.Children.Add(tIcon); tsp.Children.Add(title);\n            head.Children.Add(tsp);\n            head.MouseLeftButtonDown += (s, e) => { if (e.OriginalSource == head || e.OriginalSource == title || e.OriginalSource == tsp) { try { DragMove(); } catch { } } };\n            sp.Children.Add(head);\n\n            // 算稿：左边打字，右边出结果\n            double efs = 15 * fs;\n            var mono = new FontFamily(\"Segoe UI, Microsoft YaHei UI\");\n            _tb = new TextBox\n            {\n                Template = TbTemplate(), FocusVisualStyle = null, FontSize = efs, FontFamily = mono, Foreground = B(P.Text), Background = Brushes.Transparent,\n                BorderThickness = new Thickness(0), CaretBrush = B(P.AccentText), SelectionBrush = B(P.AccentText),\n                AcceptsReturn = true, AcceptsTab = false, TextWrapping = TextWrapping.Wrap, Padding = new Thickness(10, 8, 4, 8),\n                VerticalAlignment = VerticalAlignment.Top,\n            };\n            Typography.SetNumeralAlignment(_tb, FontNumeralAlignment.Tabular);\n            InputMethod.SetPreferredImeState(_tb, InputMethodState.Off);\n            InputMethod.SetPreferredImeConversionMode(_tb, ImeConversionModeValues.Alphanumeric);\n            double lineH = Math.Ceiling(efs * mono.LineSpacing);\n            _tb.MinHeight = lineH * 5 + 16;\n            _tb.TextChanged += (s, e) => { if (_building) return; Recalc(); _save.Stop(); _save.Start(); };\n            _tb.SelectionChanged += (s, e) => { if (_building) return; UpdateStatus(); UpdateTotal(); DrawBar(); ScrollToCaret(); };\n            _tb.PreviewMouseWheel += (s, e) => { e.Handled = true; _sv.ScrollToVerticalOffset(_sv.VerticalOffset - e.Delta / 3.0); };\n            _tb.PreviewTextInput += (s, e) =>\n            {\n                // 中文输入法没关时打出来的符号也照样认（这里不改字，算的时候认）；Tab 键不插字\n                if (e.Text == \"\\t\") e.Handled = true;\n            };\n            DataObject.AddPastingHandler(_tb, OnPaste);\n\n            _placeholder = new TextBlock\n            {\n                Text = \"每行一笔，结果在右边，例如：\\n3.6×2.8×2\\n外墙：(12.5+8.3)×2×3\\n1000×1.09，下一行打 ×0.9 接着算\\n粘贴 Excel 一列 → 下面直接合计\",\n                FontSize = 12.5 * fs, Foreground = B(P.Muted), Opacity = 0.75, Margin = new Thickness(11, 9, 0, 0), IsHitTestVisible = false, LineHeight = 21 * fs,\n            };\n            _res = new Canvas { ClipToBounds = false, Background = Brushes.Transparent };\n            _bar = new Canvas { IsHitTestVisible = false };\n            var eg = new Grid();\n            eg.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });\n            _resCol = new ColumnDefinition { Width = new GridLength(Math.Round(80 * fs)) };\n            eg.ColumnDefinitions.Add(_resCol);\n            eg.Children.Add(_tb); eg.Children.Add(_placeholder); eg.Children.Add(_bar);\n            Grid.SetColumn(_res, 1); eg.Children.Add(_res);\n            // 结果那一栏左边一条淡淡的分隔线\n            var div = new Border { Width = 1, Background = B(Pal.WithA(P.Text, 18)), HorizontalAlignment = HorizontalAlignment.Left, Margin = new Thickness(0, 8, 0, 8) };\n            Grid.SetColumn(div, 1); eg.Children.Add(div);\n            _lineH = lineH;\n            _sv = new ScrollViewer { Content = eg, VerticalScrollBarVisibility = ScrollBarVisibility.Hidden, HorizontalScrollBarVisibility = ScrollBarVisibility.Disabled, MaxHeight = lineH * 11 + 16, Focusable = false };\n            _editBox = new Border { Background = B(P.AddBg), BorderBrush = B(P.Line), BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(10), Margin = new Thickness(0, 10, 0, 0), Child = _sv, Cursor = Cursors.IBeam };\n            _editBox.MouseLeftButtonDown += (s, e) => { if (!_tb.IsKeyboardFocusWithin) { _tb.Focus(); _tb.CaretIndex = _tb.Text.Length; } };\n            var lineB = _editBox.BorderBrush as SolidColorBrush;\n            _tb.GotKeyboardFocus += (s, e) => EaseColor(lineB, Pal.WithA(P.AccentText, 200), 120);\n            _tb.LostKeyboardFocus += (s, e) => EaseColor(lineB, P.Line, 200);\n            sp.Children.Add(_editBox);\n            ApplyEditorHeight();\n\n            // 提示行：左边提示 / 出错原因，右边「合并成一行」\n            var srow = new DockPanel { LastChildFill = true, Margin = new Thickness(0, 6, 0, 0) };\n            _merge = MergeChip();\n            DockPanel.SetDock(_merge, Dock.Right);\n            srow.Children.Add(_merge);\n            _sym = SymChip();\n            DockPanel.SetDock(_sym, Dock.Right);\n            srow.Children.Add(_sym);\n            _status = Txt(\"\", small, P.Muted, false);\n            _status.Margin = new Thickness(3, 1, 8, 0); _status.MinHeight = Math.Round(small * 1.4);\n            srow.Children.Add(_status);\n            sp.Children.Add(srow);\n\n            // 合计\n            _totalBox = new Border { Background = B(P.RowBg), CornerRadius = new CornerRadius(10), Padding = new Thickness(12, 8, 12, 9), Margin = new Thickness(0, 8, 0, 0), Cursor = Cursors.Hand };\n            var td = new DockPanel { LastChildFill = true };\n            var tl = new StackPanel { VerticalAlignment = VerticalAlignment.Center };\n            _totalLabel = Txt(\"合计\", small, P.Muted, false);\n            _totalSub = Txt(\"\", 10.5 * fs, P.Muted, false); _totalSub.Opacity = 0.85;\n            tl.Children.Add(_totalLabel); tl.Children.Add(_totalSub);\n            DockPanel.SetDock(tl, Dock.Left);\n            td.Children.Add(tl);\n            _totalTxt = new TextBlock { FontSize = 24 * fs, FontWeight = FontWeights.SemiBold, Foreground = B(P.Text), FontFamily = mono, HorizontalAlignment = HorizontalAlignment.Right, VerticalAlignment = VerticalAlignment.Center, TextTrimming = TextTrimming.CharacterEllipsis, Margin = new Thickness(12, 0, 0, 0) };\n            Typography.SetNumeralAlignment(_totalTxt, FontNumeralAlignment.Tabular);\n            td.Children.Add(_totalTxt);\n            _totalBox.Child = td;\n            var tbg = (SolidColorBrush)_totalBox.Background;\n            _totalBox.MouseEnter += (s, e) => EaseColor(tbg, Pal.Mix(P.Bg, P.Text, 0.09), 70);\n            _totalBox.MouseLeave += (s, e) => EaseColor(tbg, P.RowBg, 260);\n            Tip(_totalBox, \"点一下复制合计（Ctrl+Shift+C）\");\n            OnClick(_totalBox, CopyTotal);\n            sp.Children.Add(_totalBox);\n\n            // 底部第一行：小数位 + 逐笔舍入\n            var opt = new DockPanel { LastChildFill = false, Margin = new Thickness(0, 12, 0, 0) };\n            var dp = DecPicker(); DockPanel.SetDock(dp, Dock.Left); opt.Children.Add(dp);\n            _perChip = Chip(\"逐笔舍入\", () => _perLine, v => { _perLine = v; SaveCfg(); RefreshAll(); });\n            _perChip.Margin = new Thickness(8, 0, 0, 0);\n            Tip(_perChip, \"开：每一笔先按选的小数位四舍五入，再相加（和结算表逐项取整对得上）\\n关：原值相加，最后再四舍五入\\n小数选「自动」时不起作用\");\n            DockPanel.SetDock(_perChip, Dock.Left); opt.Children.Add(_perChip);\n            sp.Children.Add(opt);\n            // 底部第二行：复制 Excel 公式  复制算稿  复制合计\n            var foot = new StackPanel { Orientation = Orientation.Horizontal, HorizontalAlignment = HorizontalAlignment.Right, Margin = new Thickness(0, 10, 0, 0) };\n            var copyAll = Btn(\"复制算稿\", false, out _copyAllTxt, CopySheet);\n            Tip(copyAll, \"把这一段每一行（含小标题、备注）的算式和结果\\n连同合计一起复制，可以直接贴进计算书\");\n            var copyF = Btn(\"复制 Excel 公式\", false, out _copyFTxt, CopyFormula);\n            Tip(copyF, \"把这一段合成一条带 = 的公式复制，在 Excel 单元格里直接粘贴就出数\\n开着逐笔舍入时每一笔套 ROUND，和这里的合计一致\");\n            var copy = Btn(\"复制合计\", true, out _copyTxt, CopyTotal);\n            foot.Children.Add(copyF); foot.Children.Add(copyAll); foot.Children.Add(copy);\n            sp.Children.Add(foot);\n\n            // 按键\n            _keypadHost = new Border { Margin = new Thickness(0, 12, 0, 0), Child = Keypad(), ClipToBounds = true };\n            sp.Children.Add(_keypadHost);\n            ShowKeypad(false);\n\n            // 窗口图标（任务栏 / Alt+Tab）\n            var ib = new Border { Width = 32, Height = 32, CornerRadius = new CornerRadius(8), Background = P.Grad(), Child = Glyph(IcCalc, 20, B(P.DarkOnAccent)) };\n            ib.Measure(new Size(32, 32)); ib.Arrange(new Rect(0, 0, 32, 32));\n            var ico = new RenderTargetBitmap(32, 32, 96, 96, PixelFormats.Pbgra32); ico.Render(ib); ico.Freeze();\n            Icon = ico;\n\n            Topmost = _pinned;\n            _tb.Text = keep ?? \"\";\n            _building = false;\n            Recalc();\n        }\n\n        // 「合并成一行」小按钮：淡底描边，悬停加深\n        Border _merge;\n        const string IcMerge = \"M2 7V9H7V7H2M12 9V11H9V13H12V15L15 12L12 9M17 9V15H22V9H17M2 11V13H7V11H2M2 15V17H7V15H2Z\";\n        Border MergeChip()\n        {\n            double fs = 11 * P.Fs;\n            var bg = B(Pal.WithA(P.AccentText, 26)); var edge = B(Pal.WithA(P.AccentText, 110));\n            var ic = Glyph(IcMerge, Math.Round(fs * 1.1), B(P.AccentText)); ic.Margin = new Thickness(0, 0, 4, 0);\n            var t = new TextBlock { Text = \"合并成一行\", FontSize = fs, Foreground = B(P.Text), VerticalAlignment = VerticalAlignment.Center };\n            var sp = new StackPanel { Orientation = Orientation.Horizontal };\n            sp.Children.Add(ic); sp.Children.Add(t);\n            var b = new Border { Background = bg, BorderBrush = edge, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(7), Padding = new Thickness(7, 2, 8, 3), Child = sp, Cursor = Cursors.Hand, VerticalAlignment = VerticalAlignment.Top };\n            Tip(b, \"把这一段的每一行合成一个大算式（Ctrl+M）\\n每行看作带一对括号的整体，括号只在需要的地方加上\\n合并完结果不变；不想要了按 Ctrl+Z 还原\");\n            b.MouseEnter += (s, e) => EaseColor(bg, Pal.WithA(P.AccentText, 56), 70);\n            b.MouseLeave += (s, e) => EaseColor(bg, Pal.WithA(P.AccentText, 26), 260);\n            OnClick(b, DoMerge);\n            return b;\n        }\n\n        // 「统一符号」：点开一个小菜单，选直观（+ - × ÷）或 Excel（+ - * /）\n        Border _sym;\n        System.Windows.Controls.Primitives.Popup _symPop;\n        Border SymChip()\n        {\n            double fs = 11 * P.Fs;\n            var bg = B(Pal.WithA(P.Text, 8)); var edge = B(Pal.WithA(P.Text, 40));\n            var t = new TextBlock { Text = \"统一符号\", FontSize = fs, Foreground = B(P.Text), VerticalAlignment = VerticalAlignment.Center };\n            var chev = Glyph(\"M7,10L12,15L17,10H7Z\", Math.Round(fs * 0.9), B(P.Muted)); chev.Margin = new Thickness(3, 1, 0, 0);\n            var sp = new StackPanel { Orientation = Orientation.Horizontal };\n            sp.Children.Add(t); sp.Children.Add(chev);\n            var b = new Border { Background = bg, BorderBrush = edge, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(7), Padding = new Thickness(8, 2, 6, 3), Child = sp, Cursor = Cursors.Hand, VerticalAlignment = VerticalAlignment.Top, Margin = new Thickness(0, 0, 6, 0) };\n            b.MouseEnter += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 22), 70);\n            b.MouseLeave += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 8), 260);\n            // 箭头：菜单开着朝上，收起朝下\n            _symRot = new RotateTransform(0); chev.RenderTransform = _symRot; chev.RenderTransformOrigin = new Point(0.5, 0.5);\n            // 点一下打开，再点一下收起（菜单的开关全由这里和 CloseSymMenu 管，不用系统的「点外面自动关」，两者会打架）\n            OnClick(b, () => OpenSymMenu(b));\n            return b;\n        }\n        RotateTransform _symRot;\n        bool SymOpen { get { return _symPop != null && _symPop.IsOpen; } }\n        void CloseSymMenu() { if (SymOpen) _symPop.IsOpen = false; }\n\n        void OpenSymMenu(FrameworkElement anchor)\n        {\n            if (_symPop != null && _symPop.IsOpen) { _symPop.IsOpen = false; return; }\n            double fs = P.Fs;\n            var list = new StackPanel { Margin = new Thickness(4) };\n            Action<string, string, string, bool> add = (title, sub, sample, excel) =>\n            {\n                var bg = B(Pal.WithA(P.Text, 0));\n                var g = new Grid();\n                g.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });\n                g.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n                var left = new StackPanel();\n                left.Children.Add(new TextBlock { Text = title, FontSize = 12 * fs, Foreground = B(P.Text), FontWeight = FontWeights.SemiBold });\n                left.Children.Add(new TextBlock { Text = sub, FontSize = 10.5 * fs, Foreground = B(P.Muted), Margin = new Thickness(0, 2, 0, 0), TextWrapping = TextWrapping.Wrap, MaxWidth = 210 * fs });\n                g.Children.Add(left);\n                var smp = new Border { Background = B(Pal.WithA(P.Text, 10)), CornerRadius = new CornerRadius(6), Padding = new Thickness(7, 2, 7, 3), Margin = new Thickness(12, 0, 0, 0), VerticalAlignment = VerticalAlignment.Center,\n                    Child = new TextBlock { Text = sample, FontSize = 12 * fs, FontFamily = new FontFamily(\"Segoe UI\"), Foreground = B(P.AccentText) } };\n                Grid.SetColumn(smp, 1); g.Children.Add(smp);\n                var row = new Border { Background = bg, CornerRadius = new CornerRadius(8), Padding = new Thickness(10, 7, 10, 8), Child = g, Cursor = Cursors.Hand };\n                row.MouseEnter += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 18), 70);\n                row.MouseLeave += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 0), 260);\n                OnClick(row, () => { _symPop.IsOpen = false; DoUnify(excel); });\n                list.Children.Add(row);\n            };\n            add(\"直观\", \"看着清楚，适合写计算书\", \"+ - × ÷\", false);\n            add(\"Excel\", \"√ 换成 SQRT、π 换成 PI()、3.5万 换成 35000；贴进 Excel 前先打 =\", \"+ - * /\", true);\n            var card = new Border\n            {\n                Background = B(P.Light ? Pal.Mix(P.Bg, Colors.White, 0.5) : Pal.Mix(P.Bg, P.Text, 0.06)), BorderBrush = B(P.Border), BorderThickness = new Thickness(1),\n                CornerRadius = new CornerRadius(11), Child = list,\n            };\n            // 阴影放在卡片后面单独一层：阴影效果挂在卡片上会让里面的字退回灰度、发糊\n            var menu = new Grid { Margin = new Thickness(10, 4, 10, 14) };\n            menu.Children.Add(new Border { CornerRadius = new CornerRadius(11), Background = Brushes.Black, Margin = new Thickness(1), Effect = new DropShadowEffect { BlurRadius = 16, ShadowDepth = 3, Direction = 270, Opacity = 0.3, Color = Colors.Black } });\n            menu.Children.Add(card);\n            RenderOptions.SetClearTypeHint(card, ClearTypeHint.Enabled);\n            TextOptions.SetTextFormattingMode(menu, TextFormattingMode.Ideal);\n            TextOptions.SetTextRenderingMode(menu, TextRenderingMode.ClearType);\n            menu.Opacity = 0;\n            _symPop = new System.Windows.Controls.Primitives.Popup\n            {\n                Child = menu, AllowsTransparency = true, StaysOpen = true, PlacementTarget = anchor,\n                Placement = System.Windows.Controls.Primitives.PlacementMode.Custom,\n            };\n            // 菜单右边和按钮右边对齐，往窗口里面展开，不伸到窗口外\n            _symPop.CustomPopupPlacementCallback = (popupSize, targetSize, offset) => new[]\n            {\n                new System.Windows.Controls.Primitives.CustomPopupPlacement(new Point(targetSize.Width - popupSize.Width + 10, targetSize.Height), System.Windows.Controls.Primitives.PopupPrimaryAxis.Horizontal),\n            };\n            _symPop.Opened += (s, e) => { Ease(menu, OpacityProperty, 1, 140, null); if (_symRot != null) Ease(_symRot, RotateTransform.AngleProperty, 180, 160, null); };\n            _symPop.Closed += (s, e) => { if (_symRot != null) Ease(_symRot, RotateTransform.AngleProperty, 0, 160, null); };\n            _symPop.IsOpen = true;\n        }\n\n        void DoUnify(bool excel)\n        {\n            int changed, kept;\n            string nt = Engine.Unify(_tb.Text, excel, out changed, out kept);\n            _tb.Focus();\n            if (nt == _tb.Text)\n            {\n                _status.Text = kept > 0 ? \"有 \" + kept + \" 行换了符号结果会变，没动\" : \"符号已经是统一的了\";\n                _status.Foreground = B(kept > 0 ? P.Danger : P.Muted);\n                return;\n            }\n            int line = CurLine();\n            _tb.SelectAll();\n            _tb.SelectedText = nt;          // 整段替换，Ctrl+Z 能还原\n            // 光标放回原来那一行的末尾\n            int pos = 0;\n            for (int i = 0; i < line; i++) { int nl = nt.IndexOf('\\n', pos); if (nl < 0) break; pos = nl + 1; }\n            int end = nt.IndexOf('\\n', pos); if (end < 0) end = nt.Length; else if (end > 0 && nt[end - 1] == '\\r') end--;\n            _tb.Select(end, 0);\n            string msg = (excel ? \"已换成 Excel 符号\" : \"已换成直观符号\") + \"（\" + changed + \" 行）\";\n            if (kept > 0) msg += \"，\" + kept + \" 行换了会变结果，没动\";\n            msg += \" · Ctrl+Z 还原\";\n            Dispatcher.BeginInvoke(new Action(() => { _status.Text = msg; _status.Foreground = B(kept > 0 ? P.Danger : P.AccentText); }), DispatcherPriority.Background);\n        }\n\n        void DoMerge()\n        {\n            int sec = CurSection();\n            string err;\n            string m = Engine.Merge(_tb.Text, sec, out err);\n            _tb.Focus();\n            if (m == null) { _status.Text = err; _status.Foreground = B(P.Danger); return; }\n            // 这一段从第一行有字的到最后一行有字的，换成合并后的一行（小标题、备注行一起去掉；Ctrl+Z 能还原）\n            string t = _tb.Text;\n            int first = -1, last = -1;\n            for (int i = 0; i < _sheet.Lines.Count; i++)\n            {\n                var l = _sheet.Lines[i];\n                if (l.Section != sec || t.Substring(l.Start, l.End - l.Start).Trim().Length == 0) continue;\n                if (first < 0) first = i; last = i;\n            }\n            if (first < 0) return;\n            // 开着逐笔舍入：合并前每笔各舍一次，合并后只在最后舍一次，合计可能差一点 —— 合并照做，但明说\n            string warn = null;\n            if (_perLine && _dec >= 0)\n            {\n                bool o1, o2;\n                decimal before = _sheet.Sum(sec, _dec, true, out o1);\n                decimal after = Engine.Run(m).Sum(0, _dec, true, out o2);\n                if (!o1 && !o2 && Math.Round(before, _dec, MidpointRounding.AwayFromZero) != Math.Round(after, _dec, MidpointRounding.AwayFromZero))\n                    warn = \"注意：开着逐笔舍入，合并成一行后只在最后舍入一次，合计从 \" + Engine.Fmt(before, _dec, true) + \" 变成 \" + Engine.Fmt(after, _dec, true) + \" · Ctrl+Z 还原\";\n            }\n            int a = _sheet.Lines[first].Start, z = _sheet.Lines[last].End;\n            _tb.Select(a, z - a);\n            _tb.SelectedText = m;\n            _tb.Select(a + m.Length, 0);\n            Dispatcher.BeginInvoke(new Action(() =>\n            {\n                _status.Text = warn ?? \"已合并成一行，结果不变 · Ctrl+Z 还原\";\n                _status.Foreground = B(warn != null ? P.Danger : P.AccentText);\n            }), DispatcherPriority.Background);\n        }\n\n        void ShowKeypad(bool anim)\n        {\n            if (_keypadHost == null) return;\n            if (!anim) { _keypadHost.Visibility = _keypad ? Visibility.Visible : Visibility.Collapsed; return; }\n            if (_keypad)\n            {\n                _keypadHost.Visibility = Visibility.Visible;\n                _keypadHost.Opacity = 0;\n                Ease(_keypadHost, OpacityProperty, 1, 180, null);\n            }\n            else Ease(_keypadHost, OpacityProperty, 0, 100, (s, e) => { if (!_keypad) _keypadHost.Visibility = Visibility.Collapsed; });\n        }\n\n        // 小键盘：点了往光标处插字，焦点一直留在算稿里\n        FrameworkElement Keypad()\n        {\n            string[,] keys =\n            {\n                { \"7\", \"8\", \"9\", \"÷\", \"⌫\" },\n                { \"4\", \"5\", \"6\", \"×\", \"(\" },\n                { \"1\", \"2\", \"3\", \"-\", \")\" },\n                { \"0\", \".\", \"%\", \"+\", \"↵\" },\n            };\n            var g = new Grid();\n            for (int c = 0; c < 5; c++) g.ColumnDefinitions.Add(new ColumnDefinition());\n            for (int r = 0; r < 4; r++) g.RowDefinitions.Add(new RowDefinition());\n            double h = Math.Round(36 * P.Fs);\n            for (int r = 0; r < 4; r++)\n                for (int c = 0; c < 5; c++)\n                {\n                    string k = keys[r, c];\n                    bool op = \"÷×-+%()\".Contains(k);\n                    bool enter = k == \"↵\", back = k == \"⌫\";\n                    Color norm = op ? Pal.WithA(P.AccentText, 30) : P.BtnBg;\n                    Color hover = op ? Pal.WithA(P.AccentText, 56) : P.BtnHover;\n                    var bg = B(norm);\n                    var cell = new Border { Height = h, Margin = new Thickness(3), CornerRadius = new CornerRadius(9), Cursor = Cursors.Hand, RenderTransformOrigin = new Point(0.5, 0.5) };\n                    var st = new ScaleTransform(1, 1); cell.RenderTransform = st;\n                    UIElement content;\n                    if (back) content = Glyph(IcBack, Math.Round(16 * P.Fs), B(P.Muted));\n                    else if (enter) content = Glyph(IcReturn, Math.Round(16 * P.Fs), B(P.DarkOnAccent));\n                    else\n                    {\n                        string show = k == \"-\" ? \"−\" : k;\n                        content = new TextBlock { Text = show, FontSize = (op ? 16 : 15) * P.Fs, FontFamily = new FontFamily(\"Segoe UI\"), Foreground = B(op ? P.AccentText : P.Text), HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(0, 0, 0, 1) };\n                    }\n                    if (enter)\n                    {\n                        cell.Background = P.Grad();\n                        var shine = new Border { CornerRadius = new CornerRadius(9), Background = Brushes.White, Opacity = 0 };\n                        var cg = new Grid(); cg.Children.Add(shine); cg.Children.Add(content); cell.Child = cg;\n                        cell.MouseEnter += (s, e) => Ease(shine, OpacityProperty, 0.1, 70, null);\n                        cell.MouseLeave += (s, e) => Ease(shine, OpacityProperty, 0, 260, null);\n                        Tip(cell, \"换行，算下一笔（就是回车）\");\n                    }\n                    else\n                    {\n                        cell.Background = bg; cell.Child = content;\n                        cell.MouseEnter += (s, e) => EaseColor(bg, hover, 70);\n                        cell.MouseLeave += (s, e) => EaseColor(bg, norm, 260);\n                    }\n                    cell.PreviewMouseLeftButtonDown += (s, e) => { Ease(st, ScaleTransform.ScaleXProperty, 0.94, 60, null); Ease(st, ScaleTransform.ScaleYProperty, 0.94, 60, null); };\n                    cell.MouseLeftButtonUp += (s, e) => { Ease(st, ScaleTransform.ScaleXProperty, 1, 140, null); Ease(st, ScaleTransform.ScaleYProperty, 1, 140, null); };\n                    cell.MouseLeave += (s, e) => { Ease(st, ScaleTransform.ScaleXProperty, 1, 140, null); Ease(st, ScaleTransform.ScaleYProperty, 1, 140, null); };\n                    string key = k;\n                    OnClick(cell, () => Press(key));\n                    Grid.SetRow(cell, r); Grid.SetColumn(cell, c);\n                    g.Children.Add(cell);\n                }\n            return g;\n        }\n\n        void Press(string k)\n        {\n            _tb.Focus();\n            if (k == \"⌫\")\n            {\n                if (_tb.SelectionLength > 0) { _tb.SelectedText = \"\"; return; }\n                int ci = _tb.CaretIndex;\n                if (ci == 0) return;\n                int n = (ci >= 2 && _tb.Text[ci - 1] == '\\n' && _tb.Text[ci - 2] == '\\r') ? 2 : 1;\n                _tb.Select(ci - n, n); _tb.SelectedText = \"\";\n                return;\n            }\n            Insert(k == \"↵\" ? \"\\r\\n\" : k);\n        }\n\n        void Insert(string s)\n        {\n            _tb.SelectedText = s;\n            _tb.Select(_tb.SelectionStart + _tb.SelectionLength, 0);\n        }\n\n        void ClearAll()\n        {\n            if (_tb.Text.Length == 0) return;\n            _tb.Focus();\n            _tb.SelectAll();\n            _tb.SelectedText = \"\";       // 用选中再删除，Ctrl+Z 能找回来\n            _status.Text = \"已清空，按 Ctrl+Z 找回\";\n        }\n\n        // 粘贴：Excel 复制来的东西照原样进来；只把行尾多余的空白去掉\n        void OnPaste(object sender, DataObjectPastingEventArgs e)\n        {\n            try\n            {\n                if (!e.SourceDataObject.GetDataPresent(DataFormats.UnicodeText, true)) return;\n                var t = e.SourceDataObject.GetData(DataFormats.UnicodeText, true) as string;\n                if (t == null) return;\n                string n = t.Replace(\"\\r\\n\", \"\\n\").Replace('\\r', '\\n');\n                var lines = n.Split('\\n').Select(x => x.TrimEnd(' ', '\\t')).ToList();\n                while (lines.Count > 1 && lines[lines.Count - 1].Length == 0) lines.RemoveAt(lines.Count - 1);\n                // 从 Excel 复制来的一列（剪贴板里带 Csv 格式，或者每行都只是数）：中间的空格子去掉，不然会被当成「另起一段」\n                bool fromExcel = e.SourceDataObject.GetDataPresent(DataFormats.CommaSeparatedValue, false);\n                if (lines.Count > 1 && (fromExcel || LooksLikeColumn(lines))) lines = lines.Where(x => x.Trim().Length > 0).ToList();\n                // 一片多列的表：提示一行里的数是相加的\n                int tabRows = lines.Count(x => x.Contains(\"\\t\"));\n                if (tabRows >= 2) _pasteHint = true;\n                string fixedText = string.Join(\"\\r\\n\", lines);\n                if (fixedText == t) return;\n                var d = new DataObject(); d.SetData(DataFormats.UnicodeText, fixedText);\n                e.DataObject = d;\n            }\n            catch { }\n        }\n\n        // ---------------------------------------------------------------- 键盘\n        void OnKey(object s, KeyEventArgs e)\n        {\n            bool ctrl = (Keyboard.Modifiers & ModifierKeys.Control) != 0, shift = (Keyboard.Modifiers & ModifierKeys.Shift) != 0;\n            if (e.Key == Key.Escape) { e.Handled = true; if (SymOpen) CloseSymMenu(); else Close(); return; }\n            if (ctrl && e.Key == Key.L) { e.Handled = true; ClearAll(); return; }\n            if (ctrl && e.Key == Key.Enter) { e.Handled = true; CopyLine(CurLine(), true); return; }\n            if (ctrl && shift && e.Key == Key.C) { e.Handled = true; CopyTotal(); return; }\n            if (ctrl && !shift && e.Key == Key.C && _tb.SelectionLength == 0) { e.Handled = true; CopyLine(CurLine(), true); return; }\n            if (ctrl && e.Key == Key.L) { e.Handled = true; ClearAll(); return; }\n            if (ctrl && e.Key == Key.M) { e.Handled = true; DoMerge(); return; }\n        }\n\n        int CurLine()\n        {\n            int ci = Math.Min(_tb.CaretIndex, _tb.Text.Length), n = 0;\n            string t = _tb.Text;\n            for (int i = 0; i < ci; i++) if (t[i] == '\\n') n++;\n            return n;\n        }\n        int CurSection()\n        {\n            int li = CurLine();\n            if (li < _sheet.Lines.Count)\n            {\n                // 光标停在段与段之间的空行上：算上面那一段\n                return _sheet.Lines[li].Section;\n            }\n            return Math.Max(0, _sheet.Sections - 1);\n        }\n\n        // ---------------------------------------------------------------- 计算、显示\n        void Recalc()\n        {\n            if (_tb == null) return;\n            _sheet = Engine.Run(_tb.Text);\n            _placeholder.Visibility = _tb.Text.Length == 0 ? Visibility.Visible : Visibility.Collapsed;\n            BuildResults();\n            UpdateStatus();\n            UpdateTotal();\n            Dispatcher.BeginInvoke(new Action(PositionResults), DispatcherPriority.Loaded);\n        }\n\n        readonly List<FrameworkElement> _pills = new List<FrameworkElement>();\n        void BuildResults()\n        {\n            _res.Children.Clear(); _pills.Clear();\n            double fs = P.Fs, maxW = 0;\n            var typeface = new FontFamily(\"Segoe UI, Microsoft YaHei UI\");\n            for (int i = 0; i < _sheet.Lines.Count; i++)\n            {\n                var l = _sheet.Lines[i];\n                if (l.Empty) { _pills.Add(null); continue; }\n                var tb = new TextBlock { FontSize = 14 * fs, FontFamily = typeface, VerticalAlignment = VerticalAlignment.Center, TextWrapping = TextWrapping.NoWrap };\n                Typography.SetNumeralAlignment(tb, FontNumeralAlignment.Tabular);\n                var bg = B(Pal.WithA(P.Text, 0));\n                var pill = new Border { Background = bg, CornerRadius = new CornerRadius(6), Padding = new Thickness(6, 0, 6, 1), Child = tb, HorizontalAlignment = HorizontalAlignment.Right, Cursor = Cursors.Hand };\n                int idx = i;\n                if (i == _flashLine)\n                {\n                    tb.Inlines.Add(new Run(\"已复制 ✓\") { Foreground = B(P.AccentText), FontSize = 12 * fs });\n                }\n                else if (l.Ok)\n                {\n                    tb.Inlines.Add(new Run(\"= \") { Foreground = B(Pal.WithA(P.Muted, 160)), FontSize = 12 * fs });\n                    tb.Inlines.Add(new Run(Engine.Fmt(l.Value, _dec, true)) { Foreground = B(l.Absorbed ? P.Muted : P.Text) });\n                    Tip(pill, l.Absorbed ? \"下一行接着它算，合计里只算最后的结果\\n点一下复制\" : \"点一下复制\");\n                    OnClick(pill, () => CopyLine(idx, false));\n                }\n                else\n                {\n                    tb.Inlines.Add(new Run(\"算不出\") { Foreground = B(P.Danger), FontSize = 12 * fs });\n                    Tip(pill, l.Err);\n                    OnClick(pill, () => { _tb.Focus(); _tb.Select(Math.Min(l.End, _tb.Text.Length), 0); });\n                }\n                pill.MouseEnter += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 20), 70);\n                pill.MouseLeave += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 0), 260);\n                pill.Measure(new Size(double.PositiveInfinity, double.PositiveInfinity));\n                maxW = Math.Max(maxW, pill.DesiredSize.Width);\n                var holder = new Grid();\n                holder.Children.Add(pill);\n                holder.Visibility = Visibility.Hidden;\n                _res.Children.Add(holder);\n                _pills.Add(holder);\n            }\n            double w = Math.Max(Math.Round(72 * fs), Math.Min(Math.Round(190 * fs), Math.Ceiling(maxW) + 10));\n            if (Math.Abs(_resCol.Width.Value - w) > 0.5) _resCol.Width = new GridLength(w);\n            foreach (var h in _pills) if (h != null) h.Width = w - 4;\n        }\n\n        void PositionResults()\n        {\n            if (_tb == null) return;\n            _tb.UpdateLayout();\n            string t = _tb.Text;\n            for (int i = 0; i < _pills.Count && i < _sheet.Lines.Count; i++)\n            {\n                var h = _pills[i];\n                if (h == null) continue;\n                var l = _sheet.Lines[i];\n                int idx = Math.Max(l.Start, Math.Min(l.End, t.Length));\n                Rect r = idx > l.Start ? _tb.GetRectFromCharacterIndex(idx, true) : _tb.GetRectFromCharacterIndex(idx);\n                if (r.IsEmpty) { h.Visibility = Visibility.Hidden; continue; }\n                h.Measure(new Size(double.PositiveInfinity, double.PositiveInfinity));\n                double ph = h.DesiredSize.Height;\n                Canvas.SetTop(h, Math.Round(r.Top + (r.Height - ph) / 2));\n                Canvas.SetLeft(h, 2);\n                h.Visibility = Visibility.Visible;\n            }\n            DrawBar();\n        }\n\n        // 有好几段时，在当前这一段左边画一条强调色细条，表示合计算的是这一段\n        void DrawBar()\n        {\n            if (_bar == null) return;\n            _bar.Children.Clear();\n            if (_sheet.Sections < 2) return;\n            int sec = CurSection();\n            int first = -1, last = -1;\n            for (int i = 0; i < _sheet.Lines.Count; i++)\n                if (_sheet.Lines[i].Section == sec && !_sheet.Lines[i].Empty) { if (first < 0) first = i; last = i; }\n            if (first < 0) return;\n            string t = _tb.Text;\n            Rect a = _tb.GetRectFromCharacterIndex(Math.Min(_sheet.Lines[first].Start, t.Length));\n            int le = Math.Min(_sheet.Lines[last].End, t.Length);\n            Rect b = le > _sheet.Lines[last].Start ? _tb.GetRectFromCharacterIndex(le, true) : _tb.GetRectFromCharacterIndex(le);\n            if (a.IsEmpty || b.IsEmpty) return;\n            var rect = new Border { Width = 3, Height = Math.Max(4, b.Bottom - a.Top - 4), CornerRadius = new CornerRadius(1.5), Background = B(P.AccentText), Opacity = 0.85 };\n            Canvas.SetLeft(rect, 3); Canvas.SetTop(rect, a.Top + 2);\n            _bar.Children.Add(rect);\n        }\n\n        void UpdateStatus()\n        {\n            if (_status == null) return;\n            if (_merge != null)\n            {\n                int csec = CurSection();\n                _merge.Visibility = _sheet.Lines.Count(l => l.Section == csec && !l.Empty) >= 2 ? Visibility.Visible : Visibility.Collapsed;\n            }\n            if (_sym != null) _sym.Visibility = _sheet.Lines.Any(l => !l.Empty) ? Visibility.Visible : Visibility.Collapsed;\n            int li = CurLine();\n            _status.Foreground = B(P.Muted);\n            if (_pasteHint) { _pasteHint = false; _status.Text = \"粘贴的是好几列的表：一行里用 Tab 隔开的数按相加算，要相乘请改成 ×\"; return; }\n            if (li < _sheet.Lines.Count && !_sheet.Lines[li].Empty && !_sheet.Lines[li].Ok)\n            {\n                _status.Text = \"这一行算不出：\" + _sheet.Lines[li].Err;\n                _status.Foreground = B(P.Danger);\n                return;\n            }\n            if (_tb.Text.Trim().Length == 0) { _status.Text = \"直接打字或点下面的键；回车算下一笔，空一行另起一段\"; return; }\n            if (li < _sheet.Lines.Count && _sheet.Lines[li].Cont) { _status.Text = \"这一行接着上一行的结果算\"; return; }\n            _status.Text = \"点结果复制 · Ctrl+回车 复制这一行 · Esc 收起\";\n        }\n\n        void UpdateTotal()\n        {\n            if (_totalTxt == null) return;\n            if (_perChip != null) _perChip.Visibility = _dec >= 0 ? Visibility.Visible : Visibility.Collapsed;\n            int sec = CurSection();\n            int n = _sheet.Count(sec), err = _sheet.Errors(sec);\n            bool over;\n            decimal tot = _sheet.Sum(sec, _dec, _perLine, out over);\n            _totalErrors = err;\n            _totalLabel.Text = _sheet.Sections > 1 ? \"这一段合计\" : \"合计\";\n            var sub = new List<string>();\n            if (n > 0) sub.Add(n + \" 笔\");\n            if (_perLine && _dec >= 0 && n > 0) sub.Add(\"逐笔舍入\");\n            if (err > 0) sub.Add(err + \" 行算不出，没算进去\");\n            _totalSub.Text = string.Join(\" · \", sub);\n            _totalSub.Foreground = B(err > 0 ? P.Danger : P.Muted);\n            if (over) { _totalTxt.Text = \"数太大了\"; _totalTxt.Foreground = B(P.Danger); _totalStr = \"\"; return; }\n            if (n == 0) { _totalTxt.Text = \"0\"; _totalTxt.Foreground = B(P.Muted); _totalStr = \"\"; }\n            else\n            {\n                _totalTxt.Text = Engine.Fmt(tot, _dec, true);\n                _totalTxt.Foreground = B(P.Text);\n                _totalStr = Engine.Fmt(tot, _dec, false);\n            }\n        }\n\n        void ScrollToCaret()\n        {\n            if (_tb == null || _sv == null) return;\n            var r = _tb.GetRectFromCharacterIndex(Math.Min(_tb.CaretIndex, _tb.Text.Length));\n            if (r.IsEmpty) return;\n            _tb.BringIntoView(new Rect(0, Math.Max(0, r.Top - 6), 1, r.Height + 12));\n        }\n\n        // ---------------------------------------------------------------- 复制\n        // 直接调系统剪贴板（和 MB out 的 NativeClip 一样）：WPF 的 Clipboard.SetText 会等剪贴板同步类程序（远程桌面、UU 远程等）处理完，点一下要卡好久\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern bool OpenClipboard(IntPtr owner);\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern bool CloseClipboard();\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern bool EmptyClipboard();\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern IntPtr SetClipboardData(uint fmt, IntPtr mem);\n        [System.Runtime.InteropServices.DllImport(\"kernel32.dll\")] static extern IntPtr GlobalAlloc(uint flags, UIntPtr bytes);\n        [System.Runtime.InteropServices.DllImport(\"kernel32.dll\")] static extern IntPtr GlobalLock(IntPtr h);\n        [System.Runtime.InteropServices.DllImport(\"kernel32.dll\")] static extern bool GlobalUnlock(IntPtr h);\n        [System.Runtime.InteropServices.DllImport(\"kernel32.dll\")] static extern IntPtr GlobalFree(IntPtr h);\n\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern IntPtr GetOpenClipboardWindow();\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern uint GetWindowThreadProcessId(IntPtr h, out uint pid);\n\n        // 剪贴板一时打不开（别的程序正在读）：先马上试几次，不行就后台每 50 毫秒再试，最多 3 秒，不卡窗口\n        DispatcherTimer _clipRetry;\n        string _clipPending;\n        Action<bool, string> _clipDone;\n        DateTime _clipUntil;\n        void CopyText(string t, Action<bool, string> done)\n        {\n            if (_clipRetry != null) _clipRetry.Stop();\n            if (SetClip(t, 5)) { done(true, null); return; }\n            _clipPending = t; _clipDone = done; _clipUntil = DateTime.Now.AddSeconds(3);\n            if (_clipRetry == null)\n            {\n                _clipRetry = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(50) };\n                _clipRetry.Tick += (s, e) =>\n                {\n                    if (SetClip(_clipPending, 1)) { _clipRetry.Stop(); _clipDone(true, null); }\n                    else if (DateTime.Now > _clipUntil) { _clipRetry.Stop(); _clipDone(false, ClipHolder()); }\n                };\n            }\n            _clipRetry.Start();\n        }\n        /// <summary>正占着剪贴板的程序名（拿不到就空）</summary>\n        static string ClipHolder()\n        {\n            try\n            {\n                uint pid; var h = GetOpenClipboardWindow();\n                if (h == IntPtr.Zero || GetWindowThreadProcessId(h, out pid) == 0) return null;\n                return System.Diagnostics.Process.GetProcessById((int)pid).ProcessName;\n            }\n            catch { return null; }\n        }\n        static string BusyText(string who) { return string.IsNullOrEmpty(who) ? \"剪贴板被别的程序占着，再点一下试试\" : \"剪贴板被「\" + who + \"」占着，再点一下试试\"; }\n\n        bool SetClip(string t, int tries)\n        {\n            IntPtr owner = IntPtr.Zero;\n            try { owner = new System.Windows.Interop.WindowInteropHelper(this).Handle; } catch { }\n            for (int i = 0; i < tries; i++)\n            {\n                if (!OpenClipboard(owner)) { if (i < tries - 1) Thread.Sleep(10); continue; }\n                try\n                {\n                    EmptyClipboard();\n                    byte[] bytes = Encoding.Unicode.GetBytes(t + \"\\0\");\n                    IntPtr h = GlobalAlloc(0x0002, (UIntPtr)bytes.Length);   // GMEM_MOVEABLE\n                    if (h == IntPtr.Zero) return false;\n                    IntPtr p = GlobalLock(h);\n                    System.Runtime.InteropServices.Marshal.Copy(bytes, 0, p, bytes.Length);\n                    GlobalUnlock(h);\n                    if (SetClipboardData(13, h) == IntPtr.Zero) { GlobalFree(h); return false; }   // CF_UNICODETEXT；成功后内存归系统\n                    return true;\n                }\n                finally { CloseClipboard(); }\n            }\n            return false;\n        }\n        void CopyLine(int li, bool fromKey)\n        {\n            if (li < 0 || li >= _sheet.Lines.Count || !_sheet.Lines[li].Ok)\n            {\n                _status.Text = fromKey ? \"这一行还没有结果\" : \"这一行算不出\";\n                _status.Foreground = B(P.Danger);\n                return;\n            }\n            CopyText(Engine.Fmt(_sheet.Lines[li].Value, _dec, false), (ok, who) =>\n            {\n                if (!ok) { _status.Text = BusyText(who); _status.Foreground = B(P.Danger); return; }\n                _flashLine = li; _lineFlash.Stop(); _lineFlash.Start();\n                BuildResults(); PositionResults();\n            });\n        }\n        /// <summary>按钮上的字：先「复制中…」，复制好了「已复制」，不行就提示谁占着剪贴板</summary>\n        void CopyWithLabel(TextBlock label, string t, string okText, Action after)\n        {\n            _flash.Stop();\n            label.Text = \"复制中…\";\n            CopyText(t, (ok, who) =>\n            {\n                label.Text = ok ? okText : \"剪贴板被占用\";\n                if (!ok) Dispatcher.BeginInvoke(new Action(() => { _status.Text = BusyText(who); _status.Foreground = B(P.Danger); }), DispatcherPriority.Background);\n                else if (after != null) after();\n                _flash.Stop(); _flash.Start();\n            });\n        }\n        void CopyTotal()\n        {\n            if (_totalStr.Length == 0) { _status.Text = \"还没有可以合计的数\"; _status.Foreground = B(P.Danger); return; }\n            int errs = _totalErrors;\n            CopyWithLabel(_copyTxt, _totalStr, errs > 0 ? \"已复制（不全）\" : \"已复制\", () =>\n            {\n                if (errs > 0)\n                    Dispatcher.BeginInvoke(new Action(() => { _status.Text = \"注意：有 \" + errs + \" 行算不出，复制的合计没算它们\"; _status.Foreground = B(P.Danger); }), DispatcherPriority.Background);\n            });\n            FocusEditor();\n        }\n        void CopySheet()\n        {\n            int sec = CurSection();\n            var sb = new StringBuilder();\n            string t = _tb.Text;\n            int lastNonBlank = -1;\n            for (int i = 0; i < _sheet.Lines.Count; i++)\n            {\n                var l = _sheet.Lines[i];\n                if (l.Section == sec && t.Substring(l.Start, Math.Max(0, Math.Min(l.End, t.Length) - l.Start)).Trim().Length > 0) lastNonBlank = i;\n            }\n            for (int i = 0; i <= lastNonBlank; i++)\n            {\n                var l = _sheet.Lines[i];\n                if (l.Section != sec) continue;\n                string raw = t.Substring(l.Start, Math.Max(0, Math.Min(l.End, t.Length) - l.Start));\n                if (raw.Trim().Length == 0) { if (sb.Length > 0) sb.Append(\"\\r\\n\"); continue; }\n                // 小标题 / 只有备注的行：照原样带上\n                if (l.Empty) { sb.Append(raw.Trim()).Append(\"\\r\\n\"); continue; }\n                string half = Engine.ToHalf(raw);\n                int st, en, lab;\n                Engine.Locate(half, out st, out en, out lab);\n                string left = (raw.Substring(0, lab > 0 ? lab + 1 : 0) + raw.Substring(st, en - st)).Trim();\n                int h = Engine.CommentAt(half);\n                string note = h >= 0 ? \"  \" + raw.Substring(h).Trim() : \"\";\n                if (l.Ok) sb.Append(left).Append(\" = \").Append(Engine.Fmt(l.Value, _dec, false)).Append(note);\n                else sb.Append(left).Append(\"    （算不出：\").Append(l.Err).Append(\"）\").Append(note);\n                sb.Append(\"\\r\\n\");\n            }\n            if (sb.Length == 0) { _status.Text = \"算稿是空的\"; _status.Foreground = B(P.Danger); return; }\n            if (_totalStr.Length > 0) sb.Append(\"合计 = \").Append(_totalStr).Append(_perLine && _dec >= 0 ? \"（逐笔舍入）\" : \"\");\n            CopyWithLabel(_copyAllTxt, sb.ToString().TrimEnd(), \"已复制\", null);\n            _tb.Focus();\n        }\n\n        // 阴影：按窗口大小画一次的静态图（实时 DropShadowEffect 会让透明窗口每帧重画，悬停会闪）\n        Size _shadowFor = Size.Empty;\n        bool _shadowQueued;\n        void QueueShadow()\n        {\n            if (_shadowQueued) return;\n            _shadowQueued = true;\n            Dispatcher.BeginInvoke(new Action(() => { _shadowQueued = false; DrawShadow(); }), DispatcherPriority.Background);\n        }\n        void DrawShadow()\n        {\n            double w = _shell.ActualWidth, h = _shell.ActualHeight;\n            if (w < 2 || h < 2) return;\n            if (!_shadowFor.IsEmpty && Math.Abs(_shadowFor.Width - w) < 0.5 && Math.Abs(_shadowFor.Height - h) < 0.5) return;\n            _shadowFor = new Size(w, h);\n            try\n            {\n                double W = w + PadOut * 2, H = h + PadOut * 2, dpi = 1;\n                var src = PresentationSource.FromVisual(this);\n                if (src != null && src.CompositionTarget != null) dpi = src.CompositionTarget.TransformToDevice.M11;\n                double cr = 14;\n                var g = new Grid { Width = W, Height = H };\n                g.Children.Add(new Border { Margin = new Thickness(PadOut), CornerRadius = new CornerRadius(cr), Background = Brushes.Black, Effect = new DropShadowEffect { BlurRadius = 18, ShadowDepth = 3, Direction = 270, Opacity = 0.32, Color = Colors.Black } });\n                g.Measure(new Size(W, H)); g.Arrange(new Rect(0, 0, W, H)); g.UpdateLayout();\n                int pw = (int)Math.Ceiling(W * dpi), ph = (int)Math.Ceiling(H * dpi);\n                var full = new RenderTargetBitmap(pw, ph, 96 * dpi, 96 * dpi, PixelFormats.Pbgra32);\n                full.Render(g);\n                var outside = new CombinedGeometry(GeometryCombineMode.Exclude, new RectangleGeometry(new Rect(0, 0, W, H)), new RectangleGeometry(new Rect(PadOut + 1, PadOut + 1, w - 2, h - 2), cr, cr));\n                var dv = new DrawingVisual();\n                using (var dc = dv.RenderOpen()) { dc.PushClip(outside); dc.DrawImage(full, new Rect(0, 0, W, H)); dc.Pop(); }\n                var rtb = new RenderTargetBitmap(pw, ph, 96 * dpi, 96 * dpi, PixelFormats.Pbgra32);\n                rtb.Render(dv); rtb.Freeze();\n                var brush = new ImageBrush(rtb) { Stretch = Stretch.Fill };\n                System.Windows.Data.BindingOperations.SetBinding(brush, Brush.OpacityProperty, new System.Windows.Data.Binding(\"Opacity\") { Source = _host });\n                Background = brush;\n            }\n            catch { Background = Brushes.Transparent; }\n        }\n    }\n\n    // ================================================================ 窗口：大小、逐笔舍入、粘贴判断\n    partial class CalcWindow\n    {\n        const double MinW = 330, MaxW = 1100;\n        StackPanel _sp;\n        double _cw = 360, _eh, _lineH = 20;\n        bool _perLine, _pasteHint;\n        int _totalErrors;\n        Border _perChip;\n\n        TextBlock _copyFTxt;\n\n        // 这一段 → 一条带 = 的 Excel 公式（开着逐笔舍入就每笔套 ROUND）\n        void CopyFormula()\n        {\n            string err;\n            string f = Engine.ExcelFormula(_tb.Text, CurSection(), _dec, _perLine, out err);\n            _tb.Focus();\n            if (f == null) { _status.Text = err; _status.Foreground = B(P.Danger); return; }\n            CopyWithLabel(_copyFTxt, f, \"已复制\", () =>\n                Dispatcher.BeginInvoke(new Action(() => { _status.Text = \"已复制：\" + (f.Length > 60 ? f.Substring(0, 60) + \"…\" : f); _status.Foreground = B(P.AccentText); }), DispatcherPriority.Background));\n        }\n\n        void FocusEditor() { if (_tb != null) _tb.Focus(); }\n\n        [System.Runtime.InteropServices.DllImport(\"kernel32.dll\")] static extern bool SetProcessWorkingSetSize(IntPtr p, IntPtr min, IntPtr max);\n        static void TrimMemory()\n        {\n            try { GC.Collect(); GC.WaitForPendingFinalizers(); SetProcessWorkingSetSize(System.Diagnostics.Process.GetCurrentProcess().Handle, (IntPtr)(-1), (IntPtr)(-1)); } catch { }\n        }\n\n        /// <summary>目录里有别的版本的 calc_*.exe，而且比自己新：说明插件更新了，旧窗口该让位</summary>\n        static bool NewerVersion()\n        {\n            try\n            {\n                string me = System.Reflection.Assembly.GetExecutingAssembly().Location;\n                var mine = File.GetLastWriteTimeUtc(me);\n                foreach (var f in Directory.GetFiles(System.IO.Path.GetDirectoryName(me), \"calc_*.exe\"))\n                    if (!string.Equals(f, me, StringComparison.OrdinalIgnoreCase) && !f.EndsWith(\"calc_build.exe\", StringComparison.OrdinalIgnoreCase) && File.GetLastWriteTimeUtc(f) > mine) return true;\n            }\n            catch { }\n            return false;\n        }\n        void RefreshAll() { Recalc(); }\n\n        // ---------------------------------------------------------------- 右下角拖动改大小\n        FrameworkElement Grip()\n        {\n            var dots = new System.Windows.Shapes.Path\n            {\n                Data = Geometry.Parse(\"M9,1 h1.6 v1.6 h-1.6Z M5,5 h1.6 v1.6 h-1.6Z M9,5 h1.6 v1.6 h-1.6Z M1,9 h1.6 v1.6 h-1.6Z M5,9 h1.6 v1.6 h-1.6Z M9,9 h1.6 v1.6 h-1.6Z\"),\n                Fill = B(P.Muted), Opacity = 0.55, Width = 11, Height = 11, Stretch = Stretch.None, HorizontalAlignment = HorizontalAlignment.Right, VerticalAlignment = VerticalAlignment.Bottom,\n            };\n            var t = new ControlTemplate(typeof(System.Windows.Controls.Primitives.Thumb));\n            var f = new FrameworkElementFactory(typeof(Border));\n            f.SetValue(Border.BackgroundProperty, Brushes.Transparent);\n            t.VisualTree = f;\n            var th = new System.Windows.Controls.Primitives.Thumb { Template = t, Width = 18, Height = 18, Cursor = Cursors.SizeNWSE };\n            var g = new Grid { Width = 18, Height = 18, HorizontalAlignment = HorizontalAlignment.Right, VerticalAlignment = VerticalAlignment.Bottom, Margin = new Thickness(0, 0, 4, 4) };\n            g.Children.Add(dots); g.Children.Add(th);\n            Tip(th, \"拖动：拉宽窗口、拉高算稿区；双击恢复默认大小\");\n            th.MouseEnter += (s, e) => Ease(dots, OpacityProperty, 1, 70, null);\n            th.MouseLeave += (s, e) => Ease(dots, OpacityProperty, 0.55, 260, null);\n            th.DragDelta += (s, e) =>\n            {\n                // 按窗口所在的那块屏幕限制大小，不拉出屏幕\n                var wa = ScreenWorkArea();\n                double maxW = Math.Min(MaxW, Math.Max(MinW, (wa.Right - Left - 70) / P.Fs));\n                _cw = Math.Max(MinW, Math.Min(maxW, _cw + e.HorizontalChange / P.Fs));\n                _sp.Width = Math.Round(_cw * P.Fs);\n                double cur = _eh > 0 ? _eh : (_sv != null ? _sv.ActualHeight : 200);\n                double maxH = Math.Max(_lineH * 3 + 16, wa.Bottom - Top - (ActualHeight - cur) - 10);\n                _eh = Math.Max(_lineH * 3 + 16, Math.Min(maxH, cur + e.VerticalChange));\n                ApplyEditorHeight();\n            };\n            th.DragCompleted += (s, e) => { SaveCfg(); RefreshAll(); };\n            th.MouseDoubleClick += (s, e) => { _cw = 360; _eh = 0; _sp.Width = Math.Round(_cw * P.Fs); ApplyEditorHeight(); SaveCfg(); RefreshAll(); };\n            return g;\n        }\n\n        [System.Runtime.InteropServices.StructLayout(System.Runtime.InteropServices.LayoutKind.Sequential)]\n        struct RECT { public int L, T, R, B; }\n        [System.Runtime.InteropServices.StructLayout(System.Runtime.InteropServices.LayoutKind.Sequential)]\n        struct MONITORINFO { public int cbSize; public RECT rcMonitor, rcWork; public int dwFlags; }\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern IntPtr MonitorFromWindow(IntPtr h, int flags);\n        [System.Runtime.InteropServices.DllImport(\"user32.dll\")] static extern bool GetMonitorInfo(IntPtr m, ref MONITORINFO mi);\n\n        /// <summary>窗口所在显示器的工作区（和 WPF 一样的单位）；拿不到就用主屏</summary>\n        Rect ScreenWorkArea()\n        {\n            try\n            {\n                var h = new System.Windows.Interop.WindowInteropHelper(this).Handle;\n                var mi = new MONITORINFO { cbSize = System.Runtime.InteropServices.Marshal.SizeOf(typeof(MONITORINFO)) };\n                if (h != IntPtr.Zero && GetMonitorInfo(MonitorFromWindow(h, 2), ref mi))\n                {\n                    var src = PresentationSource.FromVisual(this);\n                    double sx = 1, sy = 1;\n                    if (src != null && src.CompositionTarget != null) { sx = src.CompositionTarget.TransformFromDevice.M11; sy = src.CompositionTarget.TransformFromDevice.M22; }\n                    return new Rect(mi.rcWork.L * sx, mi.rcWork.T * sy, (mi.rcWork.R - mi.rcWork.L) * sx, (mi.rcWork.B - mi.rcWork.T) * sy);\n                }\n            }\n            catch { }\n            return SystemParameters.WorkArea;\n        }\n\n        void ApplyEditorHeight()\n        {\n            if (_sv == null) return;\n            if (_eh <= 0) { _sv.MaxHeight = _lineH * 11 + 16; _tb.MinHeight = _lineH * 5 + 16; }\n            else { _sv.MaxHeight = _eh; _tb.MinHeight = _eh; }\n        }\n\n        // 勾选块（逐笔舍入）\n        Color ChipBg(bool on) { return on ? Pal.WithA(P.AccentText, 52) : Pal.WithA(P.Text, 6); }\n        Color ChipEdge(bool on) { return on ? Pal.WithA(P.AccentText, 200) : Pal.WithA(P.Text, 40); }\n        Color ChipFg(bool on) { return on ? P.Text : P.Muted; }\n        Border Chip(string text, Func<bool> get, Action<bool> set)\n        {\n            bool on = get();\n            var bg = B(ChipBg(on)); var edge = B(ChipEdge(on)); var fg = B(ChipFg(on));\n            double fs = 11 * P.Fs;\n            var chk = Glyph(\"M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z\", Math.Round(fs * 0.9), B(P.AccentText));\n            chk.Margin = new Thickness(0, 0, 4, 0);\n            var t = new TextBlock { Text = text, FontSize = fs, Foreground = fg, VerticalAlignment = VerticalAlignment.Center };\n            var sp = new StackPanel { Orientation = Orientation.Horizontal, HorizontalAlignment = HorizontalAlignment.Center };\n            sp.Children.Add(chk); sp.Children.Add(t);\n            var b = new Border { Background = bg, BorderBrush = edge, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(7), Padding = new Thickness(7, 2, 8, 3), Child = sp, Cursor = Cursors.Hand, VerticalAlignment = VerticalAlignment.Center };\n            chk.Visibility = on ? Visibility.Visible : Visibility.Collapsed;\n            b.MouseEnter += (s, e) => EaseColor(bg, get() ? Pal.WithA(P.AccentText, 70) : Pal.WithA(P.Text, 18), 70);\n            b.MouseLeave += (s, e) => EaseColor(bg, ChipBg(get()), 260);\n            OnClick(b, () =>\n            {\n                bool n = !get(); set(n);\n                EaseColor(bg, ChipBg(n), 140); EaseColor(edge, ChipEdge(n), 140); EaseColor(fg, ChipFg(n), 140);\n                chk.Visibility = n ? Visibility.Visible : Visibility.Collapsed;\n                if (n) { chk.Opacity = 0; Ease(chk, OpacityProperty, 1, 140, null); }\n            });\n            return b;\n        }\n\n        // 一列数（可以 Tab 隔开），中间夹着空行：像是从 Excel 复制来的，空行是空格子，不是「另起一段」\n        static bool LooksLikeColumn(List<string> lines)\n        {\n            var ne = lines.Where(x => x.Trim().Length > 0).ToList();\n            if (ne.Count < 2 || ne.Count == lines.Count) return false;\n            var num = new Regex(@\"^\\s*[-+]?[¥￥$]?[0-9][0-9,]*(\\.[0-9]+)?%?(\\t+\\s*[-+]?[¥￥$]?[0-9][0-9,]*(\\.[0-9]+)?%?)*\\s*$\");\n            return ne.All(x => num.IsMatch(x));\n        }\n    }\n}\n\n'@\n}\n$exe = Join-Path $dir 'calc_6ad2efdd17.exe'\nif (-not (Test-Path $exe)) {\n    $fw = Join-Path $env:WINDIR 'Microsoft.NET\\Framework64\\v4.0.30319'\n    if (-not (Test-Path (Join-Path $fw 'csc.exe'))) { $fw = Join-Path $env:WINDIR 'Microsoft.NET\\Framework\\v4.0.30319' }\n    if (-not (Test-Path (Join-Path $fw 'csc.exe'))) { throw '这台电脑上没有 .NET Framework 4 的 C# 编译器，计算器用不了' }\n    $src = Join-Path $dir 'calc.cs'\n    [IO.File]::WriteAllText($src, (Get-CalcSource), (New-Object Text.UTF8Encoding $true))\n    $refs = 'WPF\\PresentationFramework.dll', 'WPF\\PresentationCore.dll', 'WPF\\WindowsBase.dll', 'System.Xaml.dll', 'System.Web.Extensions.dll' | ForEach-Object { '/r:' + (Join-Path $fw $_) }\n    $tmp = Join-Path $dir 'calc_build.exe'\n    $log = & (Join-Path $fw 'csc.exe') /nologo /noconfig /target:winexe /optimize+ /utf8output \"/out:$tmp\" $refs /r:System.dll /r:System.Core.dll /r:System.Xml.dll $src 2>&1\n    if ($LASTEXITCODE -ne 0) { throw ('计算器编译失败：' + (($log | Where-Object { \"$_\" -match 'error' } | Select-Object -First 2) -join ' ')) }\n    Move-Item $tmp $exe -Force\n    # 旧版本编出来的 exe 顺手删掉（正在运行的删不掉，下次再删）\n    Get-ChildItem $dir -Filter 'calc_*.exe' | Where-Object { $_.FullName -ne $exe } | ForEach-Object { try { [IO.File]::Delete($_.FullName) } catch { } }\n}\n$psi = New-Object Diagnostics.ProcessStartInfo $exe, ('\"' + $bell + '\" \"' + $dir + '\"')\n$psi.UseShellExecute = $true\n[void][Diagnostics.Process]::Start($psi)"
    }
