    {
      "kind": "script",
      "name": "今天改的",
      "mode": "none",
      "icon": "v:clock",
      "icon_color": "#f0a43a",
      "value": "$exe = (Get-Process Everything, Everything64 -ErrorAction SilentlyContinue | Where-Object { $_.Path } | Select-Object -First 1).Path\nif (-not $exe) {\n  foreach ($p in \"$env:ProgramFiles\\Everything\\Everything.exe\", \"${env:ProgramFiles(x86)}\\Everything\\Everything.exe\", \"$env:ProgramFiles\\Everything 1.5a\\Everything64.exe\", \"$env:LOCALAPPDATA\\Programs\\Everything\\Everything.exe\") { if (Test-Path $p) { $exe = $p; break } }\n}\nif (-not $exe) {\n  $k = Get-ItemProperty 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Everything.exe' -ErrorAction SilentlyContinue\n  if ($k) { $exe = $k.'(default)' }\n}\nif (-not $exe) {\n  # 这台电脑还没装 Everything：另起一个窗口问一句，同意就从官网下载、核对 voidtools 的数字签名、安装（下面 $setup 就是那段脚本）\n  $setup = '# MB out · Everything 插件：这台电脑没装 Everything 时，问一句，然后从官网下载、核对数字签名、安装\n# -Check：只测下载和签名（不弹窗、不安装）\nparam([switch]$Check)\nAdd-Type -AssemblyName System.Windows.Forms, System.Drawing\n$title = ''MB out · Everything 插件''\nif (-not $Check) {\n  $r = [System.Windows.Forms.MessageBox]::Show(\"这台电脑还没装 Everything（免费的文件秒搜工具）。`n`n要现在从官网 voidtools.com 下载并安装吗？大约 2 MB，安装时 Windows 会请你确认一次。\", $title, ''YesNo'', ''Question'')\n  if ($r -ne ''Yes'') { exit }\n}\n# 一个小进度窗口\n$form = New-Object System.Windows.Forms.Form\n$form.Text = $title; $form.Width = 400; $form.Height = 130; $form.StartPosition = ''CenterScreen''; $form.TopMost = $true\n$form.FormBorderStyle = ''FixedDialog''; $form.MaximizeBox = $false; $form.MinimizeBox = $false\n$label = New-Object System.Windows.Forms.Label\n$label.Left = 18; $label.Top = 24; $label.Width = 360; $label.Height = 44; $label.Text = ''正在连接官网…''\n$form.Controls.Add($label)\nif (-not $Check) { $form.Show() }\nfunction Say([string]$s) { $label.Text = $s; [System.Windows.Forms.Application]::DoEvents() }\nfunction Done([string]$msg, [string]$icon) { $form.Close(); if (-not $Check) { [void][System.Windows.Forms.MessageBox]::Show($msg, $title, ''OK'', $icon) } else { $msg } }\n\n[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12\n$arch = if ([Environment]::Is64BitOperatingSystem) { ''x64'' } else { ''x86'' }\n$ver = ''1.4.1.1032''\n$wc = New-Object Net.WebClient\n# 最新版本号：看官网下载页\nforeach ($u in ''https://www.voidtools.com/downloads/'', ''http://voidtools.com/downloads/'') {\n  try { $h = $wc.DownloadString($u); $m = [regex]::Match($h, \"Everything-([\\d\\.]+)\\.$arch-Setup\\.exe\"); if ($m.Success) { $ver = $m.Groups[1].Value; break } } catch { }\n}\n$file = Join-Path $env:TEMP \"Everything-$ver.$arch-Setup.exe\"\n$ok = $false\nforeach ($u in \"https://www.voidtools.com/Everything-$ver.$arch-Setup.exe\", \"http://voidtools.com/Everything-$ver.$arch-Setup.exe\") {\n  try {\n    Remove-Item $file -Force -ErrorAction SilentlyContinue\n    $dl = New-Object Net.WebClient\n    $task = $dl.DownloadFileTaskAsync($u, $file)\n    while (-not $task.IsCompleted) {\n      $mb = 0; if (Test-Path $file) { $mb = [math]::Round((Get-Item $file).Length / 1MB, 1) }\n      Say \"正在下载 Everything $ver …  $mb MB\"\n      Start-Sleep -Milliseconds 120\n    }\n    if ($task.IsFaulted -or -not (Test-Path $file)) { continue }\n    # 只认 voidtools 签了名、签名有效的安装包（防止下载途中被换掉）\n    $sig = Get-AuthenticodeSignature $file\n    if ($sig.Status -eq ''Valid'' -and $sig.SignerCertificate.Subject -match ''voidtools'') { $ok = $true; break }\n    Remove-Item $file -Force -ErrorAction SilentlyContinue\n  } catch { }\n}\nif ($Check) { if ($ok) { \"OK $ver $((Get-Item $file).Length) $((Get-AuthenticodeSignature $file).SignerCertificate.Subject)\" } else { ''FAIL'' }; exit }\n\n$installed = $false\nif ($ok) {\n  Say ''正在安装（Windows 弹出确认时请点「是」）…''\n  try { $p = Start-Process $file -ArgumentList ''/S'' -Verb RunAs -Wait -PassThru; $installed = $true } catch { Done ''安装被取消了。想装的时候再点一下快捷面板上的 Everything 按钮就行。'' ''Information''; exit }\n} elseif (Get-Command winget -ErrorAction SilentlyContinue) {\n  Say ''官网下载不顺，改用 Windows 自带的 winget 安装…''\n  try { Start-Process winget -ArgumentList ''install --id voidtools.Everything -e --silent --accept-package-agreements --accept-source-agreements'' -Wait -WindowStyle Hidden; $installed = $true } catch { }\n}\n# 装好了没有：找 Everything.exe\n$exe = $null\nforeach ($p in \"$env:ProgramFiles\\Everything\\Everything.exe\", \"${env:ProgramFiles(x86)}\\Everything\\Everything.exe\", \"$env:LOCALAPPDATA\\Programs\\Everything\\Everything.exe\") { if (Test-Path $p) { $exe = $p; break } }\nif (-not $exe) {\n  Start-Process ''https://www.voidtools.com/downloads/''\n  Done \"没能自动下载安装（可能是网络连不上官网）。`n`n已经打开官网下载页：下载「安装版」后双击安装，装好后快捷面板上的 Everything 按钮就能用。\" ''Warning''\n  exit\n}\nif (-not (Get-Process Everything -ErrorAction SilentlyContinue)) { Start-Process $exe }\nRemove-Item $file -Force -ErrorAction SilentlyContinue\nDone \"Everything 装好了。`n`n第一次打开会花几秒钟给电脑里的文件建索引，之后点快捷面板上的按钮就能秒搜文件。\" ''Information''\n'\n  $tmp = Join-Path $env:TEMP 'mbout_everything_setup.ps1'\n  [IO.File]::WriteAllText($tmp, $setup, (New-Object Text.UTF8Encoding($true)))\n  Start-Process powershell.exe -ArgumentList ('-NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File \"' + $tmp + '\"') -WindowStyle Hidden\n  exit\n}\nfunction Q([string]$s) { '\"' + ($s -replace '\"', '') + '\"' }\nAdd-Type -Namespace MBout -Name Fg -MemberDefinition '[DllImport(\"user32.dll\")] public static extern IntPtr GetForegroundWindow();'\n$fg = [int64][MBout.Fg]::GetForegroundWindow()\n$win = $null\ntry { $win = @((New-Object -ComObject Shell.Application).Windows()) | Where-Object { try { [int64]$_.HWND -eq $fg } catch { $false } } | Select-Object -First 1 } catch { }\n$dir = $null\nif ($win) { try { $dir = $win.Document.Folder.Self.Path } catch { } }\n$a = '-s dm:today -sort \"Date Modified\" -sort-descending'\nif ($dir) { $a = '-path ' + (Q $dir) + ' ' + $a }\nStart-Process $exe -ArgumentList $a"
    },
    {
      "kind": "script",
      "name": "大文件",
      "mode": "none",
      "icon": "v:chart",
      "icon_color": "#f0a43a",
      "value": "$exe = (Get-Process Everything, Everything64 -ErrorAction SilentlyContinue | Where-Object { $_.Path } | Select-Object -First 1).Path\nif (-not $exe) {\n  foreach ($p in \"$env:ProgramFiles\\Everything\\Everything.exe\", \"${env:ProgramFiles(x86)}\\Everything\\Everything.exe\", \"$env:ProgramFiles\\Everything 1.5a\\Everything64.exe\", \"$env:LOCALAPPDATA\\Programs\\Everything\\Everything.exe\") { if (Test-Path $p) { $exe = $p; break } }\n}\nif (-not $exe) {\n  $k = Get-ItemProperty 'Registry::HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Everything.exe' -ErrorAction SilentlyContinue\n  if ($k) { $exe = $k.'(default)' }\n}\nif (-not $exe) {\n  # 这台电脑还没装 Everything：另起一个窗口问一句，同意就从官网下载、核对 voidtools 的数字签名、安装（下面 $setup 就是那段脚本）\n  $setup = '# MB out · Everything 插件：这台电脑没装 Everything 时，问一句，然后从官网下载、核对数字签名、安装\n# -Check：只测下载和签名（不弹窗、不安装）\nparam([switch]$Check)\nAdd-Type -AssemblyName System.Windows.Forms, System.Drawing\n$title = ''MB out · Everything 插件''\nif (-not $Check) {\n  $r = [System.Windows.Forms.MessageBox]::Show(\"这台电脑还没装 Everything（免费的文件秒搜工具）。`n`n要现在从官网 voidtools.com 下载并安装吗？大约 2 MB，安装时 Windows 会请你确认一次。\", $title, ''YesNo'', ''Question'')\n  if ($r -ne ''Yes'') { exit }\n}\n# 一个小进度窗口\n$form = New-Object System.Windows.Forms.Form\n$form.Text = $title; $form.Width = 400; $form.Height = 130; $form.StartPosition = ''CenterScreen''; $form.TopMost = $true\n$form.FormBorderStyle = ''FixedDialog''; $form.MaximizeBox = $false; $form.MinimizeBox = $false\n$label = New-Object System.Windows.Forms.Label\n$label.Left = 18; $label.Top = 24; $label.Width = 360; $label.Height = 44; $label.Text = ''正在连接官网…''\n$form.Controls.Add($label)\nif (-not $Check) { $form.Show() }\nfunction Say([string]$s) { $label.Text = $s; [System.Windows.Forms.Application]::DoEvents() }\nfunction Done([string]$msg, [string]$icon) { $form.Close(); if (-not $Check) { [void][System.Windows.Forms.MessageBox]::Show($msg, $title, ''OK'', $icon) } else { $msg } }\n\n[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12\n$arch = if ([Environment]::Is64BitOperatingSystem) { ''x64'' } else { ''x86'' }\n$ver = ''1.4.1.1032''\n$wc = New-Object Net.WebClient\n# 最新版本号：看官网下载页\nforeach ($u in ''https://www.voidtools.com/downloads/'', ''http://voidtools.com/downloads/'') {\n  try { $h = $wc.DownloadString($u); $m = [regex]::Match($h, \"Everything-([\\d\\.]+)\\.$arch-Setup\\.exe\"); if ($m.Success) { $ver = $m.Groups[1].Value; break } } catch { }\n}\n$file = Join-Path $env:TEMP \"Everything-$ver.$arch-Setup.exe\"\n$ok = $false\nforeach ($u in \"https://www.voidtools.com/Everything-$ver.$arch-Setup.exe\", \"http://voidtools.com/Everything-$ver.$arch-Setup.exe\") {\n  try {\n    Remove-Item $file -Force -ErrorAction SilentlyContinue\n    $dl = New-Object Net.WebClient\n    $task = $dl.DownloadFileTaskAsync($u, $file)\n    while (-not $task.IsCompleted) {\n      $mb = 0; if (Test-Path $file) { $mb = [math]::Round((Get-Item $file).Length / 1MB, 1) }\n      Say \"正在下载 Everything $ver …  $mb MB\"\n      Start-Sleep -Milliseconds 120\n    }\n    if ($task.IsFaulted -or -not (Test-Path $file)) { continue }\n    # 只认 voidtools 签了名、签名有效的安装包（防止下载途中被换掉）\n    $sig = Get-AuthenticodeSignature $file\n    if ($sig.Status -eq ''Valid'' -and $sig.SignerCertificate.Subject -match ''voidtools'') { $ok = $true; break }\n    Remove-Item $file -Force -ErrorAction SilentlyContinue\n  } catch { }\n}\nif ($Check) { if ($ok) { \"OK $ver $((Get-Item $file).Length) $((Get-AuthenticodeSignature $file).SignerCertificate.Subject)\" } else { ''FAIL'' }; exit }\n\n$installed = $false\nif ($ok) {\n  Say ''正在安装（Windows 弹出确认时请点「是」）…''\n  try { $p = Start-Process $file -ArgumentList ''/S'' -Verb RunAs -Wait -PassThru; $installed = $true } catch { Done ''安装被取消了。想装的时候再点一下快捷面板上的 Everything 按钮就行。'' ''Information''; exit }\n} elseif (Get-Command winget -ErrorAction SilentlyContinue) {\n  Say ''官网下载不顺，改用 Windows 自带的 winget 安装…''\n  try { Start-Process winget -ArgumentList ''install --id voidtools.Everything -e --silent --accept-package-agreements --accept-source-agreements'' -Wait -WindowStyle Hidden; $installed = $true } catch { }\n}\n# 装好了没有：找 Everything.exe\n$exe = $null\nforeach ($p in \"$env:ProgramFiles\\Everything\\Everything.exe\", \"${env:ProgramFiles(x86)}\\Everything\\Everything.exe\", \"$env:LOCALAPPDATA\\Programs\\Everything\\Everything.exe\") { if (Test-Path $p) { $exe = $p; break } }\nif (-not $exe) {\n  Start-Process ''https://www.voidtools.com/downloads/''\n  Done \"没能自动下载安装（可能是网络连不上官网）。`n`n已经打开官网下载页：下载「安装版」后双击安装，装好后快捷面板上的 Everything 按钮就能用。\" ''Warning''\n  exit\n}\nif (-not (Get-Process Everything -ErrorAction SilentlyContinue)) { Start-Process $exe }\nRemove-Item $file -Force -ErrorAction SilentlyContinue\nDone \"Everything 装好了。`n`n第一次打开会花几秒钟给电脑里的文件建索引，之后点快捷面板上的按钮就能秒搜文件。\" ''Information''\n'\n  $tmp = Join-Path $env:TEMP 'mbout_everything_setup.ps1'\n  [IO.File]::WriteAllText($tmp, $setup, (New-Object Text.UTF8Encoding($true)))\n  Start-Process powershell.exe -ArgumentList ('-NoProfile -ExecutionPolicy Bypass -STA -WindowStyle Hidden -File \"' + $tmp + '\"') -WindowStyle Hidden\n  exit\n}\nfunction Q([string]$s) { '\"' + ($s -replace '\"', '') + '\"' }\nAdd-Type -Namespace MBout -Name Fg -MemberDefinition '[DllImport(\"user32.dll\")] public static extern IntPtr GetForegroundWindow();'\n$fg = [int64][MBout.Fg]::GetForegroundWindow()\n$win = $null\ntry { $win = @((New-Object -ComObject Shell.Application).Windows()) | Where-Object { try { [int64]$_.HWND -eq $fg } catch { $false } } | Select-Object -First 1 } catch { }\n$dir = $null\nif ($win) { try { $dir = $win.Document.Folder.Self.Path } catch { } }\n$a = '-s size:>500mb -sort \"Size\" -sort-descending'\nif ($dir) { $a = '-path ' + (Q $dir) + ' ' + $a }\nStart-Process $exe -ArgumentList $a"
    }
  ]
}