{
  "mbout_plugin": 1,
  "id": "mbout.ocr-excel",
  "name": "截图转 Excel",
  "version": "1.0",
  "author": "MB out",
  "description": "框选屏幕上的表格，自动认字、按位置分好行和列，存成 Excel 文件并打开。识别用 MB out 自带的离线识别，不联网；文件存在「文档\\MB out 截图表格」。识别结果可能有误，金额等数字请核对后再用。",
  "items": [
    {
      "kind": "script",
      "name": "截图转 Excel",
      "value": "# 找 MB out.exe：先看是谁启动了这个脚本，找不到再找正在运行的 MB out\n$exe = $null\ntry {\n  $pp = (Get-CimInstance Win32_Process -Filter \"ProcessId=$PID\").ParentProcessId\n  $exe = (Get-Process -Id $pp -ErrorAction SilentlyContinue).Path\n} catch { }\nif (-not $exe -or -not (Test-Path -LiteralPath (Join-Path (Split-Path $exe) 'ocr\\det.onnx'))) {\n  $exe = (Get-Process 'MB out' -ErrorAction SilentlyContinue | Where-Object { $_.Path } | Select-Object -First 1).Path\n}\nif (-not $exe) { throw '没找到正在运行的 MB out' }\n\n$src = @\"\n// 「截图转 Excel」插件的核心（make_ocr_excel.ps1 把它嵌进插件脚本，脚本里用 Add-Type 编译，C# 5 语法）\r\n// 流程：框选屏幕一块 → 用 MB out 自带的识别模型认字（要每块字的位置）→ 按位置排成行和列 → 写成 .xlsx\r\n// 识别借用 MB out.exe 里的 OcrEngine：Create 是公开的，Detect / RecognizeBatch 是内部方法，用反射调（3.0 起都有）\r\nusing System;\r\nusing System.Collections;\r\nusing System.Collections.Generic;\r\nusing System.Drawing;\r\nusing System.Drawing.Drawing2D;\r\nusing System.Drawing.Imaging;\r\nusing System.IO;\r\nusing System.IO.Compression;\r\nusing System.Linq;\r\nusing System.Reflection;\r\nusing System.Runtime.InteropServices;\r\nusing System.Security;\r\nusing System.Text;\r\nusing System.Text.RegularExpressions;\r\nusing System.Threading.Tasks;\r\nusing System.Windows.Forms;\r\n\r\nnamespace MbOutPlugin\r\n{\r\n    public class Cell\r\n    {\r\n        public double X, Y, W, H;\r\n        public string Text;\r\n        public double R { get { return X + W; } }\r\n    }\r\n\r\n    public static class OcrTable\r\n    {\r\n        [DllImport(\"user32.dll\")] static extern bool SetProcessDPIAware();\r\n        [DllImport(\"user32.dll\")] static extern bool SetProcessDpiAwarenessContext(IntPtr value);\r\n        [DllImport(\"kernel32.dll\", CharSet = CharSet.Unicode, SetLastError = true)]\r\n        static extern IntPtr LoadLibraryEx(string path, IntPtr file, uint flags);\r\n\r\n        public static int LastRows, LastCols;\r\n        public static string Timing = \"\";\r\n\r\n        /// <summary>框选 → 识别 → 存成 xlsx，返回文件路径；没框选返回 null</summary>\r\n        public static string Run(string exe, string outDir, int seconds)\r\n        {\r\n            DpiAware();\r\n            var img = Pick(seconds);\r\n            if (img == null) return null;\r\n            using (img) return Convert(exe, img, outDir);\r\n        }\r\n\r\n        public static string Convert(string exe, Bitmap img, string outDir)\r\n        {\r\n            var t = Read(exe, img);\r\n            if (t.Count == 0) throw new Exception(\"框里没认出文字\");\r\n            LastRows = t.Count;\r\n            LastCols = t.Count == 0 ? 0 : t.Max(r => r.Count);\r\n            Directory.CreateDirectory(outDir);\r\n            var path = Path.Combine(outDir, \"表格_\" + DateTime.Now.ToString(\"yyyyMMdd_HHmmss\") + \".xlsx\");\r\n            SaveXlsx(t, path);\r\n            return path;\r\n        }\r\n\r\n        // 按真实像素算坐标（高分屏缩放下框选和截图才对得上）\r\n        public static void DpiAware()\r\n        {\r\n            try { if (SetProcessDpiAwarenessContext(new IntPtr(-4))) return; } catch { }\r\n            try { SetProcessDPIAware(); } catch { }\r\n        }\r\n\r\n        // ------------------------------------------------------------------\r\n        // 框选\r\n        // ------------------------------------------------------------------\r\n        public static Bitmap Pick(int seconds)\r\n        {\r\n            var vs = SystemInformation.VirtualScreen;\r\n            var screen = new Bitmap(vs.Width, vs.Height, PixelFormat.Format24bppRgb);\r\n            using (var g = Graphics.FromImage(screen)) g.CopyFromScreen(vs.Left, vs.Top, 0, 0, vs.Size);\r\n            Rectangle sel;\r\n            using (var f = new PickForm(screen, vs, seconds)) { f.ShowDialog(); sel = f.Sel; }\r\n            if (sel.Width < 8 || sel.Height < 8) { screen.Dispose(); return null; }\r\n            var crop = screen.Clone(sel, PixelFormat.Format24bppRgb);\r\n            screen.Dispose();\r\n            return crop;\r\n        }\r\n\r\n        class PickForm : Form\r\n        {\r\n            readonly Bitmap _shot;\r\n            readonly Rectangle _hint;\r\n            readonly Timer _timer;\r\n            Point _a;\r\n            bool _down;\r\n            int _left;\r\n            public Rectangle Sel;\r\n\r\n            public PickForm(Bitmap shot, Rectangle vs, int seconds)\r\n            {\r\n                _shot = shot;\r\n                _left = seconds;\r\n                FormBorderStyle = FormBorderStyle.None;\r\n                StartPosition = FormStartPosition.Manual;\r\n                Bounds = vs;\r\n                TopMost = true;\r\n                ShowInTaskbar = false;\r\n                DoubleBuffered = true;\r\n                KeyPreview = true;\r\n                Cursor = Cursors.Cross;\r\n                // 提示条放在主屏幕顶部中间\r\n                var p = Screen.PrimaryScreen.Bounds;\r\n                int hw = Math.Min(p.Width - 40, 640), hh = 44;\r\n                _hint = new Rectangle(p.Left - vs.Left + (p.Width - hw) / 2, p.Top - vs.Top + 24, hw, hh);\r\n                _timer = new Timer { Interval = 1000 };\r\n                _timer.Tick += (s, e) =>\r\n                {\r\n                    _left--;\r\n                    if (_left <= 0 && !_down) { Sel = Rectangle.Empty; Close(); }\r\n                    else Invalidate(_hint);\r\n                };\r\n                Shown += (s, e) => { Activate(); _timer.Start(); };\r\n                FormClosed += (s, e) => _timer.Dispose();\r\n                KeyDown += (s, e) => { if (e.KeyCode == Keys.Escape) { Sel = Rectangle.Empty; Close(); } };\r\n                MouseDown += (s, e) =>\r\n                {\r\n                    if (e.Button == MouseButtons.Right) { Sel = Rectangle.Empty; Close(); return; }\r\n                    if (e.Button != MouseButtons.Left) return;\r\n                    _down = true;\r\n                    _a = e.Location;\r\n                    Sel = new Rectangle(e.Location, Size.Empty);\r\n                };\r\n                MouseMove += (s, e) =>\r\n                {\r\n                    if (!_down) return;\r\n                    var old = Sel;\r\n                    Sel = Norm(_a, e.Location);\r\n                    var dirty = Rectangle.Union(old, Sel);\r\n                    dirty.Inflate(6, 6);\r\n                    dirty.Y -= 30; dirty.Height += 30; // 尺寸标签在框上面\r\n                    Invalidate(dirty);\r\n                    Invalidate(_hint);\r\n                };\r\n                MouseUp += (s, e) =>\r\n                {\r\n                    if (!_down || e.Button != MouseButtons.Left) return;\r\n                    _down = false;\r\n                    Sel = Norm(_a, e.Location);\r\n                    Close();\r\n                };\r\n            }\r\n\r\n            static Rectangle Norm(Point a, Point b)\r\n            {\r\n                return Rectangle.FromLTRB(Math.Min(a.X, b.X), Math.Min(a.Y, b.Y), Math.Max(a.X, b.X), Math.Max(a.Y, b.Y));\r\n            }\r\n\r\n            protected override void OnPaint(PaintEventArgs e)\r\n            {\r\n                var g = e.Graphics;\r\n                g.DrawImage(_shot, e.ClipRectangle, e.ClipRectangle, GraphicsUnit.Pixel);\r\n                bool has = Sel.Width > 0 && Sel.Height > 0;\r\n                using (var dim = new SolidBrush(Color.FromArgb(110, 0, 0, 0)))\r\n                using (var region = new Region(ClientRectangle))\r\n                {\r\n                    if (has) region.Exclude(Sel);\r\n                    g.FillRegion(dim, region);\r\n                }\r\n                g.SmoothingMode = SmoothingMode.AntiAlias;\r\n                g.TextRenderingHint = System.Drawing.Text.TextRenderingHint.ClearTypeGridFit;\r\n                if (has)\r\n                {\r\n                    using (var pen = new Pen(Color.FromArgb(34, 160, 107), 2)) g.DrawRectangle(pen, Sel);\r\n                    using (var f = new Font(\"Microsoft YaHei UI\", 9f))\r\n                    {\r\n                        var s = Sel.Width + \" × \" + Sel.Height;\r\n                        var sz = g.MeasureString(s, f);\r\n                        var r = new RectangleF(Sel.Left, Math.Max(0, Sel.Top - sz.Height - 6), sz.Width + 8, sz.Height + 2);\r\n                        using (var bg = new SolidBrush(Color.FromArgb(200, 20, 20, 20))) g.FillRectangle(bg, r);\r\n                        g.DrawString(s, f, Brushes.White, r.Left + 4, r.Top + 1);\r\n                    }\r\n                }\r\n                using (var path = Round(_hint, 10))\r\n                using (var bg = new SolidBrush(Color.FromArgb(225, 28, 30, 34)))\r\n                using (var f = new Font(\"Microsoft YaHei UI\", 10.5f))\r\n                using (var sf = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center })\r\n                {\r\n                    g.FillPath(bg, path);\r\n                    g.DrawString(\"框选要转成 Excel 的表格　　右键或 Esc 取消（\" + Math.Max(0, _left) + \" 秒）\", f, Brushes.White, _hint, sf);\r\n                }\r\n            }\r\n\r\n            static GraphicsPath Round(Rectangle r, int d)\r\n            {\r\n                var p = new GraphicsPath();\r\n                p.AddArc(r.Left, r.Top, d * 2, d * 2, 180, 90);\r\n                p.AddArc(r.Right - d * 2, r.Top, d * 2, d * 2, 270, 90);\r\n                p.AddArc(r.Right - d * 2, r.Bottom - d * 2, d * 2, d * 2, 0, 90);\r\n                p.AddArc(r.Left, r.Bottom - d * 2, d * 2, d * 2, 90, 90);\r\n                p.CloseFigure();\r\n                return p;\r\n            }\r\n        }\r\n\r\n        // ------------------------------------------------------------------\r\n        // 识别（用 MB out 程序目录 ocr\\ 里的模型和运行库）\r\n        // ------------------------------------------------------------------\r\n        static readonly string[] Managed = { \"Microsoft.ML.OnnxRuntime\", \"System.Memory\", \"System.Buffers\", \"System.Runtime.CompilerServices.Unsafe\", \"System.Numerics.Vectors\" };\r\n        static string _ocrDir;\r\n        static bool _hooked;\r\n\r\n        static Assembly Resolve(object sender, ResolveEventArgs e)\r\n        {\r\n            var name = new AssemblyName(e.Name).Name;\r\n            if (_ocrDir == null || Array.IndexOf(Managed, name) < 0) return null;\r\n            var p = Path.Combine(_ocrDir, name + \".dll\");\r\n            try { return File.Exists(p) ? Assembly.Load(File.ReadAllBytes(p)) : null; } catch { return null; }\r\n        }\r\n\r\n        // 在 PowerShell 的主线程上第一次碰 ONNX Runtime 要卡十几秒（单独的程序里不到 0.3 秒），换个线程跑就正常\r\n        public static List<List<string>> Read(string exe, Bitmap img)\r\n        {\r\n            List<List<string>> r = null;\r\n            Exception err = null;\r\n            var t = new System.Threading.Thread(() => { try { r = ReadHere(exe, img); } catch (Exception e) { err = e; } });\r\n            t.Start();\r\n            t.Join();\r\n            if (err != null) throw err;\r\n            return r;\r\n        }\r\n\r\n        public static List<Cell> LastCells = new List<Cell>();\r\n        public static List<string> LastSlots = new List<string>();\r\n        public static List<string> LastHeader = new List<string>();\r\n\r\n        static List<List<string>> ReadHere(string exe, Bitmap img)\r\n        {\r\n            var dir = Path.Combine(Path.GetDirectoryName(exe), \"ocr\");\r\n            if (!File.Exists(Path.Combine(dir, \"det.onnx\")) || !File.Exists(Path.Combine(dir, \"onnxruntime.dll\")))\r\n                throw new Exception(\"没找到 MB out 的识别文字组件（程序目录下的 ocr 文件夹）\");\r\n            _ocrDir = dir;\r\n            if (!_hooked) { _hooked = true; AppDomain.CurrentDomain.AssemblyResolve += Resolve; }\r\n            if (LoadLibraryEx(Path.Combine(dir, \"onnxruntime.dll\"), IntPtr.Zero, 0x8) == IntPtr.Zero)\r\n                throw new Exception(\"识别文字组件加载失败（错误 \" + Marshal.GetLastWin32Error() + \"）\");\r\n            var sw = System.Diagnostics.Stopwatch.StartNew();\r\n            var asm = Assembly.Load(File.ReadAllBytes(exe));\r\n            Timing = \"载入 \" + sw.ElapsedMilliseconds;\r\n            var tEng = asm.GetType(\"SidebarPlan.OcrEngine\");\r\n            var tPx = asm.GetType(\"SidebarPlan.Pixels\");\r\n            const BindingFlags inner = BindingFlags.NonPublic | BindingFlags.Instance;\r\n            var create = tEng == null ? null : tEng.GetMethod(\"Create\", BindingFlags.Public | BindingFlags.Static);\r\n            var det = tEng == null ? null : tEng.GetMethod(\"Detect\", inner);\r\n            var rec = tEng == null ? null : tEng.GetMethod(\"RecognizeBatch\", inner);\r\n            if (tPx == null || create == null || det == null || rec == null) throw new Exception(\"这个 MB out 版本用不了本插件，请更新到 3.0 或以上\");\r\n            try\r\n            {\r\n                var bgr = Bgr(img);\r\n                var px = Activator.CreateInstance(tPx, img.Width, img.Height, bgr);\r\n                using (var eng = (IDisposable)create.Invoke(null, new object[] { dir }))\r\n                {\r\n                    Timing += \" / 模型 \" + sw.ElapsedMilliseconds;\r\n                    var boxes = (IList)det.Invoke(eng, new[] { px });\r\n                    Timing += \" / 找字 \" + sw.ElapsedMilliseconds;\r\n                    var listType = boxes.GetType();\r\n                    var all = boxes.Cast<object>().ToList();\r\n                    // 每块单独认，几块同时跑（和 MB out 自己的做法一样）\r\n                    Parallel.ForEach(all, new ParallelOptions { MaxDegreeOfParallelism = Math.Max(1, Math.Min(4, Environment.ProcessorCount / 4)) }, b =>\r\n                    {\r\n                        var one = (IList)Activator.CreateInstance(listType);\r\n                        one.Add(b);\r\n                        rec.Invoke(eng, new object[] { px, one });\r\n                    });\r\n                    Timing += \" / 认字 \" + sw.ElapsedMilliseconds + \" ms（\" + all.Count + \" 块）\";\r\n                    var boxType = listType.GetGenericArguments()[0];\r\n                    // 两三行高的块切成几行分别认，再接起来（同一个格子里折的行）\r\n                    Action<object, byte[], int, int, List<object>> byLines = (pxs, bytes, iw, ih, list) =>\r\n                    {\r\n                        if (list.Count == 0) return;\r\n                        double u = Median(list.Select(b => (double)boxType.GetField(\"H\").GetValue(b)));\r\n                        Parallel.ForEach(list.Where(b => (double)boxType.GetField(\"H\").GetValue(b) > 1.4 * u).ToList(), new ParallelOptions { MaxDegreeOfParallelism = 4 }, b =>\r\n                        {\r\n                            var c = new Cell { X = (double)boxType.GetField(\"X\").GetValue(b), Y = (double)boxType.GetField(\"Y\").GetValue(b), W = (double)boxType.GetField(\"W\").GetValue(b), H = (double)boxType.GetField(\"H\").GetValue(b) };\r\n                            var bands = LineBands(bytes, iw, ih, c, u);\r\n                            if (bands.Count < 2) return;\r\n                            var sb = new StringBuilder();\r\n                            foreach (var band in bands)\r\n                            {\r\n                                var bb = Activator.CreateInstance(boxType, true);\r\n                                boxType.GetField(\"X\").SetValue(bb, c.X); boxType.GetField(\"W\").SetValue(bb, c.W);\r\n                                boxType.GetField(\"Y\").SetValue(bb, (double)band[0]); boxType.GetField(\"H\").SetValue(bb, (double)(band[1] - band[0]));\r\n                                var one = (IList)Activator.CreateInstance(listType);\r\n                                one.Add(bb);\r\n                                rec.Invoke(eng, new object[] { pxs, one });\r\n                                var t = ((string)boxType.GetField(\"Text\").GetValue(bb) ?? \"\").Trim();\r\n                                if (t.Length == 0) continue;\r\n                                if (sb.Length > 0 && char.IsLetterOrDigit(sb[sb.Length - 1]) && sb[sb.Length - 1] < 128 && char.IsLetterOrDigit(t[0]) && t[0] < 128) sb.Append(' ');\r\n                                sb.Append(t);\r\n                            }\r\n                            if (sb.Length > 0) boxType.GetField(\"Text\").SetValue(b, sb.ToString());\r\n                        });\r\n                    };\r\n                    byLines(px, bgr, img.Width, img.Height, all);\r\n                    Func<object, Cell> toCell = b => new Cell\r\n                    {\r\n                        X = (double)boxType.GetField(\"X\").GetValue(b), Y = (double)boxType.GetField(\"Y\").GetValue(b),\r\n                        W = (double)boxType.GetField(\"W\").GetValue(b), H = (double)boxType.GetField(\"H\").GetValue(b),\r\n                        Text = ((string)boxType.GetField(\"Text\").GetValue(b) ?? \"\").Trim(),\r\n                    };\r\n                    var cells = all.Select(toCell).Where(c => c.Text.Length > 0 && !Junk(c.Text)).ToList();\r\n                    if (cells.Count == 0) return new List<List<string>>();\r\n\r\n                    // 表格线。窄格子里的字紧贴着线时，找字会把线和字连成一片漏掉（「辅助编码」「主材」）：\r\n                    // 把线抹成底色再找一遍，只认第一遍没找到的\r\n                    double unit = Median(cells.Select(c => c.H));\r\n                    bool[] hl, vl;\r\n                    FindLines(bgr, img.Width, img.Height, unit, out hl, out vl);\r\n                    if (hl.Any(v => v) || vl.Any(v => v))\r\n                    {\r\n                        // 抹了线的图再放大（最多 2 倍，找字最多看 2240 像素宽，放大不到 1.3 倍就不放），小字、粗体挤在窄格子里也找得到\r\n                        double f = Math.Min(2, 2240.0 / Math.Max(img.Width, img.Height));\r\n                        if (f < 1.3) f = 1;\r\n                        int w2 = (int)(img.Width * f), h2 = (int)(img.Height * f);\r\n                        var clean = EraseLines(bgr, hl, vl, img.Width, img.Height);\r\n                        var big = f == 1 ? clean : Scale(clean, img.Width, img.Height, w2, h2);\r\n                        var px2 = Activator.CreateInstance(tPx, w2, h2, big);\r\n                        Func<object, Cell> back = b => { var c = toCell(b); c.X /= f; c.Y /= f; c.W /= f; c.H /= f; return c; };\r\n                        // 只补「整格漏认」：新找到的字四周要有表格线围成一格，而且第一遍在这一格里一个字都没找到。\r\n                        // 图模糊时第二遍会在有字的格子里多找出碎片、重复，这样都挡掉\r\n                        var known = all.Select(toCell).Where(c => c.Text.Length > 0).ToList();\r\n                        int iw = img.Width, ih = img.Height;\r\n                        // 只补表头：数据从第一个「同一横排有两个数字」的地方开始，往下的漏字交给后面的空格补认\r\n                        var nums = known.Where(c => Parse(c.Text) != null).ToList();\r\n                        double bodyTop = nums.Where(c => nums.Any(o => o != c && Math.Min(T1(o), T1(c)) > Math.Max(T0(o), T0(c)))).Select(c => c.Y).DefaultIfEmpty(ih).Min();\r\n                        Func<Cell, bool> emptyCell = c =>\r\n                        {\r\n                            int y = Math.Max(0, Math.Min(ih - 1, (int)(c.Y + c.H / 2))), x = Math.Max(0, Math.Min(iw - 1, (int)(c.X + c.W / 2))), reach = (int)(4 * unit);\r\n                            Func<int, int, bool> v = (xx, yy) => { for (int d = -2; d <= 2; d++) { int q = yy + d; if (q >= 0 && q < ih && vl[q * iw + xx]) return true; } return false; };\r\n                            Func<int, int, bool> hh = (xx, yy) => { for (int d = -2; d <= 2; d++) { int q = xx + d; if (q >= 0 && q < iw && hl[yy * iw + q]) return true; } return false; };\r\n                            int lx = -1, rx = -1, ty = -1, by = -1;\r\n                            for (int xx = (int)L(c); xx >= Math.Max(0, (int)L(c) - reach); xx--) if (v(xx, y)) { lx = xx; break; }\r\n                            for (int xx = (int)Rr(c); xx < Math.Min(iw, (int)Rr(c) + reach); xx++) if (v(xx, y)) { rx = xx; break; }\r\n                            for (int yy = y; yy >= Math.Max(0, y - reach); yy--) if (hh(x, yy)) { ty = yy; break; }\r\n                            for (int yy = y; yy < Math.Min(ih, y + reach); yy++) if (hh(x, yy)) { by = yy; break; }\r\n                            if (lx < 0 || rx < 0 || ty < 0 || by < 0) return false;\r\n                            return !known.Any(o => { double ox = o.X + o.W / 2, oy = o.Y + o.H / 2; return ox > lx && ox < rx && oy > ty && oy < by; });\r\n                        };\r\n                        var more = ((IList)det.Invoke(eng, new[] { px2 })).Cast<object>().Where(b => { var c = back(b); return c.Y + c.H / 2 < bodyTop && emptyCell(c); }).ToList();\r\n                        Parallel.ForEach(more, new ParallelOptions { MaxDegreeOfParallelism = 4 }, b =>\r\n                        {\r\n                            var one = (IList)Activator.CreateInstance(listType);\r\n                            one.Add(b);\r\n                            rec.Invoke(eng, new object[] { px2, one });\r\n                        });\r\n                        byLines(px2, big, w2, h2, more);\r\n                        cells.AddRange(more.Select(back).Where(c => c.Text.Length > 0 && !Junk(c.Text)));\r\n                        Timing += \" / 抹线再找 \" + sw.ElapsedMilliseconds + \" ms（多找到 \" + more.Count + \" 块）\";\r\n                    }\r\n                    LastCells = cells;\r\n                    var g = Layout(cells, hl, vl, img.Width, img.Height);\r\n\r\n                    // 空格子再看一眼：单独一个「0」「-」这样的小字找字时常被漏掉，格子里有墨迹就单独认一次\r\n                    var slots = Blanks(g, bgr, img.Width, img.Height);\r\n                    Parallel.ForEach(slots, new ParallelOptions { MaxDegreeOfParallelism = 4 }, s =>\r\n                    {\r\n                        var b = Activator.CreateInstance(boxType, true);\r\n                        boxType.GetField(\"X\").SetValue(b, (double)s.Area.X); boxType.GetField(\"Y\").SetValue(b, (double)s.Area.Y);\r\n                        boxType.GetField(\"W\").SetValue(b, (double)s.Area.Width); boxType.GetField(\"H\").SetValue(b, (double)s.Area.Height);\r\n                        var one = (IList)Activator.CreateInstance(listType);\r\n                        one.Add(b);\r\n                        rec.Invoke(eng, new object[] { px, one });\r\n                        var text = ((string)boxType.GetField(\"Text\").GetValue(b) ?? \"\").Trim();\r\n                        if (Plausible(s, text)) s.Text = text;\r\n                    });\r\n                    foreach (var s in slots) if (s.Text != null) g.T[s.Row][s.Col] = s.Text;\r\n                    LastSlots = slots.Select(s => \"第 \" + (s.Row + 1) + \" 行第 \" + (s.Col + 1) + \" 列 \" + s.Area + \" → \" + (s.Text ?? \"（没用）\")).ToList();\r\n                    CleanNumbers(g);\r\n                    Header(g, bgr, img.Width, img.Height);\r\n                    DropEmptyColumns(g);\r\n                    Timing += \" / 补空格 \" + sw.ElapsedMilliseconds + \" ms（看了 \" + slots.Count + \" 格，补上 \" + slots.Count(s => s.Text != null) + \" 格）\";\r\n                    return g.T;\r\n                }\r\n            }\r\n            catch (Exception e)\r\n            {\r\n                var b = e.GetBaseException();\r\n                throw new Exception(\"识别出错：\" + b.Message, b);\r\n            }\r\n        }\r\n\r\n        static byte[] Bgr(Bitmap img)\r\n        {\r\n            var d = img.LockBits(new Rectangle(0, 0, img.Width, img.Height), ImageLockMode.ReadOnly, PixelFormat.Format24bppRgb);\r\n            try\r\n            {\r\n                int w3 = img.Width * 3;\r\n                var buf = new byte[w3 * img.Height];\r\n                for (int y = 0; y < img.Height; y++) Marshal.Copy(new IntPtr(d.Scan0.ToInt64() + (long)y * d.Stride), buf, y * w3, w3);\r\n                return buf;\r\n            }\r\n            finally { img.UnlockBits(d); }\r\n        }\r\n\r\n        // ------------------------------------------------------------------\r\n        // 排表格：先按上下位置分行，再按左右位置分列\r\n        // ------------------------------------------------------------------\r\n        // 检测框比字本身往外扩了一圈：比位置时用缩回去的范围（左右各缩约 0.3 个框高，上下各缩 0.2）\r\n        static double L(Cell c) { return c.X + Math.Min(0.3 * c.H, 0.25 * c.W); }\r\n        static double Rr(Cell c) { return c.R - Math.Min(0.3 * c.H, 0.25 * c.W); }\r\n        static double T0(Cell c) { return c.Y + 0.2 * c.H; }\r\n        static double T1(Cell c) { return c.Y + 0.8 * c.H; }\r\n        static double Overlap(Cell a, Cell b) { return Math.Min(Rr(a), Rr(b)) - Math.Max(L(a), L(b)); }\r\n        static double Median(IEnumerable<double> v) { var s = v.OrderBy(x => x).ToList(); return s[s.Count / 2]; }\r\n        // 字号用「每个字多宽」估（框高对字号不敏感）：汉字算 2 份、其他算 1 份，一份半个字宽\r\n        static double Size(Cell c) { return 2 * (Rr(c) - L(c)) / Math.Max(1, Width(c.Text)); }\r\n\r\n        class Grid\r\n        {\r\n            public List<List<Cell>> Rows;   // 每行的字块（已按左右排好）\r\n            public List<double[]> Cols;     // 每列的左右范围\r\n            public List<List<string>> T;    // 排好的表格\r\n            public int Body;                // 第一行数据（有两个以上数字的行）；它上面是表头。没有数字行时是 0\r\n            public bool[] HL, VL;           // 表格线（横、竖），没有图时是 null\r\n            public int W, H;\r\n        }\r\n\r\n        public static List<List<string>> Table(List<Cell> cells)\r\n        {\r\n            var g = Layout(cells);\r\n            Header(g, null, 0, 0);\r\n            DropEmptyColumns(g);\r\n            return g.T;\r\n        }\r\n\r\n        static Grid Layout(List<Cell> cells, bool[] hl = null, bool[] vl = null, int w = 0, int h = 0)\r\n        {\r\n            // 分行：和这一行大多数字块（中位数）上下重叠超过一半算同一行。\r\n            // 用整行的外框会一行接一行连起来（多层表头每层都很矮，会挤成一行）\r\n            var rows = new List<List<Cell>>();\r\n            foreach (var c in cells.OrderBy(x => x.Y + x.H / 2))\r\n            {\r\n                List<Cell> hit = null;\r\n                double hv = 0;\r\n                foreach (var r in rows)\r\n                {\r\n                    double top = Median(r.Select(T0)), bot = Median(r.Select(T1));\r\n                    double ov = Math.Min(bot, T1(c)) - Math.Max(top, T0(c));\r\n                    if (ov > 0.5 * Math.Min(T1(c) - T0(c), bot - top) && ov > hv) { hit = r; hv = ov; }\r\n                }\r\n                if (hit == null) rows.Add(new List<Cell> { c }); else hit.Add(c);\r\n            }\r\n            // 两块中间有竖线的不接（它们在两个格子里，只是挨得近）\r\n            Func<Cell, Cell, bool> lineBetween = (a, b) =>\r\n            {\r\n                if (vl == null) return false;\r\n                int y = Math.Max(0, Math.Min(h - 1, (int)((a.Y + a.H / 2 + b.Y + b.H / 2) / 2)));\r\n                for (int x = Math.Max(0, (int)L(a)); x <= Math.Min(w - 1, (int)Rr(b)); x++)\r\n                    if (x > Rr(a) - 2 && x < L(b) + 2 && vl[y * w + x]) return true;\r\n                return false;\r\n            };\r\n            rows = rows.OrderBy(r => Median(r.Select(T0))).Select(r => MergeClose(r.OrderBy(x => x.X).ToList(), lineBetween)).ToList();\r\n\r\n            // 表头在哪结束：第一行有两个以上数字的就是数据开头。离第一个多格行太远（中间夹了很多纯文字行）就不当有表头，全按数据排\r\n            int body = rows.FindIndex(r => r.Count(c => Parse(c.Text) != null) >= 2), firstMulti = rows.FindIndex(r => r.Count >= 2);\r\n            if (body < 0 || firstMulti < 0 || body - firstMulti > 6) body = 0;\r\n            // 数据里只有一个单字独占一行的：压在表上的水印（「第 1 页」的「1」认成「-」），不要\r\n            for (int i = rows.Count - 1; i > body; i--)\r\n                if (rows[i].Count == 1 && rows[i][0].Text.Trim().Length <= 1) rows.RemoveAt(i);\r\n\r\n            // 分列：只看数据行（表头里合并单元格的标题居中跨在两列中间，会自己成一列）；\r\n            // 跨了别的行两个格子的不参与定列，其余格子左右范围连在一起的算一列\r\n            var basis = new List<Cell>();\r\n            for (int i = body; i < rows.Count; i++)\r\n                foreach (var c in rows[i])\r\n                {\r\n                    bool spans = false;\r\n                    for (int j = 0; j < rows.Count && !spans; j++)\r\n                        if (j != i && rows[j].Count(o => Overlap(c, o) > 0) >= 2) spans = true;\r\n                    if (!spans) basis.Add(c);\r\n                }\r\n            if (basis.Count == 0) basis = rows.SelectMany(r => r).ToList();\r\n            var cols = new List<double[]>();\r\n            foreach (var c in basis.OrderBy(L))\r\n            {\r\n                if (cols.Count > 0 && L(c) < cols[cols.Count - 1][1]) cols[cols.Count - 1][1] = Math.Max(cols[cols.Count - 1][1], Rr(c));\r\n                else cols.Add(new[] { L(c), Rr(c) });\r\n            }\r\n\r\n            var g = new Grid { Rows = rows, Cols = cols, T = new List<List<string>>(), Body = body, HL = hl, VL = vl, W = w, H = h };\r\n            for (int i = 0; i < rows.Count; i++)\r\n            {\r\n                var line = new string[cols.Count];\r\n                foreach (var c in rows[i])\r\n                {\r\n                    var ks = Columns(c, cols);\r\n                    var parts = ks.Count >= 2 && rows[i].Count >= 2 ? Split(c, ks, cols) : null;\r\n                    if (parts == null) Put(line, ks[0], c.Text);\r\n                    else for (int j = 0; j < ks.Count; j++) Put(line, ks[j], parts[j]);\r\n                }\r\n                g.T.Add(line.Select(s => s ?? \"\").ToList());\r\n            }\r\n            return g;\r\n        }\r\n\r\n        static void Put(string[] line, int k, string text) { line[k] = line[k] == null ? text : line[k] + \" \" + text; }\r\n\r\n        // 这一块碰到哪几列（重叠超过自己或那列宽度的三成才算，免得擦个边就算跨列）；一列都没碰到就取最近的\r\n        static List<int> Columns(Cell c, List<double[]> cols)\r\n        {\r\n            var hits = new List<int>();\r\n            int best = 0;\r\n            double bv = double.MinValue, cw = Rr(c) - L(c);\r\n            for (int k = 0; k < cols.Count; k++)\r\n            {\r\n                double v = Math.Min(Rr(c), cols[k][1]) - Math.Max(L(c), cols[k][0]);\r\n                if (v > 0 && v > 0.3 * Math.Min(cw, cols[k][1] - cols[k][0])) hits.Add(k);\r\n                if (v > bv) { bv = v; best = k; }\r\n            }\r\n            if (hits.Count > 0) return hits;\r\n            // 正好落在两列中间（合并单元格的标题居中）：算左边那列\r\n            double mid = (L(c) + Rr(c)) / 2;\r\n            for (int k = 0; k + 1 < cols.Count; k++)\r\n                if (mid >= cols[k][1] && mid <= cols[k + 1][0]) { hits.Add(k); return hits; }\r\n            hits.Add(best);\r\n            return hits;\r\n        }\r\n\r\n        static readonly Regex NumToken = new Regex(@\"-?\\d[\\d,]*(\\.\\d+)?%?\");\r\n\r\n        // 一块字跨了几列（相邻格子的字被当成一块找出来了）：按列的分界切开。切不开返回 null（盖住几列的标题就放最左边那列）\r\n        static string[] Split(Cell c, List<int> ks, List<double[]> cols)\r\n        {\r\n            var text = c.Text;\r\n            // 几个数字粘在一起（中间夹着水印之类的一两个杂字）：数字个数正好等于列数就一列一个\r\n            if (!Regex.IsMatch(text, @\"\\d-\\d\"))\r\n            {\r\n                var nums = NumToken.Matches(text).Cast<Match>().Select(m => m.Value).ToList();\r\n                if (nums.Count == ks.Count && NumToken.Replace(text, \"\").Trim().Length <= 2) return nums.ToArray();\r\n            }\r\n            // 按字数估每个空格在哪（汉字算 2 个宽），每条列分界附近要有一个空格\r\n            double total = Width(text);\r\n            var cuts = new List<int>();\r\n            for (int j = 1; j < ks.Count; j++)\r\n            {\r\n                double bound = (cols[ks[j - 1]][1] + cols[ks[j]][0]) / 2;\r\n                int bp = -1;\r\n                double bd = double.MaxValue;\r\n                for (int p = 0; p < text.Length; p++)\r\n                {\r\n                    if (text[p] != ' ') continue;\r\n                    double d = Math.Abs(c.X + c.W * Width(text.Substring(0, p)) / total - bound);\r\n                    if (d < bd) { bd = d; bp = p; }\r\n                }\r\n                if (bp < 0 || bd > 0.15 * c.W || (cuts.Count > 0 && bp <= cuts[cuts.Count - 1])) return null;\r\n                cuts.Add(bp);\r\n            }\r\n            var parts = new string[ks.Count];\r\n            int from = 0;\r\n            for (int j = 0; j < ks.Count; j++)\r\n            {\r\n                int to = j < cuts.Count ? cuts[j] : text.Length;\r\n                parts[j] = text.Substring(from, to - from).Trim();\r\n                if (parts[j].Length == 0) return null;\r\n                from = to + 1;\r\n            }\r\n            return parts;\r\n        }\r\n\r\n        // 表头（数据行上面那些行）重排。合并单元格里字是上下居中的，按高低分行会乱，改按「谁在谁正下方」：\r\n        //   - 标题（开头只有一块字的行，或者宽过整张表三成五的，比如工程名称）不参与，按原来的先后各占一行放在最上面\r\n        //   - 一块字的上级 = 在它上面、左右离它不超过 0.7 个列宽（拿它所在那列量）里最近的那块。\r\n        //     两列合并的标题中心在两列交界上，离两边子标题正好半个列宽；竖着合并的「计量单位」离旁边列的子标题有一整列宽，管不到\r\n        //   - 层数 = 上级的层数 + 1；最底下的子标题（有上级、下面没东西）统一放表头最后一行；\r\n        //     没有上级、下面也没东西的（序号这种竖着合并的）放表头第一行\r\n        //   - 管着两块以上的上级放在最左那块下级的列（Excel 合并单元格的字算在最左那格）\r\n        static void Header(Grid g, byte[] bgr, int w, int h)\r\n        {\r\n            if (g.Body == 0 || g.Cols.Count == 0) return;\r\n            if (bgr != null && GridHeader(g, bgr, w, h)) return;\r\n            var all = g.Rows.SelectMany(r => r).ToList();\r\n            double tableW = all.Max(c => c.R) - all.Min(c => c.X);\r\n            // 标题：很宽的（工程名称）、字明显大的（大标题）、开头独占一行又有 8 个字以上的。\r\n            // 只有一块字的行不一定是标题（「开累节超」这种上级表头比左右的字高，常常自己占一行）\r\n            // 字少的框四周留白占比大，字号会估大，所以按字号、字数算标题的还得自己独占一行\r\n            double medH = Median(all.Select(c => c.H)), medSize = Median(all.Select(Size));\r\n            int firstMulti = g.Rows.FindIndex(r => r.Count >= 2);\r\n            Func<int, Cell, bool> isTitle = (i, c) => c.W > 0.35 * tableW\r\n                || (g.Rows[i].Count == 1 && (c.H > 1.3 * medH || Size(c) > 1.4 * medSize || (i < firstMulti && c.Text.Length >= 8)));\r\n            var titles = new List<List<Cell>>();\r\n            var cells = new List<Cell>();\r\n            for (int i = 0; i < g.Body; i++)\r\n            {\r\n                int row = i;\r\n                var t = g.Rows[i].Where(c => isTitle(row, c)).ToList();\r\n                if (t.Count > 0) titles.Add(t);\r\n                cells.AddRange(g.Rows[i].Where(c => !isTitle(row, c)));\r\n            }\r\n\r\n            // 每列的「地盘」：到左右两列中间为止；最边上的两列往外延半个空隙\r\n            int n = g.Cols.Count;\r\n            var band = new double[n + 1];\r\n            for (int k = 1; k < n; k++) band[k] = (g.Cols[k - 1][1] + g.Cols[k][0]) / 2;\r\n            double half = n > 1 ? Math.Max(0, band[1] - g.Cols[0][1]) : 0.5 * (g.Cols[0][1] - g.Cols[0][0]);\r\n            band[0] = g.Cols[0][0] - half;\r\n            band[n] = g.Cols[n - 1][1] + half;\r\n            Func<Cell, double> cy = c => c.Y + c.H / 2, cx = c => (L(c) + Rr(c)) / 2;\r\n            Func<double, int> bandOf = x =>\r\n            {\r\n                int k = 0;\r\n                while (k < n - 1 && x > band[k + 1]) k++;\r\n                return k;\r\n            };\r\n            Func<int, double> pitch = k => band[Math.Max(0, Math.Min(n - 1, k)) + 1] - band[Math.Max(0, Math.Min(n - 1, k))];\r\n            Func<Cell, Cell, bool> above = (c, d) => c != d && cy(d) - cy(c) > 0.35 * 0.6 * Math.Min(c.H, d.H);\r\n            // 严格：左右离 d 不超过 d 那列的 0.7 个列宽\r\n            Func<Cell, Cell, bool> near = (c, d) => Math.Abs(cx(c) - cx(d)) <= 0.7 * pitch(bandOf(cx(d)));\r\n            // 放宽：合并的两列一宽一窄时，上级的中心离窄的那列的子标题有「宽那列的一半」那么远。\r\n            // 这时看上级的中心是不是正好在「d 这列 + 靠上级那侧的邻列」合起来的正中间\r\n            Func<Cell, Cell, bool> loose = (c, d) =>\r\n            {\r\n                int k = bandOf(cx(d)), nb = cx(c) < cx(d) ? k - 1 : k + 1;\r\n                if (nb < 0 || nb >= n) return false;\r\n                int a = Math.Min(k, nb), b = Math.Max(k, nb);\r\n                return Math.Abs(cx(c) - (band[a] + band[b + 1]) / 2) <= 0.3 * Math.Min(pitch(k), pitch(nb));\r\n            };\r\n            var parent = new Dictionary<Cell, Cell>();\r\n            var hasBelow = new HashSet<Cell>();\r\n            foreach (var d in cells)\r\n            {\r\n                var ps = cells.Where(c => above(c, d) && near(c, d)).ToList();\r\n                foreach (var c in ps) hasBelow.Add(c);\r\n                // 最近的上级：头上最低的那块（子标题可能被好几层管着，取紧挨着的那一层），一样高取左右最近的；\r\n                // 严格的找不到再放宽，放宽的取左右最近的\r\n                var p = ps.OrderByDescending(cy).ThenBy(c => Math.Abs(cx(c) - cx(d))).FirstOrDefault()\r\n                    ?? cells.Where(c => above(c, d) && loose(c, d)).OrderBy(c => Math.Abs(cx(c) - cx(d))).FirstOrDefault();\r\n                if (p == null) continue;\r\n                parent[d] = p;\r\n                hasBelow.Add(p);\r\n            }\r\n            var level = new Dictionary<Cell, int>();\r\n            Func<Cell, int> lv = null;\r\n            lv = c =>\r\n            {\r\n                int v;\r\n                if (level.TryGetValue(c, out v)) return v;\r\n                Cell p;\r\n                v = parent.TryGetValue(c, out p) ? lv(p) + 1 : 0;\r\n                level[c] = v;\r\n                return v;\r\n            };\r\n            int depth = cells.Count == 0 ? 0 : cells.Max(c => lv(c));\r\n            var col = new Dictionary<Cell, int>();\r\n            Func<Cell, int> colOf = null;\r\n            colOf = c =>\r\n            {\r\n                int v;\r\n                if (col.TryGetValue(c, out v)) return v;\r\n                var kids = parent.Where(x => x.Value == c).Select(x => x.Key).ToList();\r\n                v = kids.Count >= 2 ? kids.Min(d => colOf(d)) : Columns(c, g.Cols)[0];\r\n                col[c] = v;\r\n                return v;\r\n            };\r\n            LastHeader = cells.Select(c => c.Text + \"：第 \" + lv(c) + \" 层，上级 \" + (parent.ContainsKey(c) ? parent[c].Text : \"无\") + (hasBelow.Contains(c) ? \"，下面有\" : \"，下面没有\") + \"，列 \" + colOf(c)).ToList();\r\n\r\n            var lines = new List<string[]>();\r\n            foreach (var t in titles)\r\n            {\r\n                var line = new string[n];\r\n                foreach (var c in t) Put(line, Columns(c, g.Cols)[0], c.Text);\r\n                lines.Add(line);\r\n            }\r\n            if (cells.Count > 0)\r\n            {\r\n                var head = Enumerable.Range(0, depth + 1).Select(i => new string[n]).ToList();\r\n                foreach (var c in cells.OrderBy(c => c.X))\r\n                    Put(head[!hasBelow.Contains(c) && lv(c) > 0 ? depth : lv(c)], colOf(c), c.Text);\r\n                lines.AddRange(head);\r\n            }\r\n            g.T.RemoveRange(0, g.Body);\r\n            g.T.InsertRange(0, lines.Select(l => l.Select(s => s ?? \"\").ToList()));\r\n            g.Body = lines.Count;\r\n        }\r\n\r\n        // 表格线：比上下（竖线看左右）隔 3 像素的地方明显暗、又连成长串的像素。横线至少 3 个字高长，竖线至少 2.5 个字高长\r\n        // （字的笔画没这么长）。用「比两边暗」而不是「比底色暗」，表头填了底色也认得出边框。允许断开 2 像素（水印、字压线）\r\n        static void FindLines(byte[] bgr, int w, int h, double unit, out bool[] hl, out bool[] vl)\r\n        {\r\n            var lum = new int[w * h];\r\n            for (int i = 0; i < lum.Length; i++) lum[i] = (bgr[i * 3] * 29 + bgr[i * 3 + 1] * 150 + bgr[i * 3 + 2] * 77) >> 8;\r\n            hl = new bool[w * h];\r\n            vl = new bool[w * h];\r\n            int hLen = Math.Max(12, (int)(3 * unit)), vLen = Math.Max(10, (int)(2.5 * unit));\r\n            for (int y = 3; y < h - 3; y++)\r\n            {\r\n                int start = -1, last = -1;\r\n                for (int x = 0; x <= w; x++)\r\n                {\r\n                    int p = y * w + x;\r\n                    // 和上下隔 2 或隔 3 像素比（字离线只有两三个像素时，隔 3 会比到字上；粗一点的线隔 2 会比到线自己）\r\n                    if (x < w && ((lum[p] + 25 < lum[p - 3 * w] && lum[p] + 25 < lum[p + 3 * w]) || (lum[p] + 25 < lum[p - 2 * w] && lum[p] + 25 < lum[p + 2 * w])))\r\n                    { if (start < 0) start = x; last = x; continue; }\r\n                    if (start >= 0 && x < w && x - last <= 2) continue;\r\n                    if (start >= 0 && last - start + 1 >= hLen) for (int i = start; i <= last; i++) hl[y * w + i] = true;\r\n                    start = -1;\r\n                }\r\n            }\r\n            // 竖线短的也算：多层表头里「数量｜金额」之间的线只有一行高，但上下两头都接着横线（字的笔画碰不到表格线）\r\n            var hlc = hl;\r\n            Func<int, int, bool> hNear = (x, y) =>\r\n            {\r\n                for (int yy = Math.Max(0, y - 3); yy <= Math.Min(h - 1, y + 3); yy++)\r\n                    for (int xx = Math.Max(0, x - 2); xx <= Math.Min(w - 1, x + 2); xx++) if (hlc[yy * w + xx]) return true;\r\n                return false;\r\n            };\r\n            int vShort = Math.Max(6, (int)(0.6 * unit));\r\n            for (int x = 3; x < w - 3; x++)\r\n            {\r\n                int start = -1, last = -1;\r\n                for (int y = 0; y <= h; y++)\r\n                {\r\n                    int p = y * w + x;\r\n                    if (y < h && ((lum[p] + 25 < lum[p - 3] && lum[p] + 25 < lum[p + 3]) || (lum[p] + 25 < lum[p - 2] && lum[p] + 25 < lum[p + 2])))\r\n                    { if (start < 0) start = y; last = y; continue; }\r\n                    if (start >= 0 && y < h && y - last <= 2) continue;\r\n                    int len = last - start + 1;\r\n                    if (start >= 0 && (len >= vLen || (len >= vShort && hNear(x, start) && hNear(x, last))))\r\n                        for (int i = start; i <= last; i++) vl[i * w + x] = true;\r\n                    start = -1;\r\n                }\r\n            }\r\n        }\r\n\r\n        // 表格线抹成底色（每个线点取上下或左右隔 3 像素里亮的那边的颜色），给第二遍找字用\r\n        // 一块字有两三行高（窄格子里折行的「辅助 / 编码」挤得很紧，找字时连成一块，整块认会认不出）：\r\n        // 按每一横排墨迹多少，在中间找墨迹最少的那排切开，一直切到每段只有一行高。切不开返回一段\r\n        static List<int[]> LineBands(byte[] bgr, int w, int h, Cell c, double unit)\r\n        {\r\n            int x0 = Math.Max(0, (int)c.X), x1 = Math.Min(w, (int)Math.Ceiling(c.R)), y0 = Math.Max(0, (int)c.Y), y1 = Math.Min(h, (int)Math.Ceiling(c.Y + c.H));\r\n            var bands = new List<int[]>();\r\n            if (x1 - x0 < 4 || y1 - y0 < 4) { bands.Add(new[] { y0, y1 }); return bands; }\r\n            var hist = new int[256];\r\n            for (int y = y0; y < y1; y++) for (int x = x0; x < x1; x++) { int p = (y * w + x) * 3; hist[(bgr[p] * 29 + bgr[p + 1] * 150 + bgr[p + 2] * 77) >> 8]++; }\r\n            int bg = 0;\r\n            for (int acc = 0, half = (x1 - x0) * (y1 - y0) / 2; bg < 255 && (acc += hist[bg]) < half; bg++) { }\r\n            var rowN = new int[y1 - y0];\r\n            for (int y = y0; y < y1; y++)\r\n                for (int x = x0; x < x1; x++)\r\n                {\r\n                    int p = (y * w + x) * 3;\r\n                    if (Math.Abs(((bgr[p] * 29 + bgr[p + 1] * 150 + bgr[p + 2] * 77) >> 8) - bg) > 60) rowN[y - y0]++;\r\n                }\r\n            int max = rowN.Max();\r\n            Action<int, int> cut = null;\r\n            cut = (top, bot) =>\r\n            {\r\n                int lo = top + (int)(0.35 * unit), hi = bot - (int)(0.35 * unit), best = -1, min = int.MaxValue;\r\n                if (bot - top >= 1.4 * unit)\r\n                    for (int y = lo; y <= hi; y++) if (rowN[y - y0] < min) { min = rowN[y - y0]; best = y; }\r\n                if (best < 0 || min > 0.15 * max) { bands.Add(new[] { top, bot }); return; }\r\n                cut(top, best);\r\n                cut(best + 1, bot);\r\n            };\r\n            cut(y0, y1);\r\n            return bands;\r\n        }\r\n\r\n        // BGR 图双线性缩放\r\n        static byte[] Scale(byte[] bgr, int w, int h, int w2, int h2)\r\n        {\r\n            var o = new byte[w2 * h2 * 3];\r\n            double sx = (double)w / w2, sy = (double)h / h2;\r\n            for (int y = 0; y < h2; y++)\r\n            {\r\n                double fy = Math.Max(0, (y + 0.5) * sy - 0.5);\r\n                int y0 = Math.Min(h - 1, (int)fy), y1 = Math.Min(h - 1, y0 + 1);\r\n                double ay = fy - y0;\r\n                for (int x = 0; x < w2; x++)\r\n                {\r\n                    double fx = Math.Max(0, (x + 0.5) * sx - 0.5);\r\n                    int x0 = Math.Min(w - 1, (int)fx), x1 = Math.Min(w - 1, x0 + 1);\r\n                    double ax = fx - x0;\r\n                    for (int k = 0; k < 3; k++)\r\n                    {\r\n                        double v = (bgr[(y0 * w + x0) * 3 + k] * (1 - ax) + bgr[(y0 * w + x1) * 3 + k] * ax) * (1 - ay)\r\n                                 + (bgr[(y1 * w + x0) * 3 + k] * (1 - ax) + bgr[(y1 * w + x1) * 3 + k] * ax) * ay;\r\n                        o[(y * w2 + x) * 3 + k] = (byte)Math.Round(v);\r\n                    }\r\n                }\r\n            }\r\n            return o;\r\n        }\r\n\r\n        static byte[] EraseLines(byte[] bgr, bool[] hl, bool[] vl, int w, int h)\r\n        {\r\n            var o = (byte[])bgr.Clone();\r\n            Func<int, int> lum = p => bgr[p * 3] * 29 + bgr[p * 3 + 1] * 150 + bgr[p * 3 + 2] * 77;\r\n            for (int y = 0; y < h; y++)\r\n                for (int x = 0; x < w; x++)\r\n                {\r\n                    int p = y * w + x;\r\n                    if (!hl[p] && !vl[p]) continue;\r\n                    // 横线取上下、竖线取左右；隔 3 像素，出了图就取另一边\r\n                    int a, b;\r\n                    if (hl[p]) { a = y >= 3 ? p - 3 * w : p + 3 * w; b = y + 3 < h ? p + 3 * w : a; }\r\n                    else { a = x >= 3 ? p - 3 : p + 3; b = x + 3 < w ? p + 3 : a; }\r\n                    int s = lum(a) >= lum(b) ? a : b;\r\n                    o[p * 3] = bgr[s * 3]; o[p * 3 + 1] = bgr[s * 3 + 1]; o[p * 3 + 2] = bgr[s * 3 + 2];\r\n                    // 线常常有 2 像素粗（或者发虚），旁边一圈也抹掉\r\n                    foreach (var q in hl[p] ? new[] { p - w, p + w } : new[] { p - 1, p + 1 })\r\n                        if (q >= 0 && q < w * h) { o[q * 3] = bgr[s * 3]; o[q * 3 + 1] = bgr[s * 3 + 1]; o[q * 3 + 2] = bgr[s * 3 + 2]; }\r\n                }\r\n            return o;\r\n        }\r\n\r\n        // 有表格线的表头：每块字所在的格子直接按线找出来（合并单元格就是一个大格子），\r\n        //   - 同一个格子里折成几行的字（「技术要 / 求及项 / 目特征」）接回一块\r\n        //   - 上级 = 头上最近的、左右把它罩住的格子；层数 = 上级层数 + 1\r\n        //   - 下面没有数据的格子（整列数据都空的「单位」「工程量」…）自己加一列\r\n        //   - 叶子格子：有上级、一直到表头底的放最后一行（目标成本 / 实际成本）；其余按层数放（序号这种竖着合并的在第一行）\r\n        //   - 上级放在它最左那个下级的列（Excel 合并单元格的字算在最左那格）\r\n        // 左右两边都找到竖线的才算表头格子；找不到的（工程名称、大标题在表格外面）当标题，各占一行放最上面。\r\n        // 表头格子不到六成找得到线，就说明不是带线的表，返回 false 走按位置猜的办法\r\n        static bool GridHeader(Grid g, byte[] bgr, int w, int h)\r\n        {\r\n            var all = g.Rows.SelectMany(r => r).ToList();\r\n            double unit = Median(all.Select(c => c.H));\r\n            var cells = g.Rows.Take(g.Body).SelectMany(r => r).ToList();\r\n            if (cells.Count < 2) return false;\r\n            bool[] hl = g.HL, vl = g.VL;\r\n            if (hl == null) FindLines(bgr, w, h, unit, out hl, out vl);\r\n            int tol =Math.Max(3, (int)(0.15 * unit));\r\n            Func<int, int, bool> vAt = (x, y) => { for (int yy = Math.Max(0, y - 2); yy <= Math.Min(h - 1, y + 2); yy++) if (vl[yy * w + x]) return true; return false; };\r\n            Func<int, int, bool> hAt = (x, y) => { for (int xx = Math.Max(0, x - 2); xx <= Math.Min(w - 1, x + 2); xx++) if (hl[y * w + xx]) return true; return false; };\r\n            var box = new Dictionary<Cell, int[]>();   // 格子的 左、上、右、下；左右找不到是 -1，上下找不到用图的边\r\n            // 字紧贴着线时，线在字的那一段会断开（比不出「比两边暗」），所以在字的中间和两头外侧都看一眼\r\n            Func<int, int> cxw = v => Math.Max(0, Math.Min(w - 1, v));\r\n            Func<int, int> cyh = v => Math.Max(0, Math.Min(h - 1, v));\r\n            foreach (var c in cells)\r\n            {\r\n                int y = cyh((int)(c.Y + c.H / 2)), x = cxw((int)((L(c) + Rr(c)) / 2));\r\n                // 只在字自己的范围里探（往外探会探到上下行、左右格的线）\r\n                int[] xs = { x, cxw((int)L(c)), cxw((int)Rr(c)) }, ys = { y, cyh((int)T0(c)), cyh((int)T1(c)) };\r\n                int l = -1, r = -1, t = 0, b = h - 1;\r\n                for (int xx = Math.Min(w - 1, (int)L(c) - 1); xx >= 0 && l < 0; xx--) foreach (var yy in ys) if (vAt(xx, yy)) { l = xx; break; }\r\n                for (int xx = Math.Max(0, (int)Math.Ceiling(Rr(c)) + 1); xx < w && r < 0; xx++) foreach (var yy in ys) if (vAt(xx, yy)) { r = xx; break; }\r\n                // 上下从字的中间开始找（字可能紧贴着线，从字的上沿找会跳过它；字的横笔画不够长，不会当成线）\r\n                bool found = false;\r\n                for (int yy = y; yy >= 0 && !found; yy--) foreach (var xx in xs) if (hAt(xx, yy)) { t = yy; found = true; break; }\r\n                found = false;\r\n                for (int yy = y; yy < h && !found; yy++) foreach (var xx in xs) if (hAt(xx, yy)) { b = yy; found = true; break; }\r\n                // 贴着截图左右边的格子：最外面的边框被截掉了（或正好在边上），拿图边当边线\r\n                if (l < 0 && L(c) < 1.5 * unit) l = 0;\r\n                if (r < 0 && Rr(c) > w - 1 - 1.5 * unit) r = w - 1;\r\n                box[c] = new[] { l, t, r, b };\r\n            }\r\n            // 标题：很宽的（工程名称）、独占一行又字明显大的（大标题），不管有没有线；其余左右没找到竖线的也算标题\r\n            double tableW = all.Max(c => c.R) - all.Min(c => c.X), medSize = Median(all.Select(Size));\r\n            var title = new HashSet<Cell>();\r\n            for (int i = 0; i < g.Body; i++)\r\n                foreach (var c in g.Rows[i])\r\n                    if (c.W > 0.35 * tableW || (g.Rows[i].Count == 1 && (c.H > 1.3 * unit || Size(c) > 1.4 * medSize))) title.Add(c);\r\n            var withLines = cells.Where(c => box[c][0] >= 0 && box[c][2] >= 0).ToList();\r\n            if (withLines.Count < 2 || withLines.Count < 0.6 * cells.Count) return false;\r\n            var parts = withLines.Where(c => !title.Contains(c)).ToList();\r\n            if (parts.Count < 2) return false;\r\n\r\n            // 同一个格子里的几块字接起来：从上到下、同一行从左到右\r\n            var groups = new List<List<Cell>>();\r\n            foreach (var c in parts.OrderBy(c => c.Y).ThenBy(c => c.X))\r\n            {\r\n                var gr = groups.FirstOrDefault(x => Enumerable.Range(0, 4).All(i => Math.Abs(box[x[0]][i] - box[c][i]) <= tol));\r\n                if (gr == null) groups.Add(new List<Cell> { c }); else gr.Add(c);\r\n            }\r\n            var heads = new List<Cell>();\r\n            var eb = new Dictionary<Cell, int[]>();\r\n            foreach (var gr in groups)\r\n            {\r\n                var text = new StringBuilder();\r\n                foreach (var c in gr)\r\n                {\r\n                    if (text.Length > 0 && char.IsLetterOrDigit(text[text.Length - 1]) && text[text.Length - 1] < 128 && char.IsLetterOrDigit(c.Text[0]) && c.Text[0] < 128) text.Append(' ');\r\n                    text.Append(c.Text);\r\n                }\r\n                double x0 = gr.Min(c => c.X), y0 = gr.Min(c => c.Y);\r\n                var m = new Cell { X = x0, Y = y0, W = gr.Max(c => c.R) - x0, H = gr.Max(c => c.Y + c.H) - y0, Text = text.ToString() };\r\n                heads.Add(m);\r\n                eb[m] = box[gr[0]];\r\n            }\r\n\r\n            // 上级：头上最近的、左右把它的中线罩住的格子\r\n            Func<Cell, double> mid = c => (eb[c][0] + eb[c][2]) / 2.0;\r\n            var parent = new Dictionary<Cell, Cell>();\r\n            foreach (var d in heads)\r\n            {\r\n                var p = heads.Where(c => c != d && eb[c][3] <= eb[d][1] + tol && eb[c][0] - tol <= mid(d) && mid(d) <= eb[c][2] + tol)\r\n                    .OrderByDescending(c => eb[c][3]).FirstOrDefault();\r\n                if (p != null) parent[d] = p;\r\n            }\r\n            var kids = heads.ToDictionary(c => c, c => parent.Where(x => x.Value == c).Select(x => x.Key).ToList());\r\n            var level = new Dictionary<Cell, int>();\r\n            Func<Cell, int> lv = null;\r\n            lv = c =>\r\n            {\r\n                int v;\r\n                if (level.TryGetValue(c, out v)) return v;\r\n                Cell p;\r\n                v = parent.TryGetValue(c, out p) ? lv(p) + 1 : 0;\r\n                level[c] = v;\r\n                return v;\r\n            };\r\n            int depth = heads.Max(c => lv(c));\r\n            int bottom = heads.Max(c => eb[c][3]);\r\n\r\n            // 叶子格子罩住的数据列；一列都没罩住（这列数据全空）就给它加一列\r\n            Func<int[], List<int>> inside = e => Enumerable.Range(0, g.Cols.Count).Where(k => { double cm = (g.Cols[k][0] + g.Cols[k][1]) / 2; return cm > e[0] && cm < e[2]; }).ToList();\r\n            foreach (var c in heads.Where(c => kids[c].Count == 0).OrderBy(c => eb[c][0]))\r\n            {\r\n                if (inside(eb[c]).Count > 0) continue;\r\n                var iv = new double[] { eb[c][0] + tol, eb[c][2] - tol };\r\n                double cm = (iv[0] + iv[1]) / 2;\r\n                int at = g.Cols.Count(k => (k[0] + k[1]) / 2 < cm);\r\n                g.Cols.Insert(at, iv);\r\n                foreach (var row in g.T) row.Insert(at, \"\");\r\n            }\r\n            var col = new Dictionary<Cell, int>();\r\n            Func<Cell, int> colOf = null;\r\n            colOf = c =>\r\n            {\r\n                int v;\r\n                if (col.TryGetValue(c, out v)) return v;\r\n                // 格子罩住的最左那列；罩不住任何列（很窄）就看下级，再不行按字的位置\r\n                var ks = inside(eb[c]);\r\n                v = ks.Count > 0 ? ks[0] : kids[c].Count > 0 ? kids[c].Min(d => colOf(d)) : Columns(c, g.Cols)[0];\r\n                col[c] = v;\r\n                return v;\r\n            };\r\n            LastHeader = heads.Select(c => \"[线] \" + c.Text + \"：格子 \" + string.Join(\",\", eb[c]) + \"，第 \" + lv(c) + \" 层，上级 \" + (parent.ContainsKey(c) ? parent[c].Text : \"无\") + \"，列 \" + colOf(c)).ToList();\r\n\r\n            int n = g.Cols.Count;\r\n            var lines = new List<string[]>();\r\n            for (int i = 0; i < g.Body; i++)\r\n            {\r\n                var t = g.Rows[i].Where(c => !parts.Contains(c)).ToList();\r\n                if (t.Count == 0) continue;\r\n                var line = new string[n];\r\n                foreach (var c in t) Put(line, Columns(c, g.Cols)[0], c.Text);\r\n                lines.Add(line);\r\n            }\r\n            var head = Enumerable.Range(0, depth + 1).Select(i => new string[n]).ToList();\r\n            foreach (var c in heads.OrderBy(c => c.X))\r\n            {\r\n                int r = kids[c].Count == 0 && lv(c) > 0 && eb[c][3] >= bottom - tol ? depth : lv(c);\r\n                Put(head[r], colOf(c), c.Text);\r\n            }\r\n            lines.AddRange(head);\r\n            g.T.RemoveRange(0, g.Body);\r\n            g.T.InsertRange(0, lines.Select(l => l.Select(s => s ?? \"\").ToList()));\r\n            g.Body = lines.Count;\r\n            return true;\r\n        }\r\n\r\n        // 整列都空的删掉（合并标题挪走以后，它原来自己占的那列）\r\n        static void DropEmptyColumns(Grid g)\r\n        {\r\n            for (int k = g.Cols.Count - 1; k >= 0; k--)\r\n            {\r\n                if (g.T.Any(r => r[k].Length > 0)) continue;\r\n                foreach (var r in g.T) r.RemoveAt(k);\r\n                g.Cols.RemoveAt(k);\r\n            }\r\n        }\r\n\r\n        // 数字列（数据行里六成以上是数字）里，数字前后粘了一个杂字的（水印「第 1 页」压在数字上），把杂字去掉\r\n        static readonly Regex Dirty = new Regex(@\"^[^\\d.,\\-]?(-?\\d[\\d,]*(\\.\\d+)?%?)[^\\d.,%]?`$\");\r\n\r\n        static void CleanNumbers(Grid g)\r\n        {\r\n            for (int k = 0; k < g.Cols.Count; k++)\r\n            {\r\n                var body = Enumerable.Range(g.Body, g.T.Count - g.Body).Where(i => g.T[i][k].Length > 0).ToList();\r\n                if (body.Count < 3 || body.Count(i => Parse(g.T[i][k]) != null) < 0.6 * body.Count) continue;\r\n                foreach (var i in body)\r\n                {\r\n                    if (Parse(g.T[i][k]) != null) continue;\r\n                    var m = Dirty.Match(g.T[i][k].Trim());\r\n                    if (m.Success && Parse(m.Groups[1].Value) != null) g.T[i][k] = m.Groups[1].Value;\r\n                }\r\n                // 这列八成以上的数都是同样几位小数，个别多出正好一位的（水印的「1」粘在后面，3008.222）去掉多的那位\r\n                var decs = body.Where(i => Parse(g.T[i][k]) != null && !g.T[i][k].EndsWith(\"%\")).Select(i => Decimals(g.T[i][k])).ToList();\r\n                if (decs.Count < 3) continue;\r\n                int d = decs.GroupBy(x => x).OrderByDescending(x => x.Count()).First().Key;\r\n                if (d == 0 || decs.Count(x => x == d) < 0.8 * decs.Count) continue;\r\n                foreach (var i in body)\r\n                    if (Parse(g.T[i][k]) != null && !g.T[i][k].EndsWith(\"%\") && Decimals(g.T[i][k]) == d + 1)\r\n                        g.T[i][k] = g.T[i][k].Trim().Substring(0, g.T[i][k].Trim().Length - 1);\r\n            }\r\n        }\r\n\r\n        static int Decimals(string s) { s = s.Trim(); int p = s.LastIndexOf('.'); return p < 0 ? 0 : s.Length - p - 1; }\r\n\r\n        class Slot { public int Row, Col, InkW, RowH; public Rectangle Area; public string Text; }\r\n\r\n        // 找出「空着但里面有墨迹」的格子，返回要单独认的范围（贴着墨迹、四周留一点边）。\r\n        // 已经认出来的字块（包括别的行跨过来的高格子）都遮住不算，免得把它们再认一遍\r\n        static List<Slot> Blanks(Grid g, byte[] bgr, int w, int h)\r\n        {\r\n            var list = new List<Slot>();\r\n            var known = g.Rows.SelectMany(r => r).Select(c => Rectangle.FromLTRB((int)c.X, (int)c.Y, (int)Math.Ceiling(c.R), (int)Math.Ceiling(c.Y + c.H))).ToList();\r\n            for (int i = 0; i < g.Rows.Count; i++)\r\n            {\r\n                var row = g.Rows[i];\r\n                int top = (int)Math.Ceiling(Median(row.Select(c => c.Y))), bot = (int)Median(row.Select(c => c.Y + c.H));\r\n                int rh = (int)Median(row.Select(c => c.H)), m = Math.Max(3, (int)(rh * 0.25));\r\n                for (int k = 0; k < g.Cols.Count; k++)\r\n                {\r\n                    if (g.T[i][k].Length > 0) continue;\r\n                    int left = (int)Math.Ceiling(k == 0 ? 0 : (g.Cols[k - 1][1] + g.Cols[k][0]) / 2);\r\n                    int right = (int)(k == g.Cols.Count - 1 ? w : (g.Cols[k][1] + g.Cols[k + 1][0]) / 2);\r\n                    var region = Rectangle.FromLTRB(left, top, right, bot);\r\n                    var ink = Ink(bgr, w, h, region, known.Where(r => r.IntersectsWith(region)).ToList(), rh);\r\n                    if (ink.IsEmpty) continue;\r\n                    // 框至少和这一行别的字块一样高（「-」这种扁的字，框太扁会被放大成一根粗棍）\r\n                    int bh = Math.Max(ink.Height + 2 * m, rh), by = ink.Y + ink.Height / 2 - bh / 2;\r\n                    var area = Rectangle.Intersect(new Rectangle(ink.X - m, by, ink.Width + 2 * m, bh), new Rectangle(0, 0, w, h));\r\n                    // 框里混进了已经认出来的字（会把它再认一遍）就不认了\r\n                    if (known.Any(r => { var x = Rectangle.Intersect(r, area); return x.Width * x.Height > 0.2 * area.Width * area.Height; })) continue;\r\n                    list.Add(new Slot { Row = i, Col = k, Area = area, InkW = ink.Width, RowH = rh });\r\n                }\r\n            }\r\n            return list;\r\n        }\r\n\r\n        // 只有符号、没有字和数字的（水印、表格线碎片认成的「+」「:」「(」）。横线类（表里常用来表示没有）和打勾打叉留着\r\n        static bool Junk(string text)\r\n        {\r\n            text = text.Trim();\r\n            if (text.Any(ch => char.IsLetterOrDigit(ch))) return false;\r\n            return !Regex.IsMatch(text, @\"^[-－—–一~～/√×✓✗]+`$\");\r\n        }\r\n\r\n        // 认出来的字数要和墨迹宽度对得上（一个字至少约 0.25 个行高宽），对不上多半是认错的杂纹\r\n        static bool Plausible(Slot s, string text)\r\n        {\r\n            if (text.Trim('|', '丨', '｜', '_', ' ').Length == 0 || Junk(text)) return false;\r\n            return text.Length <= s.InkW / Math.Max(1.0, 0.25 * s.RowH) + 1;\r\n        }\r\n\r\n        // 一块范围里和底色明显不同的像素的外框；整行 / 整列都是的（表格线）和遮住的范围不算。墨迹太少返回空\r\n        static Rectangle Ink(byte[] bgr, int w, int h, Rectangle region, List<Rectangle> masks, int rh)\r\n        {\r\n            int x0 = Math.Max(0, region.Left), y0 = Math.Max(0, region.Top), x1 = Math.Min(w, region.Right), y1 = Math.Min(h, region.Bottom);\r\n            int cw = x1 - x0, ch = y1 - y0;\r\n            if (cw < 4 || ch < 4) return Rectangle.Empty;\r\n            var lum = new byte[cw * ch];\r\n            var hidden = new bool[cw * ch];\r\n            foreach (var r in masks)\r\n                for (int y = Math.Max(y0, r.Top); y < Math.Min(y1, r.Bottom); y++)\r\n                    for (int x = Math.Max(x0, r.Left); x < Math.Min(x1, r.Right); x++) hidden[(y - y0) * cw + x - x0] = true;\r\n            var hist = new int[256];\r\n            for (int y = 0; y < ch; y++)\r\n                for (int x = 0; x < cw; x++)\r\n                {\r\n                    int p = ((y0 + y) * w + x0 + x) * 3;\r\n                    var l = (byte)((bgr[p] * 29 + bgr[p + 1] * 150 + bgr[p + 2] * 77) >> 8);\r\n                    lum[y * cw + x] = l;\r\n                    hist[l]++;\r\n                }\r\n            int bg = 0;\r\n            for (int acc = 0; bg < 255 && (acc += hist[bg]) < lum.Length / 2; bg++) { }\r\n            var dark = new bool[lum.Length];\r\n            for (int i = 0; i < lum.Length; i++) dark[i] = Math.Abs(lum[i] - bg) > 80;\r\n            // 表格线：横着连续超过 1.5 个行高、竖着几乎贯穿整个范围的一串像素（字的笔画没这么长）\r\n            var line = new bool[lum.Length];\r\n            int hLen = Math.Max(8, (int)(1.5 * rh)), vLen = Math.Max(4, (int)(0.9 * ch));\r\n            for (int y = 0; y < ch; y++)\r\n                for (int x = 0, run = 0; x <= cw; x++)\r\n                {\r\n                    if (x < cw && dark[y * cw + x]) { run++; continue; }\r\n                    if (run >= hLen) for (int i = x - run; i < x; i++) line[y * cw + i] = true;\r\n                    run = 0;\r\n                }\r\n            for (int x = 0; x < cw; x++)\r\n                for (int y = 0, run = 0; y <= ch; y++)\r\n                {\r\n                    if (y < ch && dark[y * cw + x]) { run++; continue; }\r\n                    if (run >= vLen) for (int i = y - run; i < y; i++) line[i * cw + x] = true;\r\n                    run = 0;\r\n                }\r\n            int n = 0, bx0 = int.MaxValue, by0 = int.MaxValue, bx1 = -1, by1 = -1;\r\n            for (int y = 0; y < ch; y++)\r\n            {\r\n                for (int x = 0; x < cw; x++)\r\n                {\r\n                    if (!dark[y * cw + x] || hidden[y * cw + x] || line[y * cw + x]) continue;\r\n                    n++;\r\n                    if (x < bx0) bx0 = x; if (x > bx1) bx1 = x; if (y < by0) by0 = y; if (y > by1) by1 = y;\r\n                }\r\n            }\r\n            if (n < 3 || (by1 - by0 < 2 && bx1 - bx0 < 2)) return Rectangle.Empty;\r\n            return new Rectangle(x0 + bx0, y0 + by0, bx1 - bx0 + 1, by1 - by0 + 1);\r\n        }\r\n\r\n        // 同一行里挨得很近的两块（一个格子里的字被拆开了）接回去\r\n        static List<Cell> MergeClose(List<Cell> r, Func<Cell, Cell, bool> lineBetween)\r\n        {\r\n            var o = new List<Cell>();\r\n            foreach (var c in r)\r\n            {\r\n                var p = o.Count > 0 ? o[o.Count - 1] : null;\r\n                if (p != null && c.X - p.R < 0.15 * Math.Min(c.H, p.H) && !lineBetween(p, c))\r\n                {\r\n                    bool space = char.IsLetterOrDigit(p.Text[p.Text.Length - 1]) && p.Text[p.Text.Length - 1] < 128 && char.IsLetterOrDigit(c.Text[0]) && c.Text[0] < 128;\r\n                    double right = Math.Max(p.R, c.R), top = Math.Min(p.Y, c.Y), bot = Math.Max(p.Y + p.H, c.Y + c.H);\r\n                    p.Text = p.Text + (space ? \" \" : \"\") + c.Text;\r\n                    p.W = right - p.X; p.Y = top; p.H = bot - top;\r\n                }\r\n                else o.Add(new Cell { X = c.X, Y = c.Y, W = c.W, H = c.H, Text = c.Text });\r\n            }\r\n            return o;\r\n        }\r\n\r\n        // ------------------------------------------------------------------\r\n        // 写 .xlsx（就是几个 XML 打成 zip；Excel 和 WPS 都能开）\r\n        // ------------------------------------------------------------------\r\n        static readonly Regex Num = new Regex(@\"^[-+]?(\\d{1,3}(,\\d{3})+|\\d+)(\\.(\\d+))?(%?)`$\");\r\n\r\n        class Number { public string Value, Format; }\r\n\r\n        // 像数字的存成数字（能求和），格式照原样：几位小数、千分位逗号、百分号（0.00 还显示 0.00，6.27% 存成 0.0627 显示 6.27%）。\r\n        // 以 0 开头的编号、超过 15 位的长号码（身份证、单号）留成文字\r\n        static Number Parse(string s)\r\n        {\r\n            s = s.Trim();\r\n            var m = Num.Match(s);\r\n            if (!m.Success) return null;\r\n            var t = s.Replace(\",\", \"\").TrimStart('+').TrimEnd('%');\r\n            var digits = t.TrimStart('-');\r\n            if (digits.Length > 1 && digits[0] == '0' && digits[1] != '.') return null;\r\n            if (digits.Replace(\".\", \"\").Length > 15) return null;\r\n            int dec = m.Groups[4].Value.Length;\r\n            var zeros = dec > 0 ? \".\" + new string('0', dec) : \"\";\r\n            if (m.Groups[5].Value == \"%\")\r\n                return new Number { Value = (decimal.Parse(t, System.Globalization.CultureInfo.InvariantCulture) / 100).ToString(System.Globalization.CultureInfo.InvariantCulture), Format = \"0\" + zeros + \"%\" };\r\n            string fmt = s.Contains(\",\") ? \"#,##0\" + zeros : dec > 0 ? \"0\" + zeros : \"\";\r\n            return new Number { Value = t, Format = fmt };\r\n        }\r\n\r\n        static string Esc(string s)\r\n        {\r\n            var b = new StringBuilder(s.Length);\r\n            foreach (var ch in s) if (ch >= 0x20 || ch == '\\t' || ch == '\\n') b.Append(ch);\r\n            return SecurityElement.Escape(b.ToString());\r\n        }\r\n\r\n        static string ColName(int k)\r\n        {\r\n            var s = \"\";\r\n            for (k++; k > 0; k = (k - 1) / 26) s = (char)('A' + (k - 1) % 26) + s;\r\n            return s;\r\n        }\r\n\r\n        // 列宽按字数估：汉字算 2，其余算 1\r\n        static double Width(string s)\r\n        {\r\n            double n = 0;\r\n            foreach (var ch in s) n += ch > 0x2E80 ? 2 : 1;\r\n            return n;\r\n        }\r\n\r\n        public static void SaveXlsx(List<List<string>> t, string path)\r\n        {\r\n            const string ns = \"http://schemas.openxmlformats.org/spreadsheetml/2006/main\";\r\n            const string head = \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\" standalone=\\\"yes\\\"?>\\r\\n\";\r\n            int ncol = t.Count == 0 ? 0 : t.Max(r => r.Count);\r\n            var strings = new List<string>();\r\n            var index = new Dictionary<string, int>();\r\n            var formats = new List<string>();   // 自定义数字格式，样式号 = 2 + 下标\r\n            var sheet = new StringBuilder(head + \"<worksheet xmlns=\\\"\" + ns + \"\\\">\");\r\n            if (ncol > 0)\r\n            {\r\n                sheet.Append(\"<cols>\");\r\n                // 列宽按最长的字估；整行只有一格的（标题、工程名称）不算，免得第一列被撑得很宽\r\n                var sized = t.Where(r => r.Count(v => v.Length > 0) >= 2).ToList();\r\n                if (sized.Count == 0) sized = t;\r\n                for (int k = 0; k < ncol; k++)\r\n                {\r\n                    double w = Math.Max(6, Math.Min(60, sized.Max(r => k < r.Count ? Width(r[k]) : 0) + 2));\r\n                    sheet.Append(\"<col min=\\\"\" + (k + 1) + \"\\\" max=\\\"\" + (k + 1) + \"\\\" width=\\\"\" + w.ToString(System.Globalization.CultureInfo.InvariantCulture) + \"\\\" customWidth=\\\"1\\\"/>\");\r\n                }\r\n                sheet.Append(\"</cols>\");\r\n            }\r\n            sheet.Append(\"<sheetData>\");\r\n            for (int i = 0; i < t.Count; i++)\r\n            {\r\n                sheet.Append(\"<row r=\\\"\" + (i + 1) + \"\\\">\");\r\n                for (int k = 0; k < ncol; k++)\r\n                {\r\n                    var v = k < t[i].Count ? t[i][k] : \"\";\r\n                    var at = ColName(k) + (i + 1);\r\n                    var n = v.Length == 0 ? null : Parse(v);\r\n                    if (v.Length == 0) sheet.Append(\"<c r=\\\"\" + at + \"\\\" s=\\\"1\\\"/>\");\r\n                    else if (n != null)\r\n                    {\r\n                        int st = 1;\r\n                        if (n.Format.Length > 0)\r\n                        {\r\n                            if (!formats.Contains(n.Format)) formats.Add(n.Format);\r\n                            st = 2 + formats.IndexOf(n.Format);\r\n                        }\r\n                        sheet.Append(\"<c r=\\\"\" + at + \"\\\" s=\\\"\" + st + \"\\\"><v>\" + n.Value + \"</v></c>\");\r\n                    }\r\n                    else\r\n                    {\r\n                        int id;\r\n                        if (!index.TryGetValue(v, out id)) { id = strings.Count; strings.Add(v); index[v] = id; }\r\n                        sheet.Append(\"<c r=\\\"\" + at + \"\\\" s=\\\"1\\\" t=\\\"s\\\"><v>\" + id + \"</v></c>\");\r\n                    }\r\n                }\r\n                sheet.Append(\"</row>\");\r\n            }\r\n            sheet.Append(\"</sheetData></worksheet>\");\r\n\r\n            var sst = new StringBuilder(head + \"<sst xmlns=\\\"\" + ns + \"\\\" count=\\\"\" + strings.Count + \"\\\" uniqueCount=\\\"\" + strings.Count + \"\\\">\");\r\n            foreach (var s in strings) sst.Append(\"<si><t xml:space=\\\"preserve\\\">\" + Esc(s) + \"</t></si>\");\r\n            sst.Append(\"</sst>\");\r\n\r\n            const string border = \"<left style=\\\"thin\\\"><color auto=\\\"1\\\"/></left><right style=\\\"thin\\\"><color auto=\\\"1\\\"/></right><top style=\\\"thin\\\"><color auto=\\\"1\\\"/></top><bottom style=\\\"thin\\\"><color auto=\\\"1\\\"/></bottom><diagonal/>\";\r\n            const string cellXf = \"fontId=\\\"0\\\" fillId=\\\"0\\\" borderId=\\\"1\\\" xfId=\\\"0\\\" applyBorder=\\\"1\\\" applyAlignment=\\\"1\\\"><alignment vertical=\\\"center\\\"/></xf>\";\r\n            var numFmts = new StringBuilder();\r\n            var xfs = new StringBuilder(\"<xf numFmtId=\\\"0\\\" fontId=\\\"0\\\" fillId=\\\"0\\\" borderId=\\\"0\\\" xfId=\\\"0\\\"/><xf numFmtId=\\\"0\\\" \" + cellXf);\r\n            for (int i = 0; i < formats.Count; i++)\r\n            {\r\n                numFmts.Append(\"<numFmt numFmtId=\\\"\" + (164 + i) + \"\\\" formatCode=\\\"\" + SecurityElement.Escape(formats[i]) + \"\\\"/>\");\r\n                xfs.Append(\"<xf numFmtId=\\\"\" + (164 + i) + \"\\\" applyNumberFormat=\\\"1\\\" \" + cellXf);\r\n            }\r\n            var parts = new Dictionary<string, string>\r\n            {\r\n                { \"[Content_Types].xml\", head + \"<Types xmlns=\\\"http://schemas.openxmlformats.org/package/2006/content-types\\\">\"\r\n                    + \"<Default Extension=\\\"rels\\\" ContentType=\\\"application/vnd.openxmlformats-package.relationships+xml\\\"/>\"\r\n                    + \"<Default Extension=\\\"xml\\\" ContentType=\\\"application/xml\\\"/>\"\r\n                    + \"<Override PartName=\\\"/xl/workbook.xml\\\" ContentType=\\\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\\\"/>\"\r\n                    + \"<Override PartName=\\\"/xl/worksheets/sheet1.xml\\\" ContentType=\\\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\\\"/>\"\r\n                    + \"<Override PartName=\\\"/xl/styles.xml\\\" ContentType=\\\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\\\"/>\"\r\n                    + \"<Override PartName=\\\"/xl/sharedStrings.xml\\\" ContentType=\\\"application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml\\\"/>\"\r\n                    + \"</Types>\" },\r\n                { \"_rels/.rels\", head + \"<Relationships xmlns=\\\"http://schemas.openxmlformats.org/package/2006/relationships\\\">\"\r\n                    + \"<Relationship Id=\\\"rId1\\\" Type=\\\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\\\" Target=\\\"xl/workbook.xml\\\"/>\"\r\n                    + \"</Relationships>\" },\r\n                { \"xl/workbook.xml\", head + \"<workbook xmlns=\\\"\" + ns + \"\\\" xmlns:r=\\\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\\\">\"\r\n                    + \"<sheets><sheet name=\\\"识别结果\\\" sheetId=\\\"1\\\" r:id=\\\"rId1\\\"/></sheets></workbook>\" },\r\n                { \"xl/_rels/workbook.xml.rels\", head + \"<Relationships xmlns=\\\"http://schemas.openxmlformats.org/package/2006/relationships\\\">\"\r\n                    + \"<Relationship Id=\\\"rId1\\\" Type=\\\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\\\" Target=\\\"worksheets/sheet1.xml\\\"/>\"\r\n                    + \"<Relationship Id=\\\"rId2\\\" Type=\\\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\\\" Target=\\\"styles.xml\\\"/>\"\r\n                    + \"<Relationship Id=\\\"rId3\\\" Type=\\\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings\\\" Target=\\\"sharedStrings.xml\\\"/>\"\r\n                    + \"</Relationships>\" },\r\n                { \"xl/styles.xml\", head + \"<styleSheet xmlns=\\\"\" + ns + \"\\\">\"\r\n                    + (formats.Count > 0 ? \"<numFmts count=\\\"\" + formats.Count + \"\\\">\" + numFmts + \"</numFmts>\" : \"\")\r\n                    + \"<fonts count=\\\"1\\\"><font><sz val=\\\"11\\\"/><name val=\\\"等线\\\"/><family val=\\\"2\\\"/><charset val=\\\"134\\\"/></font></fonts>\"\r\n                    + \"<fills count=\\\"2\\\"><fill><patternFill patternType=\\\"none\\\"/></fill><fill><patternFill patternType=\\\"gray125\\\"/></fill></fills>\"\r\n                    + \"<borders count=\\\"2\\\"><border><left/><right/><top/><bottom/><diagonal/></border><border>\" + border + \"</border></borders>\"\r\n                    + \"<cellStyleXfs count=\\\"1\\\"><xf numFmtId=\\\"0\\\" fontId=\\\"0\\\" fillId=\\\"0\\\" borderId=\\\"0\\\"/></cellStyleXfs>\"\r\n                    + \"<cellXfs count=\\\"\" + (2 + formats.Count) + \"\\\">\" + xfs + \"</cellXfs>\"\r\n                    + \"<cellStyles count=\\\"1\\\"><cellStyle name=\\\"Normal\\\" xfId=\\\"0\\\" builtinId=\\\"0\\\"/></cellStyles>\"\r\n                    + \"</styleSheet>\" },\r\n                { \"xl/worksheets/sheet1.xml\", sheet.ToString() },\r\n                { \"xl/sharedStrings.xml\", sst.ToString() },\r\n            };\r\n            var tmp = path + \".part\";\r\n            using (var fs = File.Create(tmp))\r\n            using (var zip = new ZipArchive(fs, ZipArchiveMode.Create))\r\n                foreach (var p in parts)\r\n                    using (var w = new StreamWriter(zip.CreateEntry(p.Key, CompressionLevel.Optimal).Open(), new UTF8Encoding(false)))\r\n                        w.Write(p.Value);\r\n            if (File.Exists(path)) File.Delete(path);\r\n            File.Move(tmp, path);\r\n        }\r\n    }\r\n}\r\n\n\"@\nif (-not ('MbOutPlugin.OcrTable' -as [type])) {\n  $sha = New-Object Security.Cryptography.SHA1Managed\n  $hash = [BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($src))).Replace('-', '').Substring(0, 12)\n  $dll = Join-Path $env:LOCALAPPDATA \"MBoutPlugins\\ocr_excel_$hash.dll\"\n  if (-not (Test-Path -LiteralPath $dll)) {\n    New-Item -ItemType Directory -Force (Split-Path $dll) | Out-Null\n    Add-Type -TypeDefinition $src -ReferencedAssemblies System.Drawing, System.Windows.Forms, System.IO.Compression, System.Core -OutputAssembly $dll -OutputType Library\n  }\n  Add-Type -Path $dll\n}\n\nStart-Sleep -Milliseconds 250  # 等快捷面板收起来，别截进去\n$dir = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'MB out 截图表格'\n# 框选最多等 15 秒：插件脚本总共只能跑 30 秒，大表识别要五六秒，第一次还要编译\ntry { $path = [MbOutPlugin.OcrTable]::Run($exe, $dir, 15) }\ncatch { throw $_.Exception.GetBaseException().Message }\nif (-not $path) { '没有框选，已取消'; return }\ntry { Start-Process -FilePath $path }\ncatch { Start-Process explorer.exe ('/select,\"' + $path + '\"'); \"已保存，但这台电脑没有能打开 xlsx 的软件：$path\"; return }\n\"已转成 Excel（$([MbOutPlugin.OcrTable]::LastRows) 行 × $([MbOutPlugin.OcrTable]::LastCols) 列），存在：$path\"",
      "mode": "notify",
      "icon": "v:chart",
      "icon_color": "#22a06b"
    }
  ],
  "cover": "v:chart|#22a06b"
}