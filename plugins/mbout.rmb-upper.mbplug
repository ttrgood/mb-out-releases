{
  "mbout_plugin": 1,
  "id": "mbout.rmb-upper",
  "name": "金额大写",
  "version": "1.2",
  "author": "MB out",
  "description": "打开一个小窗口：输入阿拉伯数字，马上显示中文大写金额（壹万贰仟叁佰肆拾伍元陆角柒分），一键复制。支持 1,280、3.5万、1200×3.5 这样的写法；先选中一个数再点会自动填进去。只在窗口里转换，不改原文。第一次点要几秒（编译一次），以后很快。",
  "cover": "v:yen|#f59e0b",
  "items": [
    {
      "kind": "script",
      "name": "金额大写",
      "mode": "none",
      "icon": "v:yen",
      "icon_color": "#f59e0b",
      "value": "# 金额大写：开一个小窗口，输入数字就显示中文大写金额，只在窗口里转换，不改原文。点之前选中了一个数，会自动填进窗口。\n# 窗口是一个小程序：第一次点时用 Windows 自带的 C# 编译器把下面的源码编成 exe（几秒，只编一次），以后直接启动。\n# 关掉窗口只是藏起来，再点就马上出来；藏着 30 分钟没用会自己退出。\n# 文件放在 MB out 的数据目录\\插件数据\\金额大写（MB out 在「数据目录\\tmp」里运行插件脚本）；找不到就放 %LOCALAPPDATA%\\MBout-plugins\\rmb。\n$dd = Split-Path -Parent (Get-Location).Path\n$dir = if (Test-Path (Join-Path $dd 'plan_data.json')) { Join-Path $dd '插件数据\\金额大写' } else { Join-Path $env:LOCALAPPDATA 'MBout-plugins\\rmb' }\n[void](New-Item -ItemType Directory -Force $dir)\n$utf8 = New-Object Text.UTF8Encoding $false\n$sel = \"$env:MB_SELECTION\".Trim()\nif ($sel.Length -gt 60 -or $sel -notmatch '[0-9０-９]') { $sel = '' }\n[IO.File]::WriteAllText((Join-Path $dir 'rmb_init.txt'), $sel, $utf8)\nif (Test-Path (Join-Path $dd 'plan_data.json')) { [IO.File]::WriteAllText((Join-Path $dir 'rmb_datadir.txt'), $dd, $utf8) }\n\n# 窗口已经开着（或藏着）：按一下门铃就行\n$bell = 'Local\\mbout_rmb_770efdc50b'\n$ev = $null\nif ([Threading.EventWaitHandle]::TryOpenExisting($bell, [ref]$ev)) { [void]$ev.Set(); return }\n\n# ---------------- 小程序源码（C#）----------------\nfunction Get-RmbSource {\n@'\n// 金额大写：MB out 插件「金额大写」的小窗口。上面输入数字，下面马上显示中文大写金额；只在这个窗口里转换，不改任何地方的原文。\n// 插件第一次运行时用 Windows 自带的 C# 编译器（.NET Framework 4）编成 exe，以后直接启动，不再每次等 PowerShell。\n// 关掉窗口只是藏起来，再点插件马上出来；藏着 30 分钟没用就自己退出。配色跟 MB out 当前主题一样（读它的 plan_data.json）。\n// 只能用 C# 5 的写法（系统自带的编译器版本）。\nusing System;\nusing System.Collections.Generic;\nusing System.Globalization;\nusing System.IO;\nusing System.Linq;\nusing System.Text;\nusing System.Text.RegularExpressions;\nusing System.Threading;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Input;\nusing System.Windows.Media;\nusing System.Windows.Media.Animation;\nusing System.Windows.Media.Effects;\nusing System.Windows.Media.Imaging;\nusing System.Windows.Shapes;\nusing System.Windows.Threading;\n\nnamespace MbRmb\n{\n    // ================================================================ 数字 → 大写\n    public class ReadResult { public bool Ok; public decimal Value; public bool Expr; public string Err = \"\"; }\n\n    public static class Core\n    {\n        static readonly string[] D = { \"零\", \"壹\", \"贰\", \"叁\", \"肆\", \"伍\", \"陆\", \"柒\", \"捌\", \"玖\" };\n        static readonly string[] Unit = { \"\", \"拾\", \"佰\", \"仟\" };\n        static readonly string[] Big = { \"\", \"万\", \"亿\", \"万亿\" };\n\n        public static string Upper(decimal v)\n        {\n            bool neg = v < 0;\n            if (neg) v = -v;\n            v = Math.Round(v, 2, MidpointRounding.AwayFromZero);\n            decimal ip = decimal.Truncate(v);\n            int cents = (int)((v - ip) * 100);\n            int jiao = cents / 10, fen = cents % 10;\n            var s = new StringBuilder();\n            if (ip > 0)\n            {\n                string digits = ip.ToString(\"0\", CultureInfo.InvariantCulture);\n                var groups = new List<string>();\n                for (int i = digits.Length; i > 0; i -= 4) { int st = Math.Max(0, i - 4); groups.Insert(0, digits.Substring(st, i - st).PadLeft(4, '0')); }\n                bool zero = false;\n                for (int g = 0; g < groups.Count; g++)\n                {\n                    string grp = groups[g];\n                    if (grp == \"0000\") { if (s.Length > 0) zero = true; continue; }\n                    var part = new StringBuilder();\n                    for (int k = 0; k < 4; k++)\n                    {\n                        int c = grp[k] - '0';\n                        if (c == 0) { if (s.Length > 0 || part.Length > 0) zero = true; }\n                        else { if (zero) part.Append(\"零\"); zero = false; part.Append(D[c]).Append(Unit[3 - k]); }\n                    }\n                    zero = false;   // 一组末尾的 0（万位、元位）不写「零」：107000 → 壹拾万柒仟\n                    s.Append(part).Append(Big[groups.Count - 1 - g]);\n                }\n                s.Append(\"元\");\n            }\n            string r = s.ToString();\n            if (jiao == 0 && fen == 0) r = r.Length > 0 ? r + \"整\" : \"零元整\";\n            else\n            {\n                if (jiao > 0)\n                {\n                    if (r.Length > 0 && ip % 10 == 0) r += \"零\";   // 元位是 0：1680.32 → 壹仟陆佰捌拾元零叁角贰分\n                    r += D[jiao] + \"角\";\n                }\n                else if (r.Length > 0) r += \"零\";                  // 1.05 → 壹元零伍分\n                if (fen > 0) r += D[fen] + \"分\";\n            }\n            if (neg && r != \"零元整\") r = \"负\" + r;\n            return r;\n        }\n\n        static string ToHalf(string t)\n        {\n            var sb = new StringBuilder();\n            foreach (char c in t)\n            {\n                if (c >= 0xFF01 && c <= 0xFF5E) sb.Append((char)(c - 0xFEE0));\n                else if (c == 0x3000) sb.Append(' ');\n                else sb.Append(c);\n            }\n            return sb.ToString();\n        }\n\n        /// <summary>读输入：数字、逗号、¥、千 / 万 / 亿、+ - × ÷ 括号算式（decimal 计算，不丢精度）</summary>\n        public static ReadResult Read(string text)\n        {\n            string t = Regex.Replace(ToHalf(text ?? \"\"), @\"[¥￥,，\\s]\", \"\");\n            t = Regex.Replace(t, \"[×xX]\", \"*\").Replace(\"÷\", \"/\").Replace(\"（\", \"(\").Replace(\"）\", \")\");\n            t = Regex.Replace(t, \"^(人民币|RMB)\", \"\", RegexOptions.IgnoreCase);\n            t = Regex.Replace(t, \"(元|圆)整?$\", \"\");\n            if (t.Length == 0) return new ReadResult();\n            if (!Regex.IsMatch(t, @\"^[0-9\\.\\+\\-\\*/\\(\\)千万亿]+$\")) return new ReadResult { Err = \"只认数字、小数点、千 / 万 / 亿和 + - × ÷ 括号\" };\n            decimal v;\n            try\n            {\n                var p = new Parser(t);\n                v = p.Expr();\n                if (p.Pos < t.Length) throw new FormatException(\"这里看不懂\");\n            }\n            catch (OverflowException) { return new ReadResult { Err = \"数太大了\" }; }\n            catch (Exception e) { return new ReadResult { Err = \"算不出来：\" + e.Message }; }\n            if (Math.Abs(v) >= 10000000000000000m) return new ReadResult { Err = \"数太大了（最多到万亿）\" };\n            return new ReadResult { Ok = true, Value = v, Expr = !Regex.IsMatch(t, @\"^-?[0-9]+(\\.[0-9]*)?$\") };\n        }\n\n        class Parser\n        {\n            readonly string _s; public int Pos;\n            public Parser(string s) { _s = s; }\n            char Peek() { return Pos < _s.Length ? _s[Pos] : '\\0'; }\n            public decimal Expr()\n            {\n                decimal v = Term();\n                while (Peek() == '+' || Peek() == '-') { char op = _s[Pos++]; decimal r = Term(); v = op == '+' ? v + r : v - r; }\n                return v;\n            }\n            decimal Term()\n            {\n                decimal v = Unary();\n                while (Peek() == '*' || Peek() == '/')\n                {\n                    char op = _s[Pos++]; decimal r = Unary();\n                    if (op == '*') v *= r; else { if (r == 0) throw new FormatException(\"不能除以 0\"); v /= r; }\n                }\n                return v;\n            }\n            decimal Unary()\n            {\n                if (Peek() == '-') { Pos++; return -Unary(); }\n                if (Peek() == '+') Pos++;\n                return Atom();\n            }\n            decimal Atom()\n            {\n                decimal v;\n                if (Peek() == '(')\n                {\n                    Pos++;\n                    v = Expr();\n                    if (Peek() != ')') throw new FormatException(\"括号没配对\");\n                    Pos++;\n                }\n                else\n                {\n                    var m = Regex.Match(_s.Substring(Pos), @\"^([0-9]+(\\.[0-9]*)?|\\.[0-9]+)\");\n                    if (!m.Success) throw new FormatException(\"这里看不懂\");\n                    Pos += m.Length;\n                    v = decimal.Parse(m.Value.TrimEnd('.'), CultureInfo.InvariantCulture);\n                }\n                while (true)\n                {\n                    char c = Peek();\n                    if (c == '千') v *= 1000m; else if (c == '万') v *= 10000m; else if (c == '亿') v *= 100000000m; else break;\n                    Pos++;\n                }\n                return v;\n            }\n        }\n    }\n\n    // ================================================================ 配色：按 MB out 的算法（Palette.From）从底色 / 文字色 / 强调色推出来\n    class Pal\n    {\n        public Color Bg, Text, RowBg, AddBg, BtnBg, BtnHover, Line, Border, Muted, Accent, AccentText, DarkOnAccent, Danger;\n        public Color[] G;\n        public double Fs = 1;\n        public string Sig = \"\";\n\n        public static Color C(string h)\n        {\n            if (h == null || !Regex.IsMatch(h, \"^#[0-9a-fA-F]{6}$\")) return Colors.Transparent;\n            return Color.FromRgb(Convert.ToByte(h.Substring(1, 2), 16), Convert.ToByte(h.Substring(3, 2), 16), Convert.ToByte(h.Substring(5, 2), 16));\n        }\n        static bool Ok(string h) { return h != null && Regex.IsMatch(h, \"^#[0-9a-fA-F]{6}$\"); }\n        public static Color Mix(Color a, Color b, double t)\n        {\n            return Color.FromRgb((byte)Math.Round(a.R + (b.R - a.R) * t), (byte)Math.Round(a.G + (b.G - a.G) * t), (byte)Math.Round(a.B + (b.B - a.B) * t));\n        }\n        public static Color WithA(Color c, byte a) { return Color.FromArgb(a, c.R, c.G, c.B); }\n        static double Cl(double v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }\n        public static Color Shift(Color c, double dh, double dl, double ds)\n        {\n            double r = c.R / 255.0, g = c.G / 255.0, b = c.B / 255.0;\n            double max = Math.Max(r, Math.Max(g, b)), min = Math.Min(r, Math.Min(g, b));\n            double l = (max + min) / 2, h = 0, s = 0;\n            if (max != min)\n            {\n                double d = max - min;\n                s = l > 0.5 ? d / (2 - max - min) : d / (max + min);\n                if (max == r) h = (g - b) / d + (g < b ? 6 : 0); else if (max == g) h = (b - r) / d + 2; else h = (r - g) / d + 4;\n                h *= 60;\n            }\n            h = (((h + dh) % 360) + 360) % 360; s = Cl(s + ds); l = Cl(l + dl);\n            double cc = (1 - Math.Abs(2 * l - 1)) * s, x = cc * (1 - Math.Abs(h / 60 % 2 - 1)), m = l - cc / 2;\n            double rr = 0, gg = 0, bb = 0;\n            if (h < 60) { rr = cc; gg = x; } else if (h < 120) { rr = x; gg = cc; } else if (h < 180) { gg = cc; bb = x; }\n            else if (h < 240) { gg = x; bb = cc; } else if (h < 300) { rr = x; bb = cc; } else { rr = cc; bb = x; }\n            return Color.FromRgb((byte)Math.Round((rr + m) * 255), (byte)Math.Round((gg + m) * 255), (byte)Math.Round((bb + m) * 255));\n        }\n\n        static readonly Dictionary<string, string[]> Accents = new Dictionary<string, string[]>\n        {\n            { \"amber\", new[] { \"#ffd66b\", \"#f6b04a\", \"#ee8a3a\" } }, { \"sunset\", new[] { \"#ffb36b\", \"#ff8b74\", \"#f2678f\" } },\n            { \"sakura\", new[] { \"#ffc0d4\", \"#f497c0\", \"#cf8ae6\" } }, { \"neon\", new[] { \"#f27bff\", \"#a97cff\", \"#6d8dff\" } },\n            { \"aurora\", new[] { \"#5ff0c6\", \"#44c6f2\", \"#6f8cff\" } }, { \"glacier\", new[] { \"#a3e9ff\", \"#84b9ff\", \"#a99cff\" } },\n            { \"mint\", new[] { \"#c6f27c\", \"#6ee7a8\", \"#38c9c1\" } },\n        };\n\n        /// <summary>读 MB out 的设置；读不到就用 MB out 的默认深色</summary>\n        public static Pal Load(string dataDir)\n        {\n            string cBg = \"#1b1c1f\", cText = \"#e8e9ec\", cDone = \"#f2c14e\", accent = \"solo\", img = null; double fs = 1;\n            try\n            {\n                var pf = dataDir == null ? null : System.IO.Path.Combine(dataDir, \"plan_data.json\");\n                if (pf != null && File.Exists(pf))\n                {\n                    var js = new System.Web.Script.Serialization.JavaScriptSerializer { MaxJsonLength = int.MaxValue };\n                    var o = js.DeserializeObject(File.ReadAllText(pf, Encoding.UTF8)) as Dictionary<string, object>;\n                    if (o != null)\n                    {\n                        object x;\n                        if (o.TryGetValue(\"c_bg\", out x) && Ok(x as string)) cBg = (string)x;\n                        if (o.TryGetValue(\"c_text\", out x) && Ok(x as string)) cText = (string)x;\n                        if (o.TryGetValue(\"c_done\", out x) && Ok(x as string)) cDone = (string)x;\n                        if (o.TryGetValue(\"accent\", out x) && x is string) accent = (string)x;\n                        if (o.TryGetValue(\"img_accent\", out x) && Ok(x as string)) img = (string)x;\n                        if (o.TryGetValue(\"font_scale\", out x) && x != null) fs = Convert.ToDouble(x, CultureInfo.InvariantCulture);\n                    }\n                }\n            }\n            catch { }\n            var p = new Pal();\n            p.Sig = cBg + cText + cDone + accent + img + fs.ToString(CultureInfo.InvariantCulture);\n            p.Fs = Math.Max(0.8, Math.Min(1.6, fs));\n            Color bg = C(cBg), tx = C(cText);\n            p.Bg = bg; p.Text = tx;\n            p.RowBg = Mix(bg, tx, 0.055); p.AddBg = Mix(bg, tx, 0.07); p.BtnBg = Mix(bg, tx, 0.08); p.BtnHover = Mix(bg, tx, 0.13);\n            p.Line = Mix(bg, tx, 0.14); p.Border = Mix(bg, tx, 0.22); p.Muted = Mix(bg, tx, 0.55);\n            bool light = (0.299 * bg.R + 0.587 * bg.G + 0.114 * bg.B) / 255.0 > 0.6;\n            Color solo = C(cDone);\n            if (accent == \"image\" && img != null) { solo = C(img); accent = \"solo\"; }\n            string[] cols;\n            if (Accents.TryGetValue(accent, out cols)) p.G = cols.Select(C).ToArray();\n            else p.G = new[] { Shift(solo, -10, 0.05, 0), solo, Shift(solo, 10, -0.06, 0) };\n            if (light) p.G = p.G.Select(c => Shift(c, 0, -0.13, 0.03)).ToArray();\n            p.Accent = p.G[p.G.Length / 2];\n            p.AccentText = light ? Mix(p.Accent, Colors.Black, 0.35) : Mix(p.Accent, Colors.White, 0.08);\n            p.DarkOnAccent = C(\"#1b1c1f\");\n            p.Danger = light ? C(\"#b0473c\") : C(\"#c0655a\");\n            return p;\n        }\n\n        public LinearGradientBrush Grad()\n        {\n            var b = new LinearGradientBrush { StartPoint = new Point(0, 0.5), EndPoint = new Point(1, 0.5) };\n            for (int i = 0; i < G.Length; i++) b.GradientStops.Add(new GradientStop(G[i], G.Length == 1 ? 0 : (double)i / (G.Length - 1)));\n            b.Freeze();\n            return b;\n        }\n    }\n\n    // ================================================================ 程序入口：只开一个；再点插件就把窗口叫出来\n    public static class Program\n    {\n        [STAThread]\n        public static void Main(string[] args)\n        {\n            string evName = args.Length > 0 ? args[0] : \"Local\\\\mbout_rmb_dev\";\n            bool created;\n            var ev = new EventWaitHandle(false, EventResetMode.AutoReset, evName, out created);\n            if (!created) { ev.Set(); return; }\n            string dir = args.Length > 1 ? args[1] : AppDomain.CurrentDomain.BaseDirectory;\n            var app = new Application { ShutdownMode = ShutdownMode.OnExplicitShutdown };\n            var w = new RmbWindow(dir);\n            var t = new Thread(() =>\n            {\n                while (true)\n                {\n                    ev.WaitOne();\n                    app.Dispatcher.BeginInvoke(new Action(w.ShowFront));\n                }\n            }) { IsBackground = true };\n            t.Start();\n            app.Startup += (s, e) => w.ShowFront();\n            app.Run();\n        }\n    }\n\n    // ================================================================ 窗口：和 MB out 的弹窗一样（无边框圆角卡片 + 阴影，淡入缩放）\n    class RmbWindow : Window\n    {\n        const double PadOut = 14;\n        readonly string _dir, _initFile, _cfgFile;\n        Pal P;\n        readonly Grid _host = new Grid();\n        readonly ScaleTransform _sc = new ScaleTransform(0.97, 0.97);\n        Border _shell, _copy, _copyNum, _prefix, _pin;\n        TextBox _in, _out;\n        TextBlock _small, _copyTxt, _copyNumTxt;\n        SolidColorBrush _pinFg;\n        bool _prefixOn, _pinned, _hiding, _placed;\n        string _num = \"\";\n        readonly DispatcherTimer _flash = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(1300) };\n        readonly DispatcherTimer _idle = new DispatcherTimer { Interval = TimeSpan.FromMinutes(30) };\n        static ControlTemplate _tbTemplate;\n\n        public RmbWindow(string dir)\n        {\n            _dir = dir;\n            _initFile = System.IO.Path.Combine(dir, \"rmb_init.txt\");\n            _cfgFile = System.IO.Path.Combine(dir, \"rmb.json\");\n            Title = \"金额大写\";\n            WindowStyle = WindowStyle.None; AllowsTransparency = true; Background = Brushes.Transparent;\n            ResizeMode = ResizeMode.NoResize; SizeToContent = SizeToContent.WidthAndHeight; UseLayoutRounding = true; ShowInTaskbar = true;\n            FontFamily = new FontFamily(\"Microsoft YaHei UI\");\n            TextOptions.SetTextFormattingMode(this, TextFormattingMode.Display);\n            TextOptions.SetTextRenderingMode(this, TextRenderingMode.Grayscale);\n            WindowStartupLocation = WindowStartupLocation.CenterScreen;\n            _host.RenderTransform = _sc; _host.RenderTransformOrigin = new Point(0.5, 0.3); _host.Opacity = 0;\n            Content = _host;\n            LoadCfg();\n            _flash.Tick += (s, e) => { _flash.Stop(); if (_copyTxt != null) _copyTxt.Text = \"复制大写\"; if (_copyNumTxt != null) _copyNumTxt.Text = \"复制数字\"; };\n            _idle.Tick += (s, e) => { _idle.Stop(); if (!IsVisible) Environment.Exit(0); };\n            PreviewKeyDown += (s, e) => { if (e.Key == Key.Escape) { e.Handled = true; Close(); } };\n            Closing += (s, e) => { e.Cancel = true; HideSoft(); };\n        }\n\n        // ---------------------------------------------------------------- 打开 / 藏起\n        public void ShowFront()\n        {\n            string init = TakeInit();\n            var np = Pal.Load(ReadDataDir());\n            if (P == null || np.Sig != P.Sig) { P = np; Build(); }\n            if (init.Length > 0) _in.Text = init;\n            _idle.Stop();\n            if (!IsVisible || _hiding)\n            {\n                _hiding = false;\n                if (!_placed) { Place(); _placed = true; }\n                Show();\n                _host.BeginAnimation(OpacityProperty, null); _host.Opacity = 0; _sc.ScaleX = _sc.ScaleY = 0.97;\n                Ease(_host, OpacityProperty, 1, 140, null);\n                Ease(_sc, ScaleTransform.ScaleXProperty, 1, 170, null);\n                Ease(_sc, ScaleTransform.ScaleYProperty, 1, 170, null);\n            }\n            if (WindowState == WindowState.Minimized) WindowState = WindowState.Normal;\n            Topmost = true; if (!_pinned) Topmost = false;\n            Activate();\n            _in.Focus(); _in.SelectAll();\n        }\n\n        void HideSoft()\n        {\n            if (_hiding || !IsVisible) return;\n            _hiding = true;\n            SaveCfg();\n            Ease(_sc, ScaleTransform.ScaleXProperty, 0.98, 110, null);\n            Ease(_sc, ScaleTransform.ScaleYProperty, 0.98, 110, null);\n            Ease(_host, OpacityProperty, 0, 110, (s, e) => { if (_hiding) { Hide(); _idle.Start(); } });\n        }\n\n        void Place()\n        {\n            double l, t;\n            if (_cfgLeft.HasValue && _cfgTop.HasValue)\n            {\n                l = _cfgLeft.Value; t = _cfgTop.Value;\n                if (l >= SystemParameters.VirtualScreenLeft - PadOut && l < SystemParameters.VirtualScreenLeft + SystemParameters.VirtualScreenWidth - 120 &&\n                    t >= SystemParameters.VirtualScreenTop - PadOut && t < SystemParameters.VirtualScreenTop + SystemParameters.VirtualScreenHeight - 120)\n                { WindowStartupLocation = WindowStartupLocation.Manual; Left = l; Top = t; }\n            }\n        }\n\n        string TakeInit()\n        {\n            try { if (File.Exists(_initFile)) { var t = File.ReadAllText(_initFile, Encoding.UTF8).Trim(); File.Delete(_initFile); return t; } } catch { }\n            return \"\";\n        }\n        string ReadDataDir()\n        {\n            try { var f = System.IO.Path.Combine(_dir, \"rmb_datadir.txt\"); if (File.Exists(f)) return File.ReadAllText(f, Encoding.UTF8).Trim(); } catch { }\n            return null;\n        }\n\n        // ---------------------------------------------------------------- 设置（加人民币、置顶、位置）\n        double? _cfgLeft, _cfgTop;\n        void LoadCfg()\n        {\n            try\n            {\n                if (!File.Exists(_cfgFile)) return;\n                var o = new System.Web.Script.Serialization.JavaScriptSerializer().DeserializeObject(File.ReadAllText(_cfgFile, Encoding.UTF8)) as Dictionary<string, object>;\n                if (o == null) return;\n                object x;\n                if (o.TryGetValue(\"prefix\", out x) && x is bool) _prefixOn = (bool)x;\n                if (o.TryGetValue(\"top\", out x) && x is bool) _pinned = (bool)x;\n                if (o.TryGetValue(\"left\", out x) && x != null) _cfgLeft = Convert.ToDouble(x, CultureInfo.InvariantCulture);\n                if (o.TryGetValue(\"topPos\", out x) && x != null) _cfgTop = Convert.ToDouble(x, CultureInfo.InvariantCulture);\n            }\n            catch { }\n        }\n        void SaveCfg()\n        {\n            try\n            {\n                var ci = CultureInfo.InvariantCulture;\n                File.WriteAllText(_cfgFile, \"{ \\\"prefix\\\": \" + (_prefixOn ? \"true\" : \"false\") + \", \\\"top\\\": \" + (_pinned ? \"true\" : \"false\") +\n                    \", \\\"left\\\": \" + Left.ToString(\"0.##\", ci) + \", \\\"topPos\\\": \" + Top.ToString(\"0.##\", ci) + \" }\", new UTF8Encoding(false));\n            }\n            catch { }\n        }\n\n        // ---------------------------------------------------------------- 小工具\n        static SolidColorBrush B(Color c) { return new SolidColorBrush(c); }\n        static void EaseColor(SolidColorBrush b, Color to, double ms)\n        {\n            b.BeginAnimation(SolidColorBrush.ColorProperty, new ColorAnimation(to, TimeSpan.FromMilliseconds(ms)) { EasingFunction = new QuadraticEase { EasingMode = EasingMode.EaseOut } });\n        }\n        static void Ease(IAnimatable o, DependencyProperty dp, double to, double ms, EventHandler done)\n        {\n            var a = new DoubleAnimation(to, TimeSpan.FromMilliseconds(ms)) { EasingFunction = new CubicEase { EasingMode = EasingMode.EaseOut } };\n            if (done != null) a.Completed += done;\n            o.BeginAnimation(dp, a);\n        }\n        TextBlock Txt(string t, double size, Color c, bool bold)\n        {\n            return new TextBlock { Text = t, FontSize = size, Foreground = B(c), TextWrapping = TextWrapping.Wrap, FontWeight = bold ? FontWeights.SemiBold : FontWeights.Normal };\n        }\n        static System.Windows.Shapes.Path Glyph(string data, double size, Brush fill)\n        {\n            return new System.Windows.Shapes.Path { Data = Geometry.Parse(data), Fill = fill, Stretch = Stretch.Uniform, Width = size, Height = size, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center };\n        }\n        TextBox Flat(double size, Color back, Color edge)\n        {\n            if (_tbTemplate == null)\n            {\n                var t = new ControlTemplate(typeof(TextBox));\n                var b = new FrameworkElementFactory(typeof(Border), \"border\");\n                b.SetValue(Border.BackgroundProperty, new TemplateBindingExtension(Control.BackgroundProperty));\n                b.SetValue(Border.BorderBrushProperty, new TemplateBindingExtension(Control.BorderBrushProperty));\n                b.SetValue(Border.BorderThicknessProperty, new TemplateBindingExtension(Control.BorderThicknessProperty));\n                b.SetValue(Border.CornerRadiusProperty, new CornerRadius(6));\n                b.SetValue(UIElement.SnapsToDevicePixelsProperty, true);\n                var sv = new FrameworkElementFactory(typeof(ScrollViewer), \"PART_ContentHost\");\n                sv.SetValue(UIElement.FocusableProperty, false);\n                sv.SetValue(ScrollViewer.HorizontalScrollBarVisibilityProperty, ScrollBarVisibility.Hidden);\n                sv.SetValue(ScrollViewer.VerticalScrollBarVisibilityProperty, ScrollBarVisibility.Hidden);\n                b.AppendChild(sv);\n                t.VisualTree = b;\n                t.Seal();\n                _tbTemplate = t;\n            }\n            return new TextBox\n            {\n                Template = _tbTemplate, FocusVisualStyle = null, FontSize = size, Foreground = B(P.Text), Background = B(back),\n                BorderBrush = B(edge), BorderThickness = new Thickness(1), CaretBrush = B(P.AccentText), SelectionBrush = B(P.AccentText),\n            };\n        }\n        static void OnClick(UIElement e, Action act)\n        {\n            bool down = false;\n            e.MouseLeftButtonDown += (s, a) => { down = true; a.Handled = true; };\n            e.MouseLeave += (s, a) => down = false;\n            e.MouseLeftButtonUp += (s, a) => { if (down) { down = false; a.Handled = true; act(); } };\n        }\n\n        // 按钮：主按钮 = 强调色渐变 + 深色字，悬停提亮；次按钮 = 浅底，悬停加深\n        Border Btn(string text, bool primary, out TextBlock label, Action act)\n        {\n            var t = Txt(text, 11 * P.Fs, primary ? P.DarkOnAccent : P.Text, false);\n            t.Margin = new Thickness(16, 5, 16, 6); t.HorizontalAlignment = HorizontalAlignment.Center; t.TextWrapping = TextWrapping.NoWrap;\n            label = t;\n            var b = new Border { CornerRadius = new CornerRadius(8), Cursor = Cursors.Hand, Margin = new Thickness(8, 0, 0, 0) };\n            if (primary)\n            {\n                b.Background = P.Grad();\n                var shine = new Border { CornerRadius = new CornerRadius(8), Background = Brushes.White, Opacity = 0 };\n                var g = new Grid(); g.Children.Add(shine); g.Children.Add(t); b.Child = g;\n                b.MouseEnter += (s, e) => Ease(shine, OpacityProperty, 0.07, 220, null);\n                b.MouseLeave += (s, e) => Ease(shine, OpacityProperty, 0, 300, null);\n            }\n            else\n            {\n                var bg = B(P.BtnBg); b.Background = bg; b.Child = t;\n                b.MouseEnter += (s, e) => EaseColor(bg, P.BtnHover, 70);\n                b.MouseLeave += (s, e) => EaseColor(bg, P.BtnBg, 260);\n            }\n            OnClick(b, act);\n            return b;\n        }\n\n        // 标题栏小图标按钮：悬停只淡淡地垫一层底色（和 MB out 一样 70 ms 进 / 260 ms 出），提示框等 0.6 秒、出在按钮下面\n        Border IconBtn(string data, string tip, Color fg, out SolidColorBrush fgBrush, Action act)\n        {\n            var bg = B(Pal.WithA(P.Text, 0));\n            fgBrush = B(fg);\n            double sz = Math.Round(26 * P.Fs);\n            var b = new Border { Width = sz, Height = sz, CornerRadius = new CornerRadius(7), Background = bg, Cursor = Cursors.Hand, Margin = new Thickness(2, 0, 0, 0), ToolTip = tip };\n            ToolTipService.SetInitialShowDelay(b, 600);\n            ToolTipService.SetPlacement(b, System.Windows.Controls.Primitives.PlacementMode.Bottom);\n            b.Child = Glyph(data, Math.Round(12 * P.Fs), fgBrush);\n            b.MouseEnter += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 22), 70);\n            b.MouseLeave += (s, e) => EaseColor(bg, Pal.WithA(P.Text, 0), 260);\n            OnClick(b, act);\n            return b;\n        }\n\n        // 勾选块：和「文字编辑」窗口的选项块一样（选中 = 强调色淡底 + 描边 + 勾）\n        Color ChipBg(bool on) { return on ? Pal.WithA(P.AccentText, 52) : Pal.WithA(P.Text, 6); }\n        Color ChipEdge(bool on) { return on ? Pal.WithA(P.AccentText, 200) : Pal.WithA(P.Text, 40); }\n        Color ChipFg(bool on) { return on ? P.Text : P.Muted; }\n        Border Chip(string text, Func<bool> get, Action<bool> set)\n        {\n            bool on = get();\n            var bg = B(ChipBg(on)); var edge = B(ChipEdge(on)); var fg = B(ChipFg(on));\n            double fs = 11 * P.Fs;\n            var chk = Glyph(\"M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z\", Math.Round(fs * 0.9), B(P.AccentText));\n            chk.Margin = new Thickness(0, 0, 4, 0);\n            var t = new TextBlock { Text = text, FontSize = fs, Foreground = fg, VerticalAlignment = VerticalAlignment.Center };\n            var sp = new StackPanel { Orientation = Orientation.Horizontal, HorizontalAlignment = HorizontalAlignment.Center };\n            sp.Children.Add(chk); sp.Children.Add(t);\n            var b = new Border { Background = bg, BorderBrush = edge, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(7), Padding = new Thickness(7, 2, 7, 3), Child = sp, Cursor = Cursors.Hand, HorizontalAlignment = HorizontalAlignment.Left, VerticalAlignment = VerticalAlignment.Center };\n            sp.Measure(new Size(double.PositiveInfinity, double.PositiveInfinity));\n            b.MinWidth = Math.Ceiling(sp.DesiredSize.Width) + 16;\n            chk.Visibility = on ? Visibility.Visible : Visibility.Collapsed;\n            b.MouseEnter += (s, e) => EaseColor(bg, get() ? Pal.WithA(P.AccentText, 70) : Pal.WithA(P.Text, 18), 70);\n            b.MouseLeave += (s, e) => EaseColor(bg, ChipBg(get()), 260);\n            OnClick(b, () =>\n            {\n                bool n = !get(); set(n);\n                EaseColor(bg, ChipBg(n), 140); EaseColor(edge, ChipEdge(n), 140); EaseColor(fg, ChipFg(n), 140);\n                chk.Visibility = n ? Visibility.Visible : Visibility.Collapsed;\n                if (n) { chk.Opacity = 0; Ease(chk, OpacityProperty, 1, 140, null); }\n            });\n            return b;\n        }\n\n        // ---------------------------------------------------------------- 界面\n        const string IcClose = \"M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z\";\n        const string IcPin = \"M16,9V4h1c0.55,0,1-0.45,1-1s-0.45-1-1-1H7C6.45,2,6,2.45,6,3s0.45,1,1,1h1v5c0,1.66-1.34,3-3,3v2h5.97v7l1,1l1-1v-7H19v-2C17.34,12,16,10.66,16,9z\";\n        const string IcYen = \"M5.2,3H7.6L12,10.2L16.4,3H18.8L13.4,12H17V14H13V15.5H17V17.5H13V21H11V17.5H7V15.5H11V14H7V12H10.6Z\";\n\n        void Build()\n        {\n            string keep = _in == null ? \"\" : _in.Text;\n            double fs = P.Fs, small = 11 * fs, big = 19 * fs;\n            _shell = new Border { Margin = new Thickness(PadOut), CornerRadius = new CornerRadius(14), Background = B(P.Bg), BorderBrush = B(P.Border), BorderThickness = new Thickness(1) };\n            _shell.SizeChanged += (s, e) => DrawShadow();\n            _shadowFor = Size.Empty;\n            _host.Children.Clear();\n            _host.Children.Add(_shell);\n            var sp = new StackPanel { Width = Math.Round(330 * fs), Margin = new Thickness(16, 10, 16, 16) };\n            _shell.Child = sp;\n\n            // 标题栏：按住拖动；右边置顶、关闭\n            var head = new DockPanel { LastChildFill = true, Background = Brushes.Transparent };\n            SolidColorBrush closeFg;\n            var close = IconBtn(IcClose, \"关闭（Esc）\", P.Muted, out closeFg, () => Close());\n            _pin = IconBtn(IcPin, _pinned ? \"取消置顶\" : \"置顶\", _pinned ? P.AccentText : P.Muted, out _pinFg, () =>\n            {\n                _pinned = !_pinned; Topmost = _pinned;\n                EaseColor(_pinFg, _pinned ? P.AccentText : P.Muted, 140);\n                _pin.ToolTip = _pinned ? \"取消置顶\" : \"置顶\";\n            });\n            DockPanel.SetDock(close, Dock.Right); DockPanel.SetDock(_pin, Dock.Right);\n            head.Children.Add(close); head.Children.Add(_pin);\n            var title = Txt(\"金额大写\", 12 * fs, P.Text, true); title.VerticalAlignment = VerticalAlignment.Center;\n            head.Children.Add(title);\n            head.MouseLeftButtonDown += (s, e) => { if (e.OriginalSource == head || e.OriginalSource == title) { try { DragMove(); } catch { } } };\n            sp.Children.Add(head);\n\n            _in = Flat(big, P.AddBg, P.Line);\n            _in.Padding = new Thickness(8, 4, 8, 5); _in.Margin = new Thickness(0, 10, 0, 0);\n            var lineB = _in.BorderBrush; var focusB = B(P.AccentText);\n            _in.GotKeyboardFocus += (s, e) => _in.BorderBrush = focusB;\n            _in.LostKeyboardFocus += (s, e) => _in.BorderBrush = lineB;\n            _in.TextChanged += (s, e) => UpdateOut();\n            _in.KeyDown += (s, e) => { if (e.Key == Key.Enter) { e.Handled = true; DoCopy(_copyTxt, _out.Text); } };\n            sp.Children.Add(_in);\n            var hint = Txt(\"可输入 12345.67、1,280、3.5万、1200×3.5，回车复制大写\", small, P.Muted, false);\n            hint.Margin = new Thickness(2, 6, 0, 0);\n            sp.Children.Add(hint);\n\n            // 结果卡片：大写 + 小写\n            var card = new Border { Background = B(P.RowBg), CornerRadius = new CornerRadius(10), Padding = new Thickness(12, 8, 12, 10), Margin = new Thickness(0, 12, 0, 0) };\n            var cs = new StackPanel();\n            cs.Children.Add(Txt(\"大写\", small, P.Muted, false));\n            _out = Flat(big, Colors.Transparent, Colors.Transparent);\n            _out.IsReadOnly = true; _out.TextWrapping = TextWrapping.Wrap; _out.BorderThickness = new Thickness(0); _out.Padding = new Thickness(-2, 2, 0, 2); _out.MinHeight = Math.Round(big * 1.5);\n            cs.Children.Add(_out);\n            _small = Txt(\"\", small, P.Muted, false);\n            cs.Children.Add(_small);\n            card.Child = cs;\n            sp.Children.Add(card);\n\n            // 底部：加「人民币」 | 复制数字  复制大写\n            var foot = new DockPanel { LastChildFill = false, Margin = new Thickness(0, 14, 0, 0) };\n            _copy = Btn(\"复制大写\", true, out _copyTxt, () => DoCopy(_copyTxt, _out.Text));\n            _copyNum = Btn(\"复制数字\", false, out _copyNumTxt, () => DoCopy(_copyNumTxt, _num));\n            DockPanel.SetDock(_copy, Dock.Right); DockPanel.SetDock(_copyNum, Dock.Right);\n            _prefix = Chip(\"加「人民币」\", () => _prefixOn, v => { _prefixOn = v; UpdateOut(); });\n            foot.Children.Add(_copy); foot.Children.Add(_copyNum); foot.Children.Add(_prefix);\n            sp.Children.Add(foot);\n\n            // 窗口图标（任务栏 / Alt+Tab）：强调色圆角块上一个 ¥\n            var ib = new Border { Width = 32, Height = 32, CornerRadius = new CornerRadius(8), Background = P.Grad(), Child = Glyph(IcYen, 20, B(P.DarkOnAccent)) };\n            ib.Measure(new Size(32, 32)); ib.Arrange(new Rect(0, 0, 32, 32));\n            var ico = new RenderTargetBitmap(32, 32, 96, 96, PixelFormats.Pbgra32); ico.Render(ib); ico.Freeze();\n            Icon = ico;\n\n            Topmost = _pinned;\n            _in.Text = keep;\n            UpdateOut();\n        }\n\n        // 阴影：按窗口大小画一次的静态图（和 MB out 的弹窗一样）。实时的 DropShadowEffect 会让悬停动画每一帧都重画整个透明窗口\n        Size _shadowFor = Size.Empty;\n        void DrawShadow()\n        {\n            double w = _shell.ActualWidth, h = _shell.ActualHeight;\n            if (w < 2 || h < 2) return;\n            if (!_shadowFor.IsEmpty && Math.Abs(_shadowFor.Width - w) < 0.5 && Math.Abs(_shadowFor.Height - h) < 0.5) return;\n            _shadowFor = new Size(w, h);\n            try\n            {\n                double W = w + PadOut * 2, H = h + PadOut * 2, dpi = 1;\n                var src = PresentationSource.FromVisual(this);\n                if (src != null && src.CompositionTarget != null) dpi = src.CompositionTarget.TransformToDevice.M11;\n                double cr = 14;\n                var g = new Grid { Width = W, Height = H };\n                g.Children.Add(new Border { Margin = new Thickness(PadOut), CornerRadius = new CornerRadius(cr), Background = Brushes.Black, Effect = new DropShadowEffect { BlurRadius = 18, ShadowDepth = 3, Direction = 270, Opacity = 0.32, Color = Colors.Black } });\n                g.Measure(new Size(W, H)); g.Arrange(new Rect(0, 0, W, H)); g.UpdateLayout();\n                int pw = (int)Math.Ceiling(W * dpi), ph = (int)Math.Ceiling(H * dpi);\n                var full = new RenderTargetBitmap(pw, ph, 96 * dpi, 96 * dpi, PixelFormats.Pbgra32);\n                full.Render(g);\n                var outside = new CombinedGeometry(GeometryCombineMode.Exclude, new RectangleGeometry(new Rect(0, 0, W, H)), new RectangleGeometry(new Rect(PadOut + 1, PadOut + 1, w - 2, h - 2), cr, cr));\n                var dv = new DrawingVisual();\n                using (var dc = dv.RenderOpen()) { dc.PushClip(outside); dc.DrawImage(full, new Rect(0, 0, W, H)); dc.Pop(); }\n                var rtb = new RenderTargetBitmap(pw, ph, 96 * dpi, 96 * dpi, PixelFormats.Pbgra32);\n                rtb.Render(dv); rtb.Freeze();\n                var brush = new ImageBrush(rtb) { Stretch = Stretch.Fill };\n                System.Windows.Data.BindingOperations.SetBinding(brush, Brush.OpacityProperty, new System.Windows.Data.Binding(\"Opacity\") { Source = _host });\n                Background = brush;\n            }\n            catch { Background = Brushes.Transparent; }\n        }\n\n        // ---------------------------------------------------------------- 换算、复制\n        void UpdateOut()\n        {\n            var r = Core.Read(_in.Text);\n            _small.Foreground = B(P.Muted);\n            if (!r.Ok)\n            {\n                _out.Text = \"\"; _num = \"\";\n                _small.Text = r.Err; if (r.Err.Length > 0) _small.Foreground = B(P.Danger);\n                return;\n            }\n            string up = Core.Upper(r.Value);\n            if (_prefixOn) up = \"人民币\" + up;\n            _out.Text = up;\n            decimal rounded = Math.Round(r.Value, 2, MidpointRounding.AwayFromZero);\n            _num = rounded.ToString(\"0.00\", CultureInfo.InvariantCulture);\n            var note = new List<string>();\n            if (r.Expr) note.Add(\"算出来是\");\n            note.Add(\"¥\" + rounded.ToString(\"#,##0.00\", CultureInfo.InvariantCulture));\n            if (rounded != r.Value) note.Add(\"· 超过两位小数，已四舍五入到分\");\n            _small.Text = string.Join(\" \", note);\n        }\n\n        void DoCopy(TextBlock label, string t)\n        {\n            if (string.IsNullOrEmpty(t)) { _small.Text = \"先输入一个数\"; _small.Foreground = B(P.Danger); return; }\n            bool ok = false;\n            for (int i = 0; i < 6 && !ok; i++) { try { Clipboard.SetText(t); ok = true; } catch { Thread.Sleep(60); } }\n            label.Text = ok ? \"已复制\" : \"剪贴板被占用\";\n            _flash.Stop(); _flash.Start();\n        }\n    }\n}\n\n'@\n}\n$exe = Join-Path $dir 'rmb_770efdc50b.exe'\nif (-not (Test-Path $exe)) {\n    $fw = Join-Path $env:WINDIR 'Microsoft.NET\\Framework64\\v4.0.30319'\n    if (-not (Test-Path (Join-Path $fw 'csc.exe'))) { $fw = Join-Path $env:WINDIR 'Microsoft.NET\\Framework\\v4.0.30319' }\n    if (-not (Test-Path (Join-Path $fw 'csc.exe'))) { throw '这台电脑上没有 .NET Framework 4 的 C# 编译器，金额大写用不了' }\n    $src = Join-Path $dir 'rmb.cs'\n    [IO.File]::WriteAllText($src, (Get-RmbSource), (New-Object Text.UTF8Encoding $true))\n    $refs = 'WPF\\PresentationFramework.dll', 'WPF\\PresentationCore.dll', 'WPF\\WindowsBase.dll', 'System.Xaml.dll', 'System.Web.Extensions.dll' | ForEach-Object { '/r:' + (Join-Path $fw $_) }\n    $tmp = Join-Path $dir 'rmb_build.exe'\n    $log = & (Join-Path $fw 'csc.exe') /nologo /noconfig /target:winexe /optimize+ /utf8output \"/out:$tmp\" $refs /r:System.dll /r:System.Core.dll /r:System.Xml.dll $src 2>&1\n    if ($LASTEXITCODE -ne 0) { throw ('金额大写编译失败：' + (($log | Where-Object { \"$_\" -match 'error' } | Select-Object -First 2) -join ' ')) }\n    Move-Item $tmp $exe -Force\n    # 旧版本编出来的 exe 顺手删掉（正在运行的删不掉，下次再删）\n    Get-ChildItem $dir -Filter 'rmb_*.exe' | Where-Object { $_.FullName -ne $exe } | ForEach-Object { try { [IO.File]::Delete($_.FullName) } catch { } }\n}\n$psi = New-Object Diagnostics.ProcessStartInfo $exe, ('\"' + $bell + '\" \"' + $dir + '\"')\n$psi.UseShellExecute = $true\n[void][Diagnostics.Process]::Start($psi)"
    }
  ]
}