{
  "mbout_plugin": 1,
  "id": "mbout.rmb-upper",
  "name": "金额大写",
  "version": "1.1",
  "author": "MB out",
  "description": "打开一个小窗口：输入阿拉伯数字，马上显示中文大写金额（壹万贰仟叁佰肆拾伍元陆角柒分），一键复制。支持 1,280、3.5万、1200×3.5 这样的写法；先选中一个数再点会自动填进去。只在窗口里转换，不改原文。",
  "cover": "v:yen|#f59e0b",
  "items": [
    {
      "kind": "script",
      "name": "金额大写",
      "mode": "none",
      "icon": "v:yen",
      "icon_color": "#f59e0b",
      "value": "# 金额大写：开一个小窗口，输入数字就显示中文大写金额，只在窗口里转换，不改原文。\n# 窗口是单独开的（插件脚本最多跑 30 秒，窗口要能一直开着）；窗口已经开着，就把它叫到前面。\n# 点之前选中了一个数，会自动填进窗口。\n$dir = Join-Path $env:LOCALAPPDATA 'MBout-plugins\\rmb'\nNew-Item -ItemType Directory -Force $dir | Out-Null\n$sel = \"$env:MB_SELECTION\".Trim()\nif ($sel.Length -gt 60 -or $sel -notmatch '[0-9０-９]') { $sel = '' }\n[IO.File]::WriteAllText((Join-Path $dir 'rmb_init.txt'), $sel, (New-Object Text.UTF8Encoding $false))\n# MB out 在「数据目录\\tmp」里跑插件脚本：把数据目录告诉窗口，窗口按 MB out 当前的主题配色\n$dd = Split-Path -Parent (Get-Location).Path\nif (Test-Path (Join-Path $dd 'plan_data.json')) { [IO.File]::WriteAllText((Join-Path $dir 'rmb_datadir.txt'), $dd, (New-Object Text.UTF8Encoding $false)) }\n$ev = $null\nif ([Threading.EventWaitHandle]::TryOpenExisting('Local\\mbout_rmb_window', [ref]$ev)) { [void]$ev.Set(); return }\n\n$code = @'\n# 金额大写：MB out 插件「金额大写」打开的小窗口。\n# 上面输入数字，下面马上显示中文大写金额；只在这个窗口里转换，不改任何地方的原文。\nAdd-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase\n$ErrorActionPreference = 'Stop'\n\n# ---------------------------------------------------------------- 数字 → 大写\nfunction Get-RmbUpper([decimal]$v) {\n    $d = '零', '壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖'\n    $unit = '', '拾', '佰', '仟'\n    $big = '', '万', '亿', '万亿'\n    $neg = $v -lt 0\n    if ($neg) { $v = -$v }\n    $v = [decimal]::Round($v, 2, [MidpointRounding]::AwayFromZero)\n    $int = [decimal]::Truncate($v)\n    $cents = [int](($v - $int) * 100)\n    $jiao = [int][math]::Floor($cents / 10)\n    $fen = $cents % 10\n    $s = ''\n    if ($int -gt 0) {\n        $digits = $int.ToString([Globalization.CultureInfo]::InvariantCulture)\n        $groups = New-Object System.Collections.Generic.List[string]\n        for ($i = $digits.Length; $i -gt 0; $i -= 4) { $st = [math]::Max(0, $i - 4); $groups.Insert(0, $digits.Substring($st, $i - $st).PadLeft(4, '0')) }\n        $zero = $false\n        for ($g = 0; $g -lt $groups.Count; $g++) {\n            $grp = $groups[$g]\n            if ($grp -eq '0000') { if ($s) { $zero = $true }; continue }\n            $part = ''\n            for ($k = 0; $k -lt 4; $k++) {\n                $c = [int][string]$grp[$k]\n                if ($c -eq 0) { if ($s -or $part) { $zero = $true } }\n                else { if ($zero) { $part += '零' }; $zero = $false; $part += $d[$c] + $unit[3 - $k] }\n            }\n            $zero = $false   # 一组末尾的 0（万位、元位）不写「零」：107000 → 壹拾万柒仟\n            $s += $part + $big[$groups.Count - 1 - $g]\n        }\n        $s += '元'\n    }\n    if ($jiao -eq 0 -and $fen -eq 0) { $s = if ($s) { $s + '整' } else { '零元整' } }\n    else {\n        if ($jiao -gt 0) {\n            if ($s -and ($int % 10) -eq 0) { $s += '零' }   # 元位是 0：1680.32 → 壹仟陆佰捌拾元零叁角贰分\n            $s += $d[$jiao] + '角'\n        }\n        elseif ($s) { $s += '零' }                           # 1.05 → 壹元零伍分\n        if ($fen -gt 0) { $s += $d[$fen] + '分' }\n    }\n    if ($neg -and $s -ne '零元整') { $s = '负' + $s }\n    return $s\n}\n\n# ---------------------------------------------------------------- 读输入（数字 / 万 / 算式）\nfunction ConvertTo-Half([string]$t) {\n    $sb = New-Object System.Text.StringBuilder\n    foreach ($c in $t.ToCharArray()) {\n        $n = [int]$c\n        if ($n -ge 0xFF01 -and $n -le 0xFF5E) { [void]$sb.Append([char]($n - 0xFEE0)) } elseif ($n -eq 0x3000) { [void]$sb.Append(' ') } else { [void]$sb.Append($c) }\n    }\n    $sb.ToString()\n}\n\n$script:src = ''; $script:pos = 0\nfunction P-Peek { if ($script:pos -lt $script:src.Length) { $script:src[$script:pos] } else { [char]0 } }\nfunction P-Expr {\n    [decimal]$v = P-Term\n    while ('+-'.IndexOf((P-Peek)) -ge 0 -and (P-Peek) -ne [char]0) {\n        $op = P-Peek; $script:pos++\n        [decimal]$r = P-Term\n        if ($op -eq '+') { $v += $r } else { $v -= $r }\n    }\n    $v\n}\nfunction P-Term {\n    [decimal]$v = P-Unary\n    while ('*/'.IndexOf((P-Peek)) -ge 0 -and (P-Peek) -ne [char]0) {\n        $op = P-Peek; $script:pos++\n        [decimal]$r = P-Unary\n        if ($op -eq '*') { $v *= $r } else { if ($r -eq 0) { throw '不能除以 0' }; $v /= $r }\n    }\n    $v\n}\nfunction P-Unary {\n    if ((P-Peek) -eq '-') { $script:pos++; [decimal]$x = P-Unary; return -$x }\n    if ((P-Peek) -eq '+') { $script:pos++ }\n    P-Atom\n}\nfunction P-Atom {\n    if ((P-Peek) -eq '(') {\n        $script:pos++\n        [decimal]$v = P-Expr\n        if ((P-Peek) -ne ')') { throw '括号没配对' }\n        $script:pos++\n    }\n    else {\n        $m = [regex]::Match($script:src.Substring($script:pos), '^(\\d+(\\.\\d*)?|\\.\\d+)')\n        if (-not $m.Success) { throw '这里看不懂' }\n        $script:pos += $m.Length\n        $v = [decimal]::Parse($m.Value.TrimEnd('.'), [Globalization.CultureInfo]::InvariantCulture)\n    }\n    while ('千万亿'.IndexOf((P-Peek)) -ge 0 -and (P-Peek) -ne [char]0) {\n        switch ([string](P-Peek)) { '千' { $v *= 1000 } '万' { $v *= 10000 } '亿' { $v *= 100000000 } }\n        $script:pos++\n    }\n    $v\n}\n\n# 返回 @{ Ok; Value; Expr(是不是算式); Err }\nfunction Read-Amount([string]$text) {\n    $t = (ConvertTo-Half $text) -replace '[¥￥,，\\s]', '' -replace '[×xX]', '*' -replace '÷', '/' -replace '[（]', '(' -replace '[）]', ')'\n    $t = $t -replace '^(人民币|RMB)', '' -replace '(元|圆)整?$', ''\n    if ($t -eq '') { return @{ Ok = $false; Err = '' } }\n    if ($t -notmatch '^[\\d\\.\\+\\-\\*/\\(\\)千万亿]+$') { return @{ Ok = $false; Err = '只认数字、小数点、千 / 万 / 亿和 + - × ÷ 括号' } }\n    try {\n        $script:src = $t; $script:pos = 0\n        [decimal]$v = P-Expr\n        if ($script:pos -lt $t.Length) { throw '这里看不懂' }\n    }\n    catch [System.OverflowException] { return @{ Ok = $false; Err = '数太大了' } }\n    catch { return @{ Ok = $false; Err = '算不出来：' + $_.Exception.Message } }\n    if ([math]::Abs($v) -ge [decimal]1e16) { return @{ Ok = $false; Err = '数太大了（最多到万亿）' } }\n    return @{ Ok = $true; Value = $v; Expr = ($t -notmatch '^-?\\d+(\\.\\d*)?$') }\n}\n\nif ($env:MB_RMB_TEST) { return }   # 测试时只加载上面的函数\n\n# ---------------------------------------------------------------- 只开一个窗口\n$dir = Split-Path -Parent $PSCommandPath\n$initFile = Join-Path $dir 'rmb_init.txt'\n$cfgFile = Join-Path $dir 'rmb.json'\n$created = $false\n$ev = New-Object System.Threading.EventWaitHandle($false, [System.Threading.EventResetMode]::AutoReset, 'Local\\mbout_rmb_window', [ref]$created)\nif (-not $created) { [void]$ev.Set(); return }\n\nfunction Take-Init {\n    try { if (Test-Path $initFile) { $t = [IO.File]::ReadAllText($initFile).Trim(); Remove-Item $initFile -ErrorAction SilentlyContinue; return $t } } catch { }\n    ''\n}\n$cfg = @{ prefix = $false; top = $false; left = $null; topPos = $null }\ntry { if (Test-Path $cfgFile) { $j = Get-Content $cfgFile -Raw -Encoding UTF8 | ConvertFrom-Json; foreach ($p in $j.PSObject.Properties) { $cfg[$p.Name] = $p.Value } } } catch { }\n\n# ---------------------------------------------------------------- 配色：跟 MB out 当前主题一样（按它的算法从底色 / 文字色 / 强调色推出来）\nfunction HexC([string]$h) {\n    if ($h -notmatch '^#[0-9a-fA-F]{6}$') { return $null }\n    [Windows.Media.Color]::FromRgb([Convert]::ToByte($h.Substring(1, 2), 16), [Convert]::ToByte($h.Substring(3, 2), 16), [Convert]::ToByte($h.Substring(5, 2), 16))\n}\nfunction Mix($a, $b, [double]$t) {\n    [Windows.Media.Color]::FromRgb([byte][math]::Round($a.R + ($b.R - $a.R) * $t), [byte][math]::Round($a.G + ($b.G - $a.G) * $t), [byte][math]::Round($a.B + ($b.B - $a.B) * $t))\n}\nfunction WithA($c, [int]$a) { [Windows.Media.Color]::FromArgb([byte]$a, $c.R, $c.G, $c.B) }\nfunction Clamp01([double]$v) { [math]::Max([double]0, [math]::Min([double]1, $v)) }   # 写成 0 / 1 会挑整数版本，0.5 变成 0\nfunction Shift($c, [double]$dh, [double]$dl = 0, [double]$ds = 0) {\n    $r = $c.R / 255.0; $g = $c.G / 255.0; $b = $c.B / 255.0\n    $max = [math]::Max($r, [math]::Max($g, $b)); $min = [math]::Min($r, [math]::Min($g, $b))\n    $l = ($max + $min) / 2; $h = 0.0; $s = 0.0\n    if ($max -ne $min) {\n        $d = $max - $min\n        $s = if ($l -gt 0.5) { $d / (2 - $max - $min) } else { $d / ($max + $min) }\n        if ($max -eq $r) { $h = ($g - $b) / $d + $(if ($g -lt $b) { 6 } else { 0 }) } elseif ($max -eq $g) { $h = ($b - $r) / $d + 2 } else { $h = ($r - $g) / $d + 4 }\n        $h *= 60\n    }\n    $h = ((($h + $dh) % 360) + 360) % 360; $s = Clamp01 ($s + $ds); $l = Clamp01 ($l + $dl)\n    $cc = (1 - [math]::Abs(2 * $l - 1)) * $s; $x = $cc * (1 - [math]::Abs(($h / 60) % 2 - 1)); $m = $l - $cc / 2\n    $rr = 0; $gg = 0; $bb = 0\n    if ($h -lt 60) { $rr = $cc; $gg = $x } elseif ($h -lt 120) { $rr = $x; $gg = $cc } elseif ($h -lt 180) { $gg = $cc; $bb = $x }\n    elseif ($h -lt 240) { $gg = $x; $bb = $cc } elseif ($h -lt 300) { $rr = $x; $bb = $cc } else { $rr = $cc; $bb = $x }\n    [Windows.Media.Color]::FromRgb([byte][math]::Round(($rr + $m) * 255), [byte][math]::Round(($gg + $m) * 255), [byte][math]::Round(($bb + $m) * 255))\n}\n\n# MB out 的设置：插件启动脚本把数据目录写在 rmb_datadir.txt 里；读不到就用 MB out 的默认深色\n$th = @{ c_bg = '#1b1c1f'; c_text = '#e8e9ec'; c_done = '#f2c14e'; accent = 'solo'; img_accent = $null; font_scale = 1.0 }\ntry {\n    $dd = [IO.File]::ReadAllText((Join-Path $dir 'rmb_datadir.txt')).Trim()\n    $pf = Join-Path $dd 'plan_data.json'\n    if (Test-Path $pf) {\n        Add-Type -AssemblyName System.Web.Extensions\n        $js = New-Object System.Web.Script.Serialization.JavaScriptSerializer\n        $js.MaxJsonLength = [int]::MaxValue\n        $o = $js.DeserializeObject([IO.File]::ReadAllText($pf, [Text.Encoding]::UTF8))\n        foreach ($k in @($th.Keys)) { if ($o.ContainsKey($k) -and $o[$k] -ne $null) { $th[$k] = $o[$k] } }\n    }\n} catch { }\n$bg = HexC \"$($th.c_bg)\"; if (-not $bg) { $bg = HexC '#1b1c1f' }\n$tx = HexC \"$($th.c_text)\"; if (-not $tx) { $tx = HexC '#e8e9ec' }\n$fs = [math]::Max(0.8, [math]::Min(1.6, [double]$th.font_scale))\n$isLight = (0.299 * $bg.R + 0.587 * $bg.G + 0.114 * $bg.B) / 255.0 -gt 0.6\n$accents = @{ amber = '#ffd66b', '#f6b04a', '#ee8a3a'; sunset = '#ffb36b', '#ff8b74', '#f2678f'; sakura = '#ffc0d4', '#f497c0', '#cf8ae6'\n              neon = '#f27bff', '#a97cff', '#6d8dff'; aurora = '#5ff0c6', '#44c6f2', '#6f8cff'; glacier = '#a3e9ff', '#84b9ff', '#a99cff'; mint = '#c6f27c', '#6ee7a8', '#38c9c1' }\n$acId = \"$($th.accent)\"\n$solo = HexC \"$($th.c_done)\"; if (-not $solo) { $solo = HexC '#f2c14e' }\nif ($acId -eq 'image' -and (HexC \"$($th.img_accent)\")) { $solo = HexC \"$($th.img_accent)\"; $acId = 'solo' }\n$G = if ($accents.ContainsKey($acId)) { @($accents[$acId] | ForEach-Object { HexC $_ }) } else { @((Shift $solo -10 0.05), $solo, (Shift $solo 10 -0.06)) }\nif ($isLight) { $G = @($G | ForEach-Object { Shift $_ 0 -0.13 0.03 }) }\n$P = @{\n    Bg = $bg; Text = $tx\n    RowBg = Mix $bg $tx 0.055; AddBg = Mix $bg $tx 0.07; BtnBg = Mix $bg $tx 0.08; BtnHover = Mix $bg $tx 0.13\n    Line = Mix $bg $tx 0.14; Border = Mix $bg $tx 0.22; Muted = Mix $bg $tx 0.55\n    Accent = $G[[int][math]::Floor($G.Count / 2)]\n    DarkOnAccent = HexC '#1b1c1f'\n    Danger = if ($isLight) { HexC '#b0473c' } else { HexC '#c0655a' }\n}\n$P.AccentText = if ($isLight) { Mix $P.Accent ([Windows.Media.Colors]::Black) 0.35 } else { Mix $P.Accent ([Windows.Media.Colors]::White) 0.08 }\n$F = @{ Title = 12 * $fs; Small = 11 * $fs; Item = 13 * $fs; Big = 19 * $fs }\n\nfunction Brush($c) { New-Object Windows.Media.SolidColorBrush $c }\nfunction Grad {\n    $b = New-Object Windows.Media.LinearGradientBrush\n    $b.StartPoint = New-Object Windows.Point 0, 0.5; $b.EndPoint = New-Object Windows.Point 1, 0.5\n    for ($i = 0; $i -lt $G.Count; $i++) { $b.GradientStops.Add((New-Object Windows.Media.GradientStop $G[$i], $(if ($G.Count -eq 1) { 0 } else { $i / ($G.Count - 1) })) ) }\n    $b\n}\nfunction Ease-Color($brush, $to, [double]$ms) {\n    $a = New-Object Windows.Media.Animation.ColorAnimation\n    $a.To = $to; $a.Duration = [Windows.Duration][TimeSpan]::FromMilliseconds($ms)\n    $e = New-Object Windows.Media.Animation.QuadraticEase; $e.EasingMode = 'EaseOut'; $a.EasingFunction = $e\n    $brush.BeginAnimation([Windows.Media.SolidColorBrush]::ColorProperty, $a)\n}\nfunction Ease-Double($obj, $dp, [double]$to, [double]$ms, [scriptblock]$done = $null) {\n    $a = New-Object Windows.Media.Animation.DoubleAnimation\n    $a.To = $to; $a.Duration = [Windows.Duration][TimeSpan]::FromMilliseconds($ms)\n    $e = New-Object Windows.Media.Animation.CubicEase; $e.EasingMode = 'EaseOut'; $a.EasingFunction = $e\n    if ($done) { $a.Add_Completed($done) }\n    $obj.BeginAnimation($dp, $a)\n}\nfunction Txt([string]$t, [double]$size, $color, [bool]$bold = $false) {\n    $b = New-Object Windows.Controls.TextBlock\n    $b.Text = $t; $b.FontSize = $size; $b.Foreground = Brush $color; $b.TextWrapping = 'Wrap'\n    if ($bold) { $b.FontWeight = 'SemiBold' }\n    $b\n}\nfunction Glyph([string]$path, [double]$size, $brush) {\n    $p = New-Object Windows.Shapes.Path\n    $p.Data = [Windows.Media.Geometry]::Parse($path); $p.Fill = $brush; $p.Stretch = 'Uniform'; $p.Width = $size; $p.Height = $size\n    $p.VerticalAlignment = 'Center'; $p.HorizontalAlignment = 'Center'\n    $p\n}\n# 输入框：MB out 的扁平样式（圆角 6，聚焦时边框变强调色）\n$tbTemplate = [Windows.Markup.XamlReader]::Parse(@\"\n<ControlTemplate xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" TargetType=\"TextBox\">\n  <Border Background=\"{TemplateBinding Background}\" BorderBrush=\"{TemplateBinding BorderBrush}\" BorderThickness=\"{TemplateBinding BorderThickness}\" CornerRadius=\"6\" SnapsToDevicePixels=\"True\">\n    <ScrollViewer x:Name=\"PART_ContentHost\" Focusable=\"False\" HorizontalScrollBarVisibility=\"Hidden\" VerticalScrollBarVisibility=\"Hidden\"/>\n  </Border>\n</ControlTemplate>\n\"@)\nfunction Flat-Box([double]$size, $back, $edge) {\n    $t = New-Object Windows.Controls.TextBox\n    $t.Template = $tbTemplate; $t.FocusVisualStyle = $null\n    $t.FontSize = $size; $t.Foreground = Brush $P.Text; $t.Background = Brush $back\n    $t.BorderBrush = Brush $edge; $t.BorderThickness = 1\n    $t.CaretBrush = Brush $P.AccentText; $t.SelectionBrush = Brush $P.AccentText\n    $t\n}\n# 按钮：主按钮 = 强调色渐变 + 深色字，悬停提亮；次按钮 = 浅底，悬停加深\nfunction Btn([string]$text, [bool]$primary) {\n    $t = Txt $text $F.Small $(if ($primary) { $P.DarkOnAccent } else { $P.Text })\n    $t.Margin = New-Object Windows.Thickness 16, 5, 16, 6; $t.HorizontalAlignment = 'Center'; $t.TextWrapping = 'NoWrap'\n    $b = New-Object Windows.Controls.Border\n    $b.CornerRadius = 8; $b.Cursor = 'Hand'; $b.Margin = New-Object Windows.Thickness 8, 0, 0, 0\n    if ($primary) {\n        $b.Background = Grad\n        $shine = New-Object Windows.Controls.Border; $shine.CornerRadius = 8; $shine.Background = [Windows.Media.Brushes]::White; $shine.Opacity = 0\n        $g = New-Object Windows.Controls.Grid; [void]$g.Children.Add($shine); [void]$g.Children.Add($t); $b.Child = $g\n        $b.Tag = @{ Text = $t; Shine = $shine }\n        $b.Add_MouseEnter({ param($s, $e) Ease-Double $s.Tag.Shine ([Windows.UIElement]::OpacityProperty) 0.07 220 })\n        $b.Add_MouseLeave({ param($s, $e) Ease-Double $s.Tag.Shine ([Windows.UIElement]::OpacityProperty) 0 300 })\n    }\n    else {\n        $bgB = Brush $P.BtnBg; $b.Background = $bgB; $b.Child = $t\n        $b.Tag = @{ Text = $t; Bg = $bgB }\n        $b.Add_MouseEnter({ param($s, $e) Ease-Color $s.Tag.Bg $P.BtnHover 70 })\n        $b.Add_MouseLeave({ param($s, $e) Ease-Color $s.Tag.Bg $P.BtnBg 260 })\n    }\n    $b\n}\n# 标题栏上的小图标按钮（置顶 / 关闭）\nfunction Icon-Btn([string]$path, [string]$tip) {\n    $bgB = Brush (WithA $P.Text 0)\n    $fg = Brush $P.Muted\n    $b = New-Object Windows.Controls.Border\n    $b.Width = [math]::Round(26 * $fs); $b.Height = [math]::Round(26 * $fs); $b.CornerRadius = 7; $b.Background = $bgB; $b.Cursor = 'Hand'\n    $b.Margin = New-Object Windows.Thickness 4, 0, 0, 0; $b.ToolTip = $tip\n    $b.Child = Glyph $path ([math]::Round(13 * $fs)) $fg\n    $b.Tag = @{ Bg = $bgB; Fg = $fg }\n    $b.Add_MouseEnter({ param($s, $e) Ease-Color $s.Tag.Bg $P.BtnBg 70 })\n    $b.Add_MouseLeave({ param($s, $e) Ease-Color $s.Tag.Bg (WithA $P.Text 0) 260 })\n    $b\n}\n# 勾选块：和「文字编辑」窗口的选项块一样（选中 = 强调色淡底 + 描边 + 勾）\nfunction Chip-Colors([bool]$on) {\n    @{ Bg = $(if ($on) { WithA $P.AccentText 52 } else { WithA $P.Text 6 }); Edge = $(if ($on) { WithA $P.AccentText 200 } else { WithA $P.Text 40 }); Fg = $(if ($on) { $P.Text } else { $P.Muted }) }\n}\nfunction Chip([string]$text, [bool]$on) {\n    $c = Chip-Colors $on\n    $st = @{ On = $on; Bg = (Brush $c.Bg); Edge = (Brush $c.Edge); Fg = (Brush $c.Fg) }\n    $chk = Glyph 'M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z' ([math]::Round($F.Small * 0.9)) (Brush $P.AccentText)\n    $chk.Margin = New-Object Windows.Thickness 0, 0, 4, 0\n    $t = New-Object Windows.Controls.TextBlock; $t.Text = $text; $t.FontSize = $F.Small; $t.Foreground = $st.Fg; $t.VerticalAlignment = 'Center'\n    $sp = New-Object Windows.Controls.StackPanel; $sp.Orientation = 'Horizontal'; $sp.HorizontalAlignment = 'Center'\n    [void]$sp.Children.Add($chk); [void]$sp.Children.Add($t)\n    $b = New-Object Windows.Controls.Border\n    $b.Background = $st.Bg; $b.BorderBrush = $st.Edge; $b.BorderThickness = 1; $b.CornerRadius = 7\n    $b.Padding = New-Object Windows.Thickness 7, 2, 7, 3; $b.Child = $sp; $b.Cursor = 'Hand'; $b.HorizontalAlignment = 'Left'; $b.VerticalAlignment = 'Center'\n    $sp.Measure((New-Object Windows.Size ([double]::PositiveInfinity), ([double]::PositiveInfinity)))\n    $b.MinWidth = [math]::Ceiling($sp.DesiredSize.Width) + 16\n    $chk.Visibility = if ($on) { 'Visible' } else { 'Collapsed' }\n    $st.Check = $chk; $b.Tag = $st\n    $b.Add_MouseEnter({ param($s, $e) Ease-Color $s.Tag.Bg $(if ($s.Tag.On) { WithA $P.AccentText 70 } else { WithA $P.Text 18 }) 70 })\n    $b.Add_MouseLeave({ param($s, $e) Ease-Color $s.Tag.Bg (Chip-Colors $s.Tag.On).Bg 260 })\n    $b\n}\nfunction Set-Chip($b, [bool]$on) {\n    $st = $b.Tag; $st.On = $on; $c = Chip-Colors $on\n    Ease-Color $st.Bg $c.Bg 140; Ease-Color $st.Edge $c.Edge 140; Ease-Color $st.Fg $c.Fg 140\n    $st.Check.Visibility = if ($on) { 'Visible' } else { 'Collapsed' }\n    if ($on) { $st.Check.Opacity = 0; Ease-Double $st.Check ([Windows.UIElement]::OpacityProperty) 1 140 }\n}\n\n# ---------------------------------------------------------------- 窗口：无边框圆角卡片 + 阴影，和 MB out 的弹窗一样\n$pad = 14\n$w = New-Object Windows.Window\n$w.Title = '金额大写'; $w.WindowStyle = 'None'; $w.AllowsTransparency = $true; $w.Background = [Windows.Media.Brushes]::Transparent\n$w.ResizeMode = 'NoResize'; $w.SizeToContent = 'WidthAndHeight'; $w.UseLayoutRounding = $true; $w.ShowInTaskbar = $true\n$w.FontFamily = New-Object Windows.Media.FontFamily 'Microsoft YaHei UI'\n[Windows.Media.TextOptions]::SetTextFormattingMode($w, 'Display')\n[Windows.Media.TextOptions]::SetTextRenderingMode($w, 'Grayscale')\n$w.WindowStartupLocation = 'CenterScreen'\n\n$root = New-Object Windows.Controls.Grid\n$shadow = New-Object Windows.Controls.Border\n$shadow.Margin = $pad; $shadow.CornerRadius = 14; $shadow.Background = Brush $P.Bg\n$fx = New-Object Windows.Media.Effects.DropShadowEffect; $fx.BlurRadius = 18; $fx.ShadowDepth = 3; $fx.Direction = 270; $fx.Opacity = 0.32; $fx.Color = [Windows.Media.Colors]::Black\n$shadow.Effect = $fx\n$shell = New-Object Windows.Controls.Border\n$shell.Margin = $pad; $shell.CornerRadius = 14; $shell.Background = Brush $P.Bg; $shell.BorderBrush = Brush $P.Border; $shell.BorderThickness = 1\n$sc = New-Object Windows.Media.ScaleTransform 0.97, 0.97\n$host2 = New-Object Windows.Controls.Grid; $host2.RenderTransform = $sc; $host2.RenderTransformOrigin = New-Object Windows.Point 0.5, 0.3; $host2.Opacity = 0\n[void]$host2.Children.Add($shadow); [void]$host2.Children.Add($shell)\n[void]$root.Children.Add($host2)\n$w.Content = $root\n\n$sp = New-Object Windows.Controls.StackPanel\n$sp.Width = [math]::Round(330 * $fs); $sp.Margin = New-Object Windows.Thickness 16, 10, 16, 16\n$shell.Child = $sp\n\n# 标题栏：按住拖动；右边置顶、关闭\n$head = New-Object Windows.Controls.DockPanel; $head.LastChildFill = $true; $head.Background = [Windows.Media.Brushes]::Transparent\n$btnClose = Icon-Btn 'M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z' '关闭（Esc）'\n$btnPin = Icon-Btn 'M16,9V4h1c0.55,0,1-0.45,1-1s-0.45-1-1-1H7C6.45,2,6,2.45,6,3s0.45,1,1,1h1v5c0,1.66-1.34,3-3,3v2h5.97v7l1,1l1-1v-7H19v-2C17.34,12,16,10.66,16,9z' '置顶'\n[Windows.Controls.DockPanel]::SetDock($btnClose, 'Right'); [Windows.Controls.DockPanel]::SetDock($btnPin, 'Right')\n[void]$head.Children.Add($btnClose); [void]$head.Children.Add($btnPin)\n$title = Txt '金额大写' $F.Title $P.Text $true; $title.VerticalAlignment = 'Center'\n[void]$head.Children.Add($title)\n[void]$sp.Children.Add($head)\n$head.Add_MouseLeftButtonDown({ param($s, $e) if ($e.OriginalSource -eq $head -or $e.OriginalSource -eq $title) { try { $w.DragMove() } catch { } } })\n\n$in = Flat-Box $F.Big $P.AddBg $P.Line\n$in.Padding = New-Object Windows.Thickness 8, 4, 8, 5; $in.Margin = New-Object Windows.Thickness 0, 10, 0, 0\n$lineB = $in.BorderBrush; $focusB = Brush $P.AccentText\n$in.Add_GotKeyboardFocus({ $in.BorderBrush = $focusB }); $in.Add_LostKeyboardFocus({ $in.BorderBrush = $lineB })\n[void]$sp.Children.Add($in)\n$hint = Txt '可输入 12345.67、1,280、3.5万、1200×3.5，回车复制大写' $F.Small $P.Muted\n$hint.Margin = New-Object Windows.Thickness 2, 6, 0, 0\n[void]$sp.Children.Add($hint)\n\n# 结果卡片：大写 + 小写\n$card = New-Object Windows.Controls.Border\n$card.Background = Brush $P.RowBg; $card.CornerRadius = 10; $card.Padding = New-Object Windows.Thickness 12, 8, 12, 10; $card.Margin = New-Object Windows.Thickness 0, 12, 0, 0\n$cardSp = New-Object Windows.Controls.StackPanel\n$cap = Txt '大写' $F.Small $P.Muted\n$out = Flat-Box $F.Big ([Windows.Media.Colors]::Transparent) ([Windows.Media.Colors]::Transparent)\n$out.IsReadOnly = $true; $out.TextWrapping = 'Wrap'; $out.BorderThickness = 0; $out.Padding = New-Object Windows.Thickness -2, 2, 0, 2; $out.MinHeight = [math]::Round($F.Big * 1.5)\n$small = Txt '' $F.Small $P.Muted\n[void]$cardSp.Children.Add($cap); [void]$cardSp.Children.Add($out); [void]$cardSp.Children.Add($small)\n$card.Child = $cardSp\n[void]$sp.Children.Add($card)\n\n# 底部：加「人民币」 | 复制数字  复制大写\n$foot = New-Object Windows.Controls.DockPanel; $foot.LastChildFill = $false; $foot.Margin = New-Object Windows.Thickness 0, 14, 0, 0\n$copy = Btn '复制大写' $true; $copyNum = Btn '复制数字' $false\n[Windows.Controls.DockPanel]::SetDock($copy, 'Right'); [Windows.Controls.DockPanel]::SetDock($copyNum, 'Right')\n$prefix = Chip '加「人民币」' ([bool]$cfg.prefix)\n[void]$foot.Children.Add($copy); [void]$foot.Children.Add($copyNum); [void]$foot.Children.Add($prefix)\n[void]$sp.Children.Add($foot)\n\n# 窗口图标（任务栏 / Alt+Tab）：强调色圆角块上一个 ¥\n$ib = New-Object Windows.Controls.Border; $ib.Width = 32; $ib.Height = 32; $ib.CornerRadius = 8; $ib.Background = Grad\n$ib.Child = Glyph 'M5.2,3H7.6L12,10.2L16.4,3H18.8L13.4,12H17V14H13V15.5H17V17.5H13V21H11V17.5H7V15.5H11V14H7V12H10.6Z' 20 (Brush $P.DarkOnAccent)\n$ib.Measure((New-Object Windows.Size 32, 32)); $ib.Arrange((New-Object Windows.Rect 0, 0, 32, 32))\n$ico = New-Object Windows.Media.Imaging.RenderTargetBitmap 32, 32, 96, 96, ([Windows.Media.PixelFormats]::Pbgra32)\n$ico.Render($ib); $w.Icon = $ico\n\n# ---------------------------------------------------------------- 行为\n$script:pinned = [bool]$cfg.top\nfunction Show-Pin { $w.Topmost = $script:pinned; Ease-Color $btnPin.Tag.Fg $(if ($script:pinned) { $P.AccentText } else { $P.Muted }) 140; $btnPin.ToolTip = if ($script:pinned) { '取消置顶' } else { '置顶' } }\nShow-Pin\nif ($cfg.left -ne $null -and $cfg.topPos -ne $null) {\n    $l = [double]$cfg.left; $tp = [double]$cfg.topPos\n    $vs = [System.Windows.SystemParameters]\n    if ($l -ge $vs::VirtualScreenLeft - $pad -and $l -lt $vs::VirtualScreenLeft + $vs::VirtualScreenWidth - 120 -and $tp -ge $vs::VirtualScreenTop - $pad -and $tp -lt $vs::VirtualScreenTop + $vs::VirtualScreenHeight - 120) {\n        $w.WindowStartupLocation = 'Manual'; $w.Left = $l; $w.Top = $tp\n    }\n}\n$script:num = ''\n\nfunction Update-Out {\n    $r = Read-Amount $in.Text\n    $small.Foreground = Brush $P.Muted\n    if (-not $r.Ok) {\n        $out.Text = ''; $script:num = ''\n        $small.Text = $r.Err; if ($r.Err) { $small.Foreground = Brush $P.Danger }\n        return\n    }\n    $v = $r.Value\n    $up = Get-RmbUpper $v\n    if ($prefix.Tag.On) { $up = '人民币' + $up }\n    $out.Text = $up\n    $rounded = [decimal]::Round($v, 2, [MidpointRounding]::AwayFromZero)\n    $script:num = $rounded.ToString('0.00', [Globalization.CultureInfo]::InvariantCulture)\n    $note = @()\n    if ($r.Expr) { $note += '算出来是' }\n    $note += '¥' + $rounded.ToString('#,##0.00', [Globalization.CultureInfo]::InvariantCulture)\n    if ($rounded -ne $v) { $note += '· 超过两位小数，已四舍五入到分' }\n    $small.Text = $note -join ' '\n}\n\nfunction Set-Clip([string]$t) {\n    for ($i = 0; $i -lt 6; $i++) { try { [System.Windows.Clipboard]::SetText($t); return $true } catch { Start-Sleep -Milliseconds 60 } }\n    $false\n}\n$script:flash = New-Object System.Windows.Threading.DispatcherTimer\n$script:flash.Interval = [TimeSpan]::FromMilliseconds(1300)\n$script:flash.Add_Tick({ $script:flash.Stop(); $copy.Tag.Text.Text = '复制大写'; $copyNum.Tag.Text.Text = '复制数字' })\nfunction Do-Copy($btn, [string]$t) {\n    if (-not $t) { $small.Text = '先输入一个数'; $small.Foreground = Brush $P.Danger; return }\n    $btn.Tag.Text.Text = if (Set-Clip $t) { '已复制' } else { '剪贴板被占用' }\n    $script:flash.Stop(); $script:flash.Start()\n}\n\n$in.Add_TextChanged({ Update-Out })\n$prefix.Add_MouseLeftButtonUp({ Set-Chip $prefix (-not $prefix.Tag.On); Update-Out })\n$copy.Add_MouseLeftButtonUp({ Do-Copy $copy $out.Text })\n$copyNum.Add_MouseLeftButtonUp({ Do-Copy $copyNum $script:num })\n$btnPin.Add_MouseLeftButtonUp({ $script:pinned = -not $script:pinned; Show-Pin })\n$btnClose.Add_MouseLeftButtonUp({ $w.Close() })\n$w.Add_PreviewKeyDown({ param($s, $e) if ($e.Key -eq 'Escape') { $e.Handled = $true; $w.Close() } })\n$in.Add_KeyDown({ param($s, $e) if ($e.Key -eq 'Return') { Do-Copy $copy $out.Text; $e.Handled = $true } })\n\nfunction Bring-Front {\n    if ($w.WindowState -eq 'Minimized') { $w.WindowState = 'Normal' }\n    $w.Activate() | Out-Null\n    if (-not $w.Topmost) { $w.Topmost = $true; $w.Topmost = $false }\n    $in.Focus() | Out-Null; $in.SelectAll()\n}\n# 再点一次插件：把窗口叫到前面，有选中的数字就填进来\n$poll = New-Object System.Windows.Threading.DispatcherTimer\n$poll.Interval = [TimeSpan]::FromMilliseconds(250)\n$poll.Add_Tick({\n    if ($ev.WaitOne(0)) {\n        $t = Take-Init\n        if ($t) { $in.Text = $t }\n        Bring-Front\n    }\n})\n$poll.Start()\n\n# 打开：淡入 + 轻微放大；关闭：淡出后再真正关\n$w.Add_Loaded({\n    Ease-Double $host2 ([Windows.UIElement]::OpacityProperty) 1 140\n    Ease-Double $sc ([Windows.Media.ScaleTransform]::ScaleXProperty) 1 170\n    Ease-Double $sc ([Windows.Media.ScaleTransform]::ScaleYProperty) 1 170\n})\n$w.Add_ContentRendered({ $t = Take-Init; if ($t) { $in.Text = $t }; Bring-Front })\n$script:closing = 0\n$w.Add_Closing({\n    param($s, $e)\n    if ($script:closing -eq 2) { return }\n    $e.Cancel = $true\n    if ($script:closing -eq 1) { return }\n    $script:closing = 1\n    try {\n        $o = [ordered]@{ prefix = [bool]$prefix.Tag.On; top = [bool]$script:pinned; left = $w.Left; topPos = $w.Top }\n        [IO.File]::WriteAllText($cfgFile, ($o | ConvertTo-Json), (New-Object System.Text.UTF8Encoding $false))\n    } catch { }\n    Ease-Double $sc ([Windows.Media.ScaleTransform]::ScaleXProperty) 0.98 110\n    Ease-Double $sc ([Windows.Media.ScaleTransform]::ScaleYProperty) 0.98 110\n    Ease-Double $host2 ([Windows.UIElement]::OpacityProperty) 0 110 { $script:closing = 2; $w.Close() }\n})\nUpdate-Out\n[void]$w.ShowDialog()\n$ev.Dispose()\n\n'@\n$f = Join-Path $dir 'rmb_window.ps1'\n[IO.File]::WriteAllText($f, $code, (New-Object Text.UTF8Encoding $true))\n$psi = New-Object Diagnostics.ProcessStartInfo 'powershell.exe', ('-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File \"' + $f + '\"')\n$psi.UseShellExecute = $true\n$psi.WindowStyle = 'Hidden'\n[void][Diagnostics.Process]::Start($psi)"
    }
  ]
}