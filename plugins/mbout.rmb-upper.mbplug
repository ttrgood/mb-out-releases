{
  "mbout_plugin": 1,
  "id": "mbout.rmb-upper",
  "name": "金额大写",
  "version": "1.0",
  "author": "MB out",
  "description": "打开一个小窗口：输入阿拉伯数字，马上显示中文大写金额（壹万贰仟叁佰肆拾伍元陆角柒分），一键复制。支持 1,280、3.5万、1200×3.5 这样的写法；先选中一个数再点会自动填进去。只在窗口里转换，不改原文。",
  "cover": "v:yen|#f59e0b",
  "items": [
    {
      "kind": "script",
      "name": "金额大写",
      "mode": "none",
      "icon": "v:yen",
      "icon_color": "#f59e0b",
      "value": "# 金额大写：开一个小窗口，输入数字就显示中文大写金额，只在窗口里转换，不改原文。\n# 窗口是单独开的（插件脚本最多跑 30 秒，窗口要能一直开着）；窗口已经开着，就把它叫到前面。\n# 点之前选中了一个数，会自动填进窗口。\n$dir = Join-Path $env:LOCALAPPDATA 'MBout-plugins\\rmb'\nNew-Item -ItemType Directory -Force $dir | Out-Null\n$sel = \"$env:MB_SELECTION\".Trim()\nif ($sel.Length -gt 60 -or $sel -notmatch '[0-9０-９]') { $sel = '' }\n[IO.File]::WriteAllText((Join-Path $dir 'rmb_init.txt'), $sel, (New-Object Text.UTF8Encoding $false))\n$ev = $null\nif ([Threading.EventWaitHandle]::TryOpenExisting('Local\\mbout_rmb_window', [ref]$ev)) { [void]$ev.Set(); return }\n\n$code = @'\n# 金额大写：MB out 插件「金额大写」打开的小窗口。\n# 上面输入数字，下面马上显示中文大写金额；只在这个窗口里转换，不改任何地方的原文。\nAdd-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase\n$ErrorActionPreference = 'Stop'\n\n# ---------------------------------------------------------------- 数字 → 大写\nfunction Get-RmbUpper([decimal]$v) {\n    $d = '零', '壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖'\n    $unit = '', '拾', '佰', '仟'\n    $big = '', '万', '亿', '万亿'\n    $neg = $v -lt 0\n    if ($neg) { $v = -$v }\n    $v = [decimal]::Round($v, 2, [MidpointRounding]::AwayFromZero)\n    $int = [decimal]::Truncate($v)\n    $cents = [int](($v - $int) * 100)\n    $jiao = [int][math]::Floor($cents / 10)\n    $fen = $cents % 10\n    $s = ''\n    if ($int -gt 0) {\n        $digits = $int.ToString([Globalization.CultureInfo]::InvariantCulture)\n        $groups = New-Object System.Collections.Generic.List[string]\n        for ($i = $digits.Length; $i -gt 0; $i -= 4) { $st = [math]::Max(0, $i - 4); $groups.Insert(0, $digits.Substring($st, $i - $st).PadLeft(4, '0')) }\n        $zero = $false\n        for ($g = 0; $g -lt $groups.Count; $g++) {\n            $grp = $groups[$g]\n            if ($grp -eq '0000') { if ($s) { $zero = $true }; continue }\n            $part = ''\n            for ($k = 0; $k -lt 4; $k++) {\n                $c = [int][string]$grp[$k]\n                if ($c -eq 0) { if ($s -or $part) { $zero = $true } }\n                else { if ($zero) { $part += '零' }; $zero = $false; $part += $d[$c] + $unit[3 - $k] }\n            }\n            $zero = $false   # 一组末尾的 0（万位、元位）不写「零」：107000 → 壹拾万柒仟\n            $s += $part + $big[$groups.Count - 1 - $g]\n        }\n        $s += '元'\n    }\n    if ($jiao -eq 0 -and $fen -eq 0) { $s = if ($s) { $s + '整' } else { '零元整' } }\n    else {\n        if ($jiao -gt 0) {\n            if ($s -and ($int % 10) -eq 0) { $s += '零' }   # 元位是 0：1680.32 → 壹仟陆佰捌拾元零叁角贰分\n            $s += $d[$jiao] + '角'\n        }\n        elseif ($s) { $s += '零' }                           # 1.05 → 壹元零伍分\n        if ($fen -gt 0) { $s += $d[$fen] + '分' }\n    }\n    if ($neg -and $s -ne '零元整') { $s = '负' + $s }\n    return $s\n}\n\n# ---------------------------------------------------------------- 读输入（数字 / 万 / 算式）\nfunction ConvertTo-Half([string]$t) {\n    $sb = New-Object System.Text.StringBuilder\n    foreach ($c in $t.ToCharArray()) {\n        $n = [int]$c\n        if ($n -ge 0xFF01 -and $n -le 0xFF5E) { [void]$sb.Append([char]($n - 0xFEE0)) } elseif ($n -eq 0x3000) { [void]$sb.Append(' ') } else { [void]$sb.Append($c) }\n    }\n    $sb.ToString()\n}\n\n$script:src = ''; $script:pos = 0\nfunction P-Peek { if ($script:pos -lt $script:src.Length) { $script:src[$script:pos] } else { [char]0 } }\nfunction P-Expr {\n    [decimal]$v = P-Term\n    while ('+-'.IndexOf((P-Peek)) -ge 0 -and (P-Peek) -ne [char]0) {\n        $op = P-Peek; $script:pos++\n        [decimal]$r = P-Term\n        if ($op -eq '+') { $v += $r } else { $v -= $r }\n    }\n    $v\n}\nfunction P-Term {\n    [decimal]$v = P-Unary\n    while ('*/'.IndexOf((P-Peek)) -ge 0 -and (P-Peek) -ne [char]0) {\n        $op = P-Peek; $script:pos++\n        [decimal]$r = P-Unary\n        if ($op -eq '*') { $v *= $r } else { if ($r -eq 0) { throw '不能除以 0' }; $v /= $r }\n    }\n    $v\n}\nfunction P-Unary {\n    if ((P-Peek) -eq '-') { $script:pos++; [decimal]$x = P-Unary; return -$x }\n    if ((P-Peek) -eq '+') { $script:pos++ }\n    P-Atom\n}\nfunction P-Atom {\n    if ((P-Peek) -eq '(') {\n        $script:pos++\n        [decimal]$v = P-Expr\n        if ((P-Peek) -ne ')') { throw '括号没配对' }\n        $script:pos++\n    }\n    else {\n        $m = [regex]::Match($script:src.Substring($script:pos), '^(\\d+(\\.\\d*)?|\\.\\d+)')\n        if (-not $m.Success) { throw '这里看不懂' }\n        $script:pos += $m.Length\n        $v = [decimal]::Parse($m.Value.TrimEnd('.'), [Globalization.CultureInfo]::InvariantCulture)\n    }\n    while ('千万亿'.IndexOf((P-Peek)) -ge 0 -and (P-Peek) -ne [char]0) {\n        switch ([string](P-Peek)) { '千' { $v *= 1000 } '万' { $v *= 10000 } '亿' { $v *= 100000000 } }\n        $script:pos++\n    }\n    $v\n}\n\n# 返回 @{ Ok; Value; Expr(是不是算式); Err }\nfunction Read-Amount([string]$text) {\n    $t = (ConvertTo-Half $text) -replace '[¥￥,，\\s]', '' -replace '[×xX]', '*' -replace '÷', '/' -replace '[（]', '(' -replace '[）]', ')'\n    $t = $t -replace '^(人民币|RMB)', '' -replace '(元|圆)整?$', ''\n    if ($t -eq '') { return @{ Ok = $false; Err = '' } }\n    if ($t -notmatch '^[\\d\\.\\+\\-\\*/\\(\\)千万亿]+$') { return @{ Ok = $false; Err = '只认数字、小数点、千 / 万 / 亿和 + - × ÷ 括号' } }\n    try {\n        $script:src = $t; $script:pos = 0\n        [decimal]$v = P-Expr\n        if ($script:pos -lt $t.Length) { throw '这里看不懂' }\n    }\n    catch [System.OverflowException] { return @{ Ok = $false; Err = '数太大了' } }\n    catch { return @{ Ok = $false; Err = '算不出来：' + $_.Exception.Message } }\n    if ([math]::Abs($v) -ge [decimal]1e16) { return @{ Ok = $false; Err = '数太大了（最多到万亿）' } }\n    return @{ Ok = $true; Value = $v; Expr = ($t -notmatch '^-?\\d+(\\.\\d*)?$') }\n}\n\nif ($env:MB_RMB_TEST) { return }   # 测试时只加载上面的函数\n\n# ---------------------------------------------------------------- 只开一个窗口\n$dir = Split-Path -Parent $PSCommandPath\n$initFile = Join-Path $dir 'rmb_init.txt'\n$cfgFile = Join-Path $dir 'rmb.json'\n$created = $false\n$ev = New-Object System.Threading.EventWaitHandle($false, [System.Threading.EventResetMode]::AutoReset, 'Local\\mbout_rmb_window', [ref]$created)\nif (-not $created) { [void]$ev.Set(); return }\n\nfunction Take-Init {\n    try { if (Test-Path $initFile) { $t = [IO.File]::ReadAllText($initFile).Trim(); Remove-Item $initFile -ErrorAction SilentlyContinue; return $t } } catch { }\n    ''\n}\n$cfg = @{ prefix = $false; top = $false; left = $null; topPos = $null }\ntry { if (Test-Path $cfgFile) { $j = Get-Content $cfgFile -Raw -Encoding UTF8 | ConvertFrom-Json; foreach ($p in $j.PSObject.Properties) { $cfg[$p.Name] = $p.Value } } } catch { }\n\n# ---------------------------------------------------------------- 跟随系统深浅色\n$light = $true\ntry { $light = (Get-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' -Name AppsUseLightTheme -ErrorAction Stop).AppsUseLightTheme -ne 0 } catch { }\n$c = if ($light) { @{ BG = '#FFFFFF'; FG = '#1F2328'; SUB = '#6E7781'; BOX = '#F4F5F7'; LINE = '#D8DCE1'; ACC = '#2F6FEB'; ERR = '#CF222E' } }\n     else { @{ BG = '#1E1F22'; FG = '#E6E6E6'; SUB = '#8B9098'; BOX = '#2B2D31'; LINE = '#3A3D43'; ACC = '#3B82F6'; ERR = '#FF6B6B' } }\n\n$xaml = @\"\n<Window xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        Title=\"金额大写\" Width=\"470\" SizeToContent=\"Height\" ResizeMode=\"CanMinimize\" WindowStartupLocation=\"CenterScreen\"\n        FontFamily=\"Microsoft YaHei UI\" FontSize=\"13\" Background=\"{BG}\" Foreground=\"{FG}\" UseLayoutRounding=\"True\">\n  <Window.Resources>\n    <Style TargetType=\"Button\">\n      <Setter Property=\"Foreground\" Value=\"{FG}\"/>\n      <Setter Property=\"Background\" Value=\"{BOX}\"/>\n      <Setter Property=\"Cursor\" Value=\"Hand\"/>\n      <Setter Property=\"Template\">\n        <Setter.Value>\n          <ControlTemplate TargetType=\"Button\">\n            <Border x:Name=\"b\" Background=\"{TemplateBinding Background}\" BorderBrush=\"{LINE}\" BorderThickness=\"1\" CornerRadius=\"6\" Padding=\"{TemplateBinding Padding}\">\n              <ContentPresenter HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/>\n            </Border>\n            <ControlTemplate.Triggers>\n              <Trigger Property=\"IsMouseOver\" Value=\"True\"><Setter TargetName=\"b\" Property=\"Opacity\" Value=\"0.82\"/></Trigger>\n            </ControlTemplate.Triggers>\n          </ControlTemplate>\n        </Setter.Value>\n      </Setter>\n    </Style>\n    <Style TargetType=\"TextBox\">\n      <Setter Property=\"Background\" Value=\"{BOX}\"/>\n      <Setter Property=\"Foreground\" Value=\"{FG}\"/>\n      <Setter Property=\"BorderBrush\" Value=\"{LINE}\"/>\n      <Setter Property=\"CaretBrush\" Value=\"{FG}\"/>\n      <Setter Property=\"SelectionBrush\" Value=\"{ACC}\"/>\n      <Setter Property=\"FontSize\" Value=\"22\"/>\n      <Setter Property=\"Padding\" Value=\"8,5\"/>\n    </Style>\n  </Window.Resources>\n  <StackPanel Margin=\"18,14,18,16\">\n    <TextBlock Text=\"输入数字\" Foreground=\"{SUB}\"/>\n    <TextBox x:Name=\"In\" Margin=\"0,5,0,0\"/>\n    <TextBlock x:Name=\"Hint\" Margin=\"0,5,0,0\" Foreground=\"{SUB}\" TextWrapping=\"Wrap\"/>\n    <TextBlock Text=\"中文大写\" Foreground=\"{SUB}\" Margin=\"0,14,0,0\"/>\n    <TextBox x:Name=\"Out\" Margin=\"0,5,0,0\" IsReadOnly=\"True\" TextWrapping=\"Wrap\" MinHeight=\"46\"/>\n    <TextBlock x:Name=\"Small\" Margin=\"0,5,0,0\" Foreground=\"{SUB}\" TextWrapping=\"Wrap\"/>\n    <DockPanel Margin=\"0,14,0,0\" LastChildFill=\"False\">\n      <CheckBox x:Name=\"Prefix\" Content=\"前面加「人民币」\" Foreground=\"{FG}\" VerticalAlignment=\"Center\"/>\n      <CheckBox x:Name=\"Pin\" Content=\"置顶\" Foreground=\"{FG}\" Margin=\"16,0,0,0\" VerticalAlignment=\"Center\"/>\n      <Button x:Name=\"Copy\" DockPanel.Dock=\"Right\" Content=\"复制大写\" Padding=\"16,5\" Background=\"{ACC}\" Foreground=\"White\"/>\n      <Button x:Name=\"CopyNum\" DockPanel.Dock=\"Right\" Content=\"复制数字\" Padding=\"12,5\" Margin=\"0,0,8,0\"/>\n    </DockPanel>\n  </StackPanel>\n</Window>\n\"@\nforeach ($k in $c.Keys) { $xaml = $xaml.Replace('{' + $k + '}', $c[$k]) }\n$w = [Windows.Markup.XamlReader]::Parse($xaml)\n$in = $w.FindName('In'); $out = $w.FindName('Out'); $hint = $w.FindName('Hint'); $small = $w.FindName('Small')\n$prefix = $w.FindName('Prefix'); $pin = $w.FindName('Pin'); $copy = $w.FindName('Copy'); $copyNum = $w.FindName('CopyNum')\n$conv = New-Object Windows.Media.BrushConverter\n$subBrush = $conv.ConvertFrom($c.SUB); $errBrush = $conv.ConvertFrom($c.ERR)\n$hint.Text = '可输入 12345.67、1,280、3.5万、1200×3.5　回车 = 复制大写'\n# 窗口图标：橙色方块上一个 ¥\n$ib = New-Object Windows.Controls.Border -Property @{ Width = 32; Height = 32; CornerRadius = 7; Background = $conv.ConvertFrom('#F59E0B') }\n$ib.Child = New-Object Windows.Controls.TextBlock -Property @{ Text = '¥'; FontSize = 23; FontWeight = 'Bold'; Foreground = [Windows.Media.Brushes]::White; HorizontalAlignment = 'Center'; VerticalAlignment = 'Center' }\n$ib.Measure((New-Object Windows.Size 32, 32)); $ib.Arrange((New-Object Windows.Rect 0, 0, 32, 32))\n$ico = New-Object Windows.Media.Imaging.RenderTargetBitmap 32, 32, 96, 96, ([Windows.Media.PixelFormats]::Pbgra32)\n$ico.Render($ib); $w.Icon = $ico\n# 深色时标题栏也换深色\nif (-not $light) {\n    try {\n        Add-Type -Namespace RmbWin -Name Dwm -MemberDefinition '[System.Runtime.InteropServices.DllImport(\"dwmapi.dll\")] public static extern int DwmSetWindowAttribute(System.IntPtr h, int a, ref int v, int s);'\n        $w.Add_SourceInitialized({ $h = (New-Object Windows.Interop.WindowInteropHelper $w).Handle; $one = 1; [void][RmbWin.Dwm]::DwmSetWindowAttribute($h, 20, [ref]$one, 4) })\n    } catch { }\n}\n$prefix.IsChecked = [bool]$cfg.prefix\n$pin.IsChecked = [bool]$cfg.top\n$w.Topmost = [bool]$cfg.top\nif ($cfg.left -ne $null -and $cfg.topPos -ne $null) {\n    $l = [double]$cfg.left; $tp = [double]$cfg.topPos\n    $vs = [System.Windows.SystemParameters]\n    if ($l -ge $vs::VirtualScreenLeft -and $l -lt $vs::VirtualScreenLeft + $vs::VirtualScreenWidth - 80 -and $tp -ge $vs::VirtualScreenTop -and $tp -lt $vs::VirtualScreenTop + $vs::VirtualScreenHeight - 80) {\n        $w.WindowStartupLocation = 'Manual'; $w.Left = $l; $w.Top = $tp\n    }\n}\n$script:num = ''\n\nfunction Update-Out {\n    $r = Read-Amount $in.Text\n    $small.Foreground = $subBrush\n    if (-not $r.Ok) {\n        $out.Text = ''; $script:num = ''\n        $small.Text = $r.Err; if ($r.Err) { $small.Foreground = $errBrush }\n        return\n    }\n    $v = $r.Value\n    $up = Get-RmbUpper $v\n    if ($prefix.IsChecked) { $up = '人民币' + $up }\n    $out.Text = $up\n    $rounded = [decimal]::Round($v, 2, [MidpointRounding]::AwayFromZero)\n    $script:num = $rounded.ToString('0.00', [Globalization.CultureInfo]::InvariantCulture)\n    $note = @()\n    if ($r.Expr) { $note += '算出来是' }\n    $note += '¥' + $rounded.ToString('#,##0.00', [Globalization.CultureInfo]::InvariantCulture)\n    if ($rounded -ne $v) { $note += '（超过两位小数，已四舍五入到分）' }\n    $small.Text = $note -join ' '\n}\n\nfunction Set-Clip([string]$t) {\n    for ($i = 0; $i -lt 6; $i++) { try { [System.Windows.Clipboard]::SetText($t); return $true } catch { Start-Sleep -Milliseconds 60 } }\n    $false\n}\n$script:flash = New-Object System.Windows.Threading.DispatcherTimer\n$script:flash.Interval = [TimeSpan]::FromMilliseconds(1300)\n$script:flash.Add_Tick({ $script:flash.Stop(); $copy.Content = '复制大写'; $copyNum.Content = '复制数字' })\nfunction Do-Copy($btn, [string]$t) {\n    if (-not $t) { $small.Text = '先输入一个数'; $small.Foreground = $errBrush; return }\n    if (Set-Clip $t) { $btn.Content = '已复制 ✓' } else { $btn.Content = '剪贴板被占用' }\n    $script:flash.Stop(); $script:flash.Start()\n}\n\n$in.Add_TextChanged({ Update-Out })\n$prefix.Add_Click({ Update-Out })\n$pin.Add_Click({ $w.Topmost = [bool]$pin.IsChecked })\n$copy.Add_Click({ Do-Copy $copy $out.Text })\n$copyNum.Add_Click({ Do-Copy $copyNum $script:num })\n$in.Add_KeyDown({ param($s, $e) if ($e.Key -eq 'Return') { Do-Copy $copy $out.Text; $e.Handled = $true } elseif ($e.Key -eq 'Escape') { $w.Close() } })\n\nfunction Bring-Front {\n    if ($w.WindowState -eq 'Minimized') { $w.WindowState = 'Normal' }\n    $w.Activate() | Out-Null\n    if (-not $w.Topmost) { $w.Topmost = $true; $w.Topmost = $false }\n    $in.Focus() | Out-Null; $in.SelectAll()\n}\n# 再点一次插件：把窗口叫到前面，有选中的数字就填进来\n$poll = New-Object System.Windows.Threading.DispatcherTimer\n$poll.Interval = [TimeSpan]::FromMilliseconds(250)\n$poll.Add_Tick({\n    if ($ev.WaitOne(0)) {\n        $t = Take-Init\n        if ($t) { $in.Text = $t }\n        Bring-Front\n    }\n})\n$poll.Start()\n\n$w.Add_ContentRendered({ $t = Take-Init; if ($t) { $in.Text = $t }; Bring-Front })\n$w.Add_Closing({\n    try {\n        $o = [ordered]@{ prefix = [bool]$prefix.IsChecked; top = [bool]$pin.IsChecked; left = $w.Left; topPos = $w.Top }\n        [IO.File]::WriteAllText($cfgFile, ($o | ConvertTo-Json), (New-Object System.Text.UTF8Encoding $false))\n    } catch { }\n})\nUpdate-Out\n[void]$w.ShowDialog()\n$ev.Dispose()\n\n'@\n$f = Join-Path $dir 'rmb_window.ps1'\n[IO.File]::WriteAllText($f, $code, (New-Object Text.UTF8Encoding $true))\n$psi = New-Object Diagnostics.ProcessStartInfo 'powershell.exe', ('-NoProfile -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File \"' + $f + '\"')\n$psi.UseShellExecute = $true\n$psi.WindowStyle = 'Hidden'\n[void][Diagnostics.Process]::Start($psi)"
    }
  ]
}